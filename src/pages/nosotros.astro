---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Container from "../components/shared/Container.astro";
import Title from "../components/shared/Title.astro";
import Paragraph from "../components/shared/Paragraph.astro";
import BtnLink from "../components/shared/BtnLink.astro";
import ClientLogos from "../components/shared/ClientLogos.astro";
import { authors, authorUrl, type AuthorId } from "../utils/authors";

// Los artículos que firma cada quien no se escriben a mano: salen de la
// colección. Así la página de equipo no puede desincronizarse del blog.
const posts = await getCollection("blog");
const postsByAuthor = (id: AuthorId) =>
    posts
        .filter((post) => post.data.author === id)
        .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// El orden de la página lo fija esta lista, no el registro de autores: allí las
// claves están en el orden en que las consume el blog.
const teamOrder: AuthorId[] = ["rene-andrade", "edgar-olivan"];

const team = teamOrder.map((id) => ({
    id,
    ...authors[id],
    initials: authors[id].name
        .split(" ")
        .map((word) => word[0])
        .join(""),
    posts: postsByAuthor(id),
}));

const title = "Quiénes somos: el equipo detrás de Insytech";
const description =
    "Insytech es un integrador industrial de Monterrey fundado en 2018. Conoce a las personas que levantan, ejecutan y firman cada proyecto de automatización, trazabilidad, visión y software.";

// Un solo grafo: la página, la empresa que ya existe como entidad en el sitio
// (mismo @id, así que los nodos se funden) y las dos personas, cada una con el
// ancla que usan las firmas del blog.
const aboutSchema = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "AboutPage",
            "@id": "https://insytech.mx/nosotros/#aboutpage",
            url: "https://insytech.mx/nosotros/",
            name: title,
            description,
            inLanguage: "es-MX",
            about: { "@id": "https://insytech.mx/#organization" },
            mainEntity: { "@id": "https://insytech.mx/#organization" },
        },
        {
            "@type": "Organization",
            "@id": "https://insytech.mx/#organization",
            employee: team.map((member) => ({ "@id": authorUrl(member.id) })),
        },
        ...team.map((member) => ({
            "@type": "Person",
            "@id": authorUrl(member.id),
            name: member.name,
            url: authorUrl(member.id),
            ...(member.jobTitle && { jobTitle: member.jobTitle }),
            ...(member.role && { description: member.role }),
            ...(member.linkedin && { sameAs: [member.linkedin] }),
            worksFor: { "@id": "https://insytech.mx/#organization" },
        })),
    ],
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        {
            "@type": "ListItem",
            position: 1,
            name: "Inicio",
            item: "https://insytech.mx/",
        },
        {
            "@type": "ListItem",
            position: 2,
            name: "Quiénes somos",
            item: "https://insytech.mx/nosotros/",
        },
    ],
};
---

<Layout title={title} description={description}>
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(aboutSchema)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbSchema)}
    />

    <main class="pt-28 lg:pt-32 pb-8">
        <!-- Encabezado -->
        <section class="relative overflow-hidden pb-16 sm:pb-20">
            <div class="absolute inset-0 z-0" aria-hidden="true">
                <div
                    class="absolute top-0 right-0 w-1/2 h-2/3 bg-gradient-to-bl from-[#00B5E2]/10 to-transparent rounded-bl-full"
                >
                </div>
                <div
                    class="hidden lg:block absolute -bottom-10 left-0 w-1/3 h-1/2 bg-gradient-to-tr from-[#001489]/10 to-transparent rounded-tr-full opacity-60"
                >
                </div>
            </div>

            <Container className="relative z-10 max-w-4xl space-y-8">
                <div data-animate="fade-up" data-animate-delay=".06s">
                    <Title>Somos las personas que van a la planta</Title>
                </div>
                <div data-animate="fade" data-animate-delay=".12s">
                    <Paragraph>
                    Insytech se fundó en <strong>2018</strong> en <strong
                        >Monterrey, Nuevo León</strong
                    >. Desde entonces integramos automatización y control,
                    trazabilidad de producción, visión artificial y software a
                    la medida para plantas del norte de México. No revendemos
                    licencias: levantamos el alcance en piso, escribimos el
                        código y acompañamos el arranque.
                    </Paragraph>
                </div>
                <div data-animate="fade" data-animate-delay=".16s">
                    <Paragraph>
                        Somos un equipo chico, y eso es deliberado: con quien
                        hablas en la primera junta es con quien vas a trabajar
                        el proyecto. Estas son las dos personas que lo firman.
                    </Paragraph>
                </div>
            </Container>
        </section>

        <!-- El equipo -->
        <section id="equipo" class="pb-20 sm:pb-24">
            <Container className="max-w-5xl space-y-10">
                <div data-animate="fade-up">
                    <Title as="h2">El equipo</Title>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    {
                        team.map((member, index) => (
                            <article
                                id={member.id}
                                class="scroll-mt-32 flex flex-col gap-6 rounded-2xl border border-box-border bg-box-bg dark:bg-gray-900/20 backdrop-blur-sm p-6 sm:p-8 shadow-md"
                                data-animate="fade-up"
                                data-animate-delay={`${0.08 * index}s`}
                            >
                                {/* Retrato a la izquierda, identidad a la
                                    derecha. El enlace de LinkedIn se empuja al
                                    fondo de la columna con mt-auto: como el
                                    retrato fija la altura de la fila y mide lo
                                    mismo en las dos fichas, los dos enlaces caen
                                    a la misma altura sin fijar un alto a mano.

                                    Mientras no haya foto la ficha usa el
                                    monograma; una foto de banco sería justo lo
                                    contrario de lo que esta página demuestra. */}
                                <div class="flex gap-5">
                                    {member.photo ? (
                                        <img
                                            src={member.photo}
                                            alt={`Retrato de ${member.name}`}
                                            width={320}
                                            height={480}
                                            loading="lazy"
                                            decoding="async"
                                            class="flex-shrink-0 w-28 sm:w-36 aspect-2/3 object-cover rounded-lg"
                                        />
                                    ) : (
                                        <span
                                            class="flex-shrink-0 grid place-items-center w-28 sm:w-36 aspect-2/3 rounded-lg bg-gradient-to-br from-[#001489] via-[#005EB8] to-[#00B5E2] text-white font-heading text-2xl tracking-wide"
                                            aria-hidden="true"
                                        >
                                            {member.initials}
                                        </span>
                                    )}

                                    <div class="flex-1 flex flex-col gap-3">
                                        <div>
                                            <h3 class="text-xl font-bold text-heading-2">
                                                {member.name}
                                            </h3>
                                            {member.jobTitle && (
                                                <p class="text-sm text-heading-3">
                                                    {member.jobTitle}
                                                </p>
                                            )}
                                        </div>

                                        {member.role && (
                                            <p class="text-sm text-gray-700 dark:text-gray-300">
                                                {member.role}
                                            </p>
                                        )}

                                        {member.linkedin && (
                                            <a
                                                href={member.linkedin}
                                                rel="noopener noreferrer me"
                                                target="_blank"
                                                class="mt-auto inline-flex items-center gap-2 text-sm font-medium text-heading-2 hover:text-primary transition-colors w-fit"
                                            >
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    viewBox="0 0 24 24"
                                                    fill="currentColor"
                                                    class="w-5 h-5"
                                                    aria-hidden="true"
                                                >
                                                    <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05a3.75 3.75 0 013.38-1.86c3.61 0 4.27 2.38 4.27 5.47v6.28zM5.34 7.43a2.07 2.07 0 110-4.14 2.07 2.07 0 010 4.14zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
                                                </svg>
                                                Perfil de LinkedIn
                                            </a>
                                        )}
                                    </div>
                                </div>

                                {member.posts.length > 0 && (
                                    <div class="space-y-3">
                                        <h4 class="text-sm font-semibold uppercase tracking-[0.12em] text-heading-3">
                                            Lo que firma en el blog
                                        </h4>
                                        <ul class="space-y-2 text-sm">
                                            {member.posts.map((post) => (
                                                <li>
                                                    <a
                                                        href={`/blog/${post.id}/`}
                                                        class="text-[#005EB8] dark:text-[#71b5f5] hover:underline"
                                                    >
                                                        {post.data.title}
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                )}

                            </article>
                        ))
                    }
                </div>
            </Container>
        </section>

        <!-- Cómo trabajamos -->
        <section class="pb-20 sm:pb-24">
            <Container className="max-w-5xl space-y-10">
                <div data-animate="fade-up">
                    <Title as="h2">Cómo trabajamos</Title>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <div
                        class="rounded-2xl border border-box-border bg-box-bg dark:bg-gray-900/20 p-6 space-y-3"
                        data-animate="fade-up"
                    >
                        <h3 class="text-lg font-bold text-heading-2">
                            El alcance se levanta en piso
                        </h3>
                        <p class="text-gray-700 dark:text-gray-300">
                            Antes de cotizar vamos a ver la línea. Lo que se
                            mide ahí —el proceso real, el PLC que ya está, el
                            ritmo de producción— es lo que define el proyecto.
                        </p>
                    </div>
                    <div
                        class="rounded-2xl border border-box-border bg-box-bg dark:bg-gray-900/20 p-6 space-y-3"
                        data-animate="fade-up"
                        data-animate-delay=".08s"
                    >
                        <h3 class="text-lg font-bold text-heading-2">
                            Integramos sobre lo que ya tienes
                        </h3>
                        <p class="text-gray-700 dark:text-gray-300">
                            Trabajamos con las marcas de PLC y las plataformas
                            SCADA que ya están instaladas, y conectamos con el
                            ERP en uso. Cambiar de tecnología es una decisión
                            del cliente, no un requisito nuestro.
                        </p>
                    </div>
                    <div
                        class="rounded-2xl border border-box-border bg-box-bg dark:bg-gray-900/20 p-6 space-y-3"
                        data-animate="fade-up"
                        data-animate-delay=".16s"
                    >
                        <h3 class="text-lg font-bold text-heading-2">
                            Entregamos con el sistema corriendo
                        </h3>
                        <p class="text-gray-700 dark:text-gray-300">
                            El proyecto no cierra con la instalación: cierra
                            cuando la gente de planta lo está usando y el equipo
                            del cliente sabe operarlo sin nosotros.
                        </p>
                    </div>
                </div>
            </Container>
        </section>

        <!-- Clientes -->
        <section class="pb-20 sm:pb-24">
            <Container className="max-w-5xl space-y-8">
                <div class="space-y-4 max-w-3xl">
                    <div data-animate="fade-up">
                        <Title as="h2">Con quién hemos trabajado</Title>
                    </div>
                    <div data-animate="fade" data-animate-delay=".08s">
                        <Paragraph>
                            Plantas de manufactura del norte de México, la
                            mayoría del sector automotriz y metalmecánico.
                        </Paragraph>
                    </div>
                </div>
                <ClientLogos />
                <div data-animate="fade-up" data-animate-delay=".12s">
                    <BtnLink
                        href="/contact/"
                        text="Cuéntanos tu caso"
                        variant="primary"
                    />
                </div>
            </Container>
        </section>
    </main>
</Layout>
