---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Container from "../../components/shared/Container.astro";
import Title from "../../components/shared/Title.astro";
import PostCTA from "../../components/blog/PostCTA.astro";
import { authors } from "../../utils/authors";

export async function getStaticPaths() {
    const posts = await getCollection("blog");
    return posts.map((post) => ({
        params: { slug: post.id },
        props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatDate = (date: Date) =>
    date.toLocaleDateString("es-MX", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
    });

const pubDateISO = post.data.pubDate.toISOString().split("T")[0];
const formattedDate = formatDate(post.data.pubDate);

const updatedISO = post.data.updatedDate?.toISOString().split("T")[0];
const formattedUpdated = post.data.updatedDate
    ? formatDate(post.data.updatedDate)
    : undefined;

const author = authors[post.data.author];

const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: post.data.title,
    description: post.data.description,
    datePublished: pubDateISO,
    ...(updatedISO && { dateModified: updatedISO }),
    inLanguage: "es-MX",
    mainEntityOfPage: {
        "@type": "WebPage",
        "@id": new URL(`/blog/${post.id}/`, Astro.site).href,
    },
    author: {
        "@type": "Person",
        name: author.name,
        ...(author.jobTitle && { jobTitle: author.jobTitle }),
        ...(author.linkedin && { sameAs: [author.linkedin] }),
        worksFor: {
            "@type": "Organization",
            name: "Insytech",
            url: "https://insytech.mx",
        },
    },
    publisher: {
        "@type": "Organization",
        name: "Insytech",
        url: "https://insytech.mx",
        logo: {
            "@type": "ImageObject",
            url: "https://insytech.mx/images/Versiones%20de%20logotipo-01.webp",
        },
    },
};

const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
        { "@type": "ListItem", position: 1, name: "Inicio", item: "https://insytech.mx" },
        { "@type": "ListItem", position: 2, name: "Blog", item: new URL("/blog/", Astro.site).href },
        {
            "@type": "ListItem",
            position: 3,
            name: post.data.title,
            item: new URL(`/blog/${post.id}/`, Astro.site).href,
        },
    ],
};
---

<Layout title={post.data.title} description={post.data.description}>
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(articleSchema)}
    />
    <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(breadcrumbSchema)}
    />
    <main class="pt-28 lg:pt-32 pb-16 sm:pb-20">
        <Container className="max-w-3xl mx-auto">
            <article class="space-y-6">
                <header class="space-y-4">
                    <nav class="text-sm">
                        <a href="/blog/" class="text-[#005EB8] hover:underline">
                            &larr; Volver al blog
                        </a>
                    </nav>
                    <Title>{post.data.title}</Title>
                    <p class="text-sm text-heading-3">
                        Por <span class="font-medium">{author.name}</span>{
                            author.jobTitle && `, ${author.jobTitle}`
                        } ·
                        <time datetime={pubDateISO}>{formattedDate}</time>
                        {
                            formattedUpdated && (
                                <>
                                    {" · "}
                                    <span>
                                        Actualizado el{" "}
                                        <time datetime={updatedISO}>
                                            {formattedUpdated}
                                        </time>
                                    </span>
                                </>
                            )
                        }
                    </p>
                </header>
                <div class="content-typography">
                    <Content />
                </div>
                <PostCTA />
            </article>
        </Container>
    </main>
</Layout>
