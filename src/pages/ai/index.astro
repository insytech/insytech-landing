---
import AILayout from "../../layouts/AutomatizacionLayout.astro";
import OrbitHero from "../../components/automatizacion/OrbitHero.astro";
import SocialProof from "../../components/shared/SocialProof.astro";
import HowItWorks from "../../components/automatizacion/HowItWorks.astro";
import IndustrialAI from "../../components/automatizacion/IndustrialAI.astro";
import Services from "../../components/automatizacion/Services.astro";
import Cta from "../../components/automatizacion/Cta.astro";
import Resources from "../../components/automatizacion/Resources.astro";
import FAQ from "../../components/automatizacion/FAQ.astro";
import ContactSection from "@components/sections/ContactSection.astro";
import { SURFACE } from "@utils/typography";
---

<AILayout
    title="Inteligencia artificial para la industria en México"
    description="IA aplicada a manufactura en Monterrey: inspección visual, analítica de producción, monitoreo predictivo, agentes sobre tu ERP y RPA. Cuéntanos tu proceso."
>
    <OrbitHero />

    <!-- Prueba social pegada al Hero: la página no tenía ni un cliente ni un
         año de operación. -->
    <SocialProof class={SURFACE.base} />

    <!-- Va antes que nada: responde "¿dónde aplica la IA en mi planta?", que es
         lo que busca quien llega aquí, y reparte hacia la página que hace cada
         trabajo en vez de competir con ellas. -->
    <IndustrialAI />

    <HowItWorks />
    <Services />
    <Cta />
    <Resources />
    <FAQ />
    <ContactSection />
</AILayout>
