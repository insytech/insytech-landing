---
import Layout from "@layouts/VisionLayout.astro";
import Hero from "@components/software/Hero.astro";
import SocialProof from "@components/shared/SocialProof.astro";
import SoftwareServices from "@components/software/SoftwareServices.astro";
import SoftwareProcess from "@components/software/SoftwareProcess.astro";
import Resources from "@components/software/Resources.astro";
import FAQ from "@components/software/FAQ.astro";
import ContactSection from "@components/sections/ContactSection.astro";
import { SURFACE } from "@utils/typography";
---

<Layout
    title="Software industrial a la medida en Monterrey"
    description="Desarrollamos software industrial a la medida en Monterrey: MES, HMI e integración con su ERP y PLCs. Más de 9 años en planta. Cuéntenos su proceso."
>
    <!-- overflow-clip y no overflow-hidden: hidden crea un contenedor de scroll
         y rompería cualquier position:sticky o pin de ScrollTrigger de la
         página. clip recorta igual sin crear contenedor. -->
    <main class="flex flex-col overflow-clip">
        <Hero />

        <!-- La prueba social va pegada al Hero a propósito: para un comprador
             industrial pesa más que la lista de capacidades que sigue. -->
        <SocialProof class={SURFACE.base} />

        <SoftwareServices />

        <SoftwareProcess />

        <Resources />

        <FAQ />

        <ContactSection />
    </main>
</Layout>
