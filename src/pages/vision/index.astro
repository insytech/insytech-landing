---
import VisionLayout from "@layouts/VisionLayout.astro";
import Hero from "@components/vision/Hero.astro";
import Trust from "@components/vision/Trust.astro";
import ServiceDetails from "@components/vision/ServiceDetails.astro";
import InspectionTypes from "@components/vision/InspectionTypes.astro";
import Hardware from "@components/vision/Hardware.astro";
import Comparison from "@components/vision/Comparison.astro";
import Industries from "@components/vision/Industries.astro";
import CTA from "@components/vision/CTA.astro";
import FAQ from "@components/vision/FAQ.astro";
import Resources from "@components/vision/Resources.astro";
import ContactSection from "@components/sections/ContactSection.astro";
---

<VisionLayout
	title="Visión Artificial (Computer Vision): detecta cada defecto | Insytech"
	description="Visión artificial (computer vision) para empresas en México: automatizamos la inspección de calidad y la detección de defectos con IA. Solicita una demo."
>
	<!-- overflow-clip y no overflow-hidden: hidden crea un contenedor de
	     scroll y rompe el position:sticky de la columna de capacidades. clip
	     recorta igual sin crear contenedor. -->
	<main class="flex flex-col overflow-clip">
		<Hero />
		<Trust />
		<ServiceDetails />
		<InspectionTypes />
		<Hardware />
		<Comparison />
		<Industries />
		<CTA />
		<FAQ />
		<Resources />
		<ContactSection />
	</main>
</VisionLayout>

