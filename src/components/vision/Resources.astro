---
import RelatedPosts from "../shared/RelatedPosts.astro";
import type { RelatedPost } from "../shared/RelatedPosts.astro";
import { HEADING, PAD, SURFACE } from "@utils/typography";

// Estos cuatro posts rankean por encima de /vision/ para su propio tema
// (pos. 2.7, 6.9 y 12.3 contra 27.2), así que la página de servicio los agrupa
// en vez de competir contra ellos.
const posts: readonly RelatedPost[] = [
    {
        title: "El mercado de sistemas de visión artificial en México",
        summary: "Tamaño, crecimiento y qué sectores están adoptando primero.",
        href: "/blog/mercado-vision-artificial-mexico/",
    },
    {
        title: "Visión artificial en Monterrey: aplicaciones reales",
        summary: "Casos concretos en la industria del área metropolitana.",
        href: "/blog/vision-artificial-monterrey/",
    },
    {
        title: "Computer vision para empresas: guía práctica",
        summary: "Cómo evaluar si tu proceso es candidato y por dónde empezar.",
        href: "/blog/computer-vision-empresas-guia/",
    },
    {
        title: "¿Es cara la visión artificial?",
        summary: "El costo oculto de seguir inspeccionando a mano.",
        href: "/blog/vision-artificial-vs-sistemas-convencionales/",
    },
];

// Blanco y no gris pese a ir en el capítulo de cierre: `ContactSection`, que va
// justo debajo y es compartido por las seis páginas, dibuja una cuña blanca en
// su borde superior que da por hecho que la sección anterior es blanca. En las
// otras cinco páginas lo es (siempre el FAQ); dejar aquí un gris hacía que esa
// diagonal se leyera como una forma suelta.
---

<RelatedPosts
    posts={posts}
    heading="Antes de decidir, léete esto"
    intro="Escribimos sobre lo que nos preguntan en las juntas. Sin vender."
    class={`${PAD.minor} ${SURFACE.base}`}
    headingClass={HEADING.minor}
/>
