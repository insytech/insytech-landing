---
import Container from "../shared/Container.astro";
import { HEADING, PAD, SURFACE } from "./typography";
import ComparisonSlider from "../react-bits/ComparisonSlider";

// La comparación va sobre cobertura, evidencia y criterio, no sobre precisión.
// Las tres son ciertas por construcción y no dependen de una medición: la
// inspección en línea ve cada pieza que pasa la estación, guarda la foto y
// aplica el mismo modelo siempre. La precisión, en cambio, es por aplicación
// (pieza, óptica, iluminación), así que no hay una cifra global publicable: la
// mejor corrida de entrenamiento del proyecto da 0.786 de mAP50.
//
// NO devolver aquí cifras de precisión, latencia ni "consistencia 100%". Estaban
// antes (99.7 %, <50 ms, 100 %) y ninguna tenía medición detrás.
const beforeMetrics = [
    { label: "Cobertura", value: "Muestreo" },
    { label: "Evidencia", value: "En papel" },
    { label: "Criterio", value: "Varía" },
];

const afterMetrics = [
    { label: "Cobertura", number: 100, suffix: "%" },
    { label: "Evidencia", value: "Cada pieza" },
    { label: "Criterio", value: "Constante" },
];
---

<section
    id="comparison"
    class={`relative ${PAD.display} overflow-clip ${SURFACE.raised}`}
>
    <Container className="relative z-10">
        <div class="max-w-3xl mx-auto text-center mb-14" data-animate="fade-up">
            <h2
                data-reveal="heading"
                class={`${HEADING.display} mb-4`}
            >
                Inspección manual vs.
                <span
                    class="inline-block whitespace-nowrap text-transparent bg-clip-text bg-gradient-to-r from-[#001489] via-[#005EB8] to-[#00B5E2] dark:from-[#4da6ff] dark:via-[#00B5E2] dark:to-[#6de0ff]"
                >
                    Insytech Vision
                </span>
            </h2>

            <!-- La distinción viene del deck de ventas, lámina "The key
                 difference: APPROACH". Es la explicación más corta del valor que
                 existe en todo el material: en un sistema clásico el ingeniero
                 tiene que describir el defecto por adelantado; aquí basta con
                 mostrárselo. -->
            <p
                class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto"
            >
                En un sistema convencional el ingeniero tiene que <strong
                    class="font-semibold text-[#211915] dark:text-gray-200"
                    >describir</strong
                > el defecto. Aquí solo tiene que <strong
                    class="font-semibold text-[#211915] dark:text-gray-200"
                    >mostrar ejemplos</strong
                > de él.
            </p>
            <p class="mt-3 text-base text-gray-500 dark:text-gray-500">
                Arrastra el control y compara qué se documenta de cada lado.
            </p>
        </div>
    </Container>

    <!-- Fuera del Container a propósito: el comparador es lo único interactivo
         de la página y lo que prueba el argumento, así que ocupa el ancho
         completo en lugar de quedar contenido como una figura más. El alto se
         acota con clamp porque a 16/9 sobre 1920px serían 1080px de alto y la
         sección dejaría de caber en pantalla. -->
    <div class="relative z-10 mt-2" data-animate="fade-up" data-animate-delay=".1s">
        <ComparisonSlider
            beforeImage="/images/vision-before.webp"
            afterImage="/images/vision-after.webp"
            beforeAlt="Inspección de calidad manual de piezas industriales, propensa a errores"
            afterAlt="Sistema de visión artificial de Insytech inspeccionando piezas y detectando defectos en la línea de producción"
            beforeMetrics={beforeMetrics}
            afterMetrics={afterMetrics}
            className="h-[clamp(24rem,68vh,42rem)] border-y border-gray-200 dark:border-white/10"
            client:visible
        />
    </div>

    <Container className="relative z-10">
        <p
            class="text-center text-sm text-gray-500 dark:text-gray-400 mt-6 animate-pulse"
        >
            Arrastra el control para comparar la capacidad de detección
        </p>
    </Container>
</section>
