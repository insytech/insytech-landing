---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import ThreeHero from "@utils/threejs";
import ShinyText from "../react-bits/ShinyText";

// Índice de capacidades: mismo contenido que las tarjetas anteriores, pero sin
// caja propia — la jerarquía la dan el icono, la regla fina y el aire.
const indice = [
    {
        icono: ['M2.036 12.322a1.012 1.012 0 010-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178z', 'M15 12a3 3 0 11-6 0 3 3 0 016 0z'],
        titulo: "Inspección de calidad",
        texto: "Detecta defectos microscópicos con precisión superior al ojo humano, en velocidades de línea.",
    },
    {
        icono: ['M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z', 'M15 12a3 3 0 11-6 0 3 3 0 016 0z'],
        titulo: "Integración PLC & SCADA",
        texto: "Conectamos nativamente con tu automatización existente para acciones en tiempo real.",
    },
    {
        icono: ['M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z'],
        titulo: "Trazabilidad visual",
        texto: "Registro fotográfico de cada pieza inspeccionada para auditorías y análisis de calidad.",
    },
];
---

<section class="relative pt-28 lg:pt-36 pb-14 bg-white dark:bg-gray-950">
    <Container>
        <!-- Titular a la izquierda, apoyo y CTA a la derecha -->
        <div
            class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10"
        >
            <h1
                class="lg:max-w-3xl text-4xl sm:text-5xl lg:text-[4.5rem] font-bold font-heading text-[#211915] dark:text-white leading-[0.98] tracking-tight text-balance"
            >
                Sistemas de visión artificial para detección precisa con
                <ShinyText
                    text="Machine Learning"
                    disabled={false}
                    speed={3}
                    color="#005EB8"
                    shineColor="#00B5E2"
                    className="leading-[1.15] pb-[0.06em]"
                    client:load
                />
            </h1>

            <div class="lg:w-[21rem] flex flex-col gap-5">
                <p
                    class="text-gray-600 dark:text-gray-400 text-base leading-relaxed"
                >
                    Transformamos procesos industriales de empresas en México
                    con visión computacional, automatizando inspección de
                    calidad y clasificación en tiempo real.
                </p>
                <BtnLink
                    text="Solicita una demo"
                    href="#contact"
                    className="self-start py-4 px-10 text-white font-semibold"
                    variant="primary"
                />
            </div>
        </div>
    </Container>

    <!-- Banda a sangre: la línea de inspección cruza la página de borde a borde -->
    <div class="relative mt-12 lg:mt-16 bg-[#211915] dark:bg-white overflow-hidden">
        <div
            id="three-hero"
            class="relative w-full h-[300px] sm:h-[380px] lg:h-[460px]"
        >
            <ThreeHero client:idle />
        </div>

        <!-- Registro de veredictos: se escribe cuando una pieza cruza el láser -->
        <div class="absolute inset-x-0 bottom-0 border-t border-white/10 dark:border-[#211915]/15">
            <Container>
                <ul
                    id="verdict-log"
                    class="mono-tech flex items-center gap-6 overflow-hidden py-3 text-[11px] tracking-[0.06em] whitespace-nowrap"
                >
                    <li data-placeholder class="text-white/35 dark:text-[#211915]/45">
                        Esperando piezas…
                    </li>
                </ul>
            </Container>
        </div>
    </div>

    <Container>
        <div
            class="mt-10 grid grid-cols-1 md:grid-cols-3 border-t border-[#211915]/15 dark:border-white/10"
        >
            {
                indice.map((item) => (
                    <div class="flex items-center gap-4 pt-6 pr-8 md:border-l border-[#211915]/10 dark:border-white/10 md:first:border-l-0 md:pl-6 md:first:pl-0">
                        <div
                            class="flex h-11 w-11 flex-shrink-0 items-center justify-center rounded-xl bg-[#005EB8]/10 text-[#005EB8] dark:bg-[#005EB8]/20 dark:text-[#71b5f5]"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="1.5"
                                stroke="currentColor"
                                class="h-5 w-5"
                            >
                                {item.icono.map((d) => (
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d={d}
                                    />
                                ))}
                            </svg>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-[#211915] dark:text-white mb-1">
                                {item.titulo}
                            </h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                                {item.texto}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </Container>
</section>

<style>
    /* Etiquetas técnicas en IBM Plex Mono (se carga en VisionLayout junto a
       Raleway, en la misma petición a Google Fonts). */
    .mono-tech {
        font-family: "IBM Plex Mono", ui-monospace, "SFMono-Regular", monospace;
    }

    /* Entrada de cada renglón del registro. Se aplica desde el script de abajo,
       que inserta los <li>: el CSS con ámbito de Astro no alcanza a los nodos
       creados por la isla de Three.js, pero sí a los que crea este script,
       porque el <ul> vive en este componente. */
    :global(#verdict-log li.verdict-in) {
        animation: verdict-in 320ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    @keyframes verdict-in {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(#verdict-log li.verdict-in) {
            animation: none;
        }
    }
</style>

<script>
    // El registro se alimenta de la escena: `threejs.ts` emite un evento cuando
    // una pieza termina de pasar por la cortina láser. Sin eventos no hay
    // renglones — nada de datos inventados en bucle.
    const log = document.getElementById("verdict-log");
    if (log) {
        const MAX = 6;
        document.addEventListener("insytech:verdict", (event) => {
            const { label, ok } = (event as CustomEvent).detail;
            if (log.querySelector("[data-placeholder]")) log.textContent = "";

            const li = document.createElement("li");
            li.className = "verdict-in text-white/70 dark:text-[#211915]/80";
            li.innerHTML = `<span class="text-white/35 dark:text-[#211915]/45">${new Date().toLocaleTimeString("es-MX", { hour12: false })}</span> ${label} <span style="color:${ok ? "#00B5E2" : "#F97316"}">${ok ? "OK" : "RECHAZO"}</span>`;
            log.prepend(li);

            while (log.children.length > MAX) log.lastElementChild?.remove();
        });
    }
</script>
