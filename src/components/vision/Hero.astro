---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import ThreeHero from "@utils/threejs";
import ShinyText from "../react-bits/ShinyText";

// Índice numerado: reemplaza las tres tarjetas de features. Mismo contenido,
// sin iconos ni cajas — la jerarquía la dan el número y la regla fina.
const indice = [
    {
        num: "01",
        titulo: "Inspección de calidad",
        texto: "Detecta defectos microscópicos con precisión superior al ojo humano, en velocidades de línea.",
    },
    {
        num: "02",
        titulo: "Integración PLC & SCADA",
        texto: "Conectamos nativamente con tu automatización existente para acciones en tiempo real.",
    },
    {
        num: "03",
        titulo: "Trazabilidad visual",
        texto: "Registro fotográfico de cada pieza inspeccionada para auditorías y análisis de calidad.",
    },
];
---

<section class="relative pt-28 lg:pt-36 pb-14 bg-white dark:bg-gray-950">
    <Container>
        <!-- Titular a la izquierda, apoyo y CTA a la derecha -->
        <div
            class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-10"
        >
            <h1
                class="lg:max-w-3xl text-4xl sm:text-5xl lg:text-[4.5rem] font-bold font-heading text-[#211915] dark:text-white leading-[0.98] tracking-tight text-balance"
            >
                Visión artificial para detección precisa con
                <ShinyText
                    text="Machine Learning"
                    disabled={false}
                    speed={3}
                    color="#005EB8"
                    shineColor="#00B5E2"
                    client:load
                />
            </h1>

            <div class="lg:w-[21rem] flex flex-col gap-5">
                <p
                    class="text-gray-600 dark:text-gray-400 text-base leading-relaxed"
                >
                    Cada pieza cruza el escáner, se clasifica y sigue su camino.
                    Lo que no pasa la prueba se separa sin detener la línea.
                </p>
                <BtnLink
                    text="Solicita una demo"
                    href="#contact"
                    className="self-start py-4 px-10 text-white font-semibold"
                    variant="primary"
                />
            </div>
        </div>
    </Container>

    <!-- Banda a sangre: la línea de inspección cruza la página de borde a borde -->
    <div class="relative mt-12 lg:mt-16 bg-[#211915] dark:bg-white overflow-hidden">
        <div
            id="three-hero"
            class="relative w-full h-[300px] sm:h-[380px] lg:h-[460px]"
        >
            <ThreeHero client:idle />
        </div>

        <!-- Registro de veredictos: se escribe cuando una pieza cruza el láser -->
        <div class="absolute inset-x-0 bottom-0 border-t border-white/10 dark:border-[#211915]/15">
            <Container>
                <ul
                    id="verdict-log"
                    class="mono-tech flex items-center gap-6 overflow-hidden py-3 text-[11px] tracking-[0.06em] whitespace-nowrap"
                >
                    <li data-placeholder class="text-white/35 dark:text-[#211915]/45">
                        Esperando piezas…
                    </li>
                </ul>
            </Container>
        </div>
    </div>

    <Container>
        <div
            class="mt-10 grid grid-cols-1 md:grid-cols-3 border-t border-[#211915]/15 dark:border-white/10"
        >
            {
                indice.map((item) => (
                    <div class="flex gap-4 pt-6 pr-8 md:border-l border-[#211915]/10 dark:border-white/10 md:first:border-l-0 md:pl-6 md:first:pl-0">
                        <span class="mono-tech text-xs text-[#00B5E2] pt-1">
                            {item.num}
                        </span>
                        <div>
                            <h3 class="text-lg font-bold text-[#211915] dark:text-white mb-1">
                                {item.titulo}
                            </h3>
                            <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                                {item.texto}
                            </p>
                        </div>
                    </div>
                ))
            }
        </div>
    </Container>
</section>

<style>
    /* Etiquetas técnicas en IBM Plex Mono (se carga en VisionLayout junto a
       Raleway, en la misma petición a Google Fonts). */
    .mono-tech {
        font-family: "IBM Plex Mono", ui-monospace, "SFMono-Regular", monospace;
    }

    /* Entrada de cada renglón del registro. Se aplica desde el script de abajo,
       que inserta los <li>: el CSS con ámbito de Astro no alcanza a los nodos
       creados por la isla de Three.js, pero sí a los que crea este script,
       porque el <ul> vive en este componente. */
    :global(#verdict-log li.verdict-in) {
        animation: verdict-in 320ms cubic-bezier(0.23, 1, 0.32, 1) both;
    }

    @keyframes verdict-in {
        from {
            opacity: 0;
            transform: translateX(-10px);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        :global(#verdict-log li.verdict-in) {
            animation: none;
        }
    }
</style>

<script>
    // El registro se alimenta de la escena: `threejs.ts` emite un evento cuando
    // una pieza termina de pasar por la cortina láser. Sin eventos no hay
    // renglones — nada de datos inventados en bucle.
    const log = document.getElementById("verdict-log");
    if (log) {
        const MAX = 6;
        document.addEventListener("insytech:verdict", (event) => {
            const { label, ok } = (event as CustomEvent).detail;
            if (log.querySelector("[data-placeholder]")) log.textContent = "";

            const li = document.createElement("li");
            li.className = "verdict-in text-white/70 dark:text-[#211915]/80";
            li.innerHTML = `<span class="text-white/35 dark:text-[#211915]/45">${new Date().toLocaleTimeString("es-MX", { hour12: false })}</span> ${label} <span style="color:${ok ? "#00B5E2" : "#F97316"}">${ok ? "OK" : "RECHAZO"}</span>`;
            log.prepend(li);

            while (log.children.length > MAX) log.lastElementChild?.remove();
        });
    }
</script>
