---
import { ClipboardCheck, FlaskConical, Factory } from "@lucide/astro";
import StepsPanel from "../shared/StepsPanel.astro";

// Fases y duraciones tomadas del deck de ventas (Insytech-Vision Deployment
// Timeline). Antes los tres pasos eran genericos y sin una sola cifra, asi que
// "en semanas" quedaba como promesa suelta; el deck ya compromete estos plazos
// frente al cliente, y sumados dan de 6 a 10 semanas, que es lo que sostiene el
// titular.
//
// Va con el mismo panel "paso a paso" de la home y de /ai/. La versión anterior
// —tres círculos con degradado y número sobre una banda con textura diagonal—
// no se parecía a ningún otro cierre del sitio.
const steps = [
    {
        icon: ClipboardCheck,
        title: "Validación del caso",
        meta: "2 semanas",
        detail: "Definimos el punto de inspección y confirmamos que el caso de negocio se sostiene, antes de que inviertas en hardware.",
    },
    {
        icon: FlaskConical,
        title: "Prototipado",
        meta: "2 a 4 semanas",
        detail: "Recolectamos imágenes de tu propia línea, entrenamos el modelo y lo evaluamos sobre tus piezas reales.",
    },
    {
        icon: Factory,
        title: "Puesta en planta",
        meta: "2 a 4 semanas",
        detail: "Instalación, integración con tu control y arranque en línea. De ahí se escala a las demás líneas.",
    },
];
---

<StepsPanel
    title="De la idea a producción"
    accent="en semanas"
    intro="Trabajamos por etapas, con validación en tu planta antes de escalar a producción."
    steps={steps}
    columns={3}
    cta={{ text: "Agenda una consulta", href: "#contact" }}
/>
