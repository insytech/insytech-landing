---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import { HEADING, PAD, SURFACE } from "@utils/typography";

// Fases y duraciones tomadas del deck de ventas (Insytech-Vision Deployment
// Timeline). Antes los tres pasos eran genericos y sin una sola cifra, asi que
// "en semanas" quedaba como promesa suelta; el deck ya compromete estos plazos
// frente al cliente, y sumados dan de 6 a 10 semanas, que es lo que sostiene el
// titular.
const steps = [
    {
        number: "1",
        title: "Validación del caso",
        duration: "2 semanas",
        description:
            "Definimos el punto de inspección y confirmamos que el caso de negocio se sostiene, antes de que inviertas en hardware.",
    },
    {
        number: "2",
        title: "Prototipado",
        duration: "2 a 4 semanas",
        description:
            "Recolectamos imágenes de tu propia línea, entrenamos el modelo y lo evaluamos sobre tus piezas reales.",
    },
    {
        number: "3",
        title: "Puesta en planta",
        duration: "2 a 4 semanas",
        description:
            "Instalación, integración con tu control y arranque en línea. De ahí se escala a las demás líneas.",
    },
];
---

<section id="cta" class={`relative ${PAD.minor} overflow-clip bg-gradient-to-b from-gray-50 via-slate-50 to-white dark:from-gray-900 dark:via-[#0B1121] dark:to-gray-950`}>
    <!-- Patrón de fondo sutil -->
    <div class="absolute inset-0 z-0">
        <!-- Grid pattern overlay - Subtle & Clean -->
        <div class="absolute w-full h-full bg-[linear-gradient(60deg,transparent_25%,rgba(0,181,226,0.03)_25%,rgba(0,181,226,0.03)_50%,transparent_50%)] bg-[length:60px_60px] dark:opacity-10"></div>
        
        <!-- Subtle gradient mask for depth, no blobs -->
        <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-transparent dark:to-[#0B1121]/40"></div>
    </div>

    <Container className="relative z-10">
        <div class="max-w-5xl mx-auto">
            <!-- Header -->
            <div class="text-center mb-16" data-animate="fade-up">
                <h2 class={`${HEADING.minor} mb-4`}>
                    De la idea a producción en{" "}
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#005EB8] via-[#00B5E2] to-[#4da6ff] dark:from-[#38bdf8] dark:via-[#00B5E2] dark:to-[#005EB8]">
                        semanas
                    </span>
                </h2>
                <p class="text-gray-600 dark:text-slate-400 text-lg max-w-2xl mx-auto">
                    Nuestro proceso probado garantiza una implementación rápida y sin fricciones.
                </p>
            </div>

            <!-- Steps como timeline horizontal -->
            <div class="relative" data-animate="fade-up" data-animate-delay=".1s">
                <!-- Línea conectora -->
                <div class="hidden md:block absolute top-12 left-0 right-0 h-px bg-gradient-to-r from-transparent via-gray-300 dark:via-slate-700 to-transparent"></div>
                
                <div class="grid md:grid-cols-3 gap-8">
                    {steps.map((step, index) => (
                        <div class="relative text-center group">
                            <!-- Número circular -->
                            <div class="relative inline-flex items-center justify-center w-24 h-24 rounded-full bg-gradient-to-br from-[#005EB8] to-[#00B5E2] mb-6 shadow-xl shadow-[#005EB8]/20 dark:shadow-[#00B5E2]/10 group-hover:scale-105 transition-transform duration-300 ring-4 ring-white dark:ring-[#1f2937]">
                                <span class="text-3xl font-bold text-white font-heading">
                                    {step.number}
                                </span>
                            </div>
                            
                            <!-- Contenido -->
                            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-1">
                                {step.title}
                            </h3>
                            <p class="mb-2 font-mono text-xs uppercase tracking-[0.12em] text-[#005EB8] dark:text-[#4da6ff]">
                                {step.duration}
                            </p>
                            <p class="text-gray-600 dark:text-slate-400 leading-relaxed text-sm lg:text-base">
                                {step.description}
                            </p>
                        </div>
                    ))}
                </div>
            </div>

            <!-- CTA Button -->
            <div class="text-center mt-16" data-animate="fade" data-animate-delay=".2s">
                <BtnLink
                    text="Agenda una consulta"
                    href="#contact"
                    className="w-full sm:w-auto py-4 px-10 text-white font-semibold transition-transform hover:scale-105"
                    variant="primary"
                />
            </div>
        </div>
    </Container>
</section>
