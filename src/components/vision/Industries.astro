---
import Container from "../shared/Container.astro";
import { HEADING, PAD, SURFACE } from "./typography";

// Targets `vision artificial proyectos` (pos. 69). The closing block targets
// local intent, the highest commercial value in the report: `visión artificial en
// monterrey` already ranks in position 3.
const industries = [
    {
        name: "Automotriz",
        text: "Inspección de componentes estampados, cordón de soldadura y torque visual, con trazabilidad por número de parte para auditoría de cliente.",
    },
    {
        name: "Alimentos y bebidas",
        text: "Nivel de llenado, integridad del sello, cuerpo extraño y legibilidad de la fecha de caducidad a velocidad de embotellado.",
    },
    {
        name: "Electrónica",
        text: "Presencia y polaridad de componentes en PCB, calidad de pasta de soldadura y lectura de Data Matrix diminutos.",
    },
    {
        name: "Empaque y etiquetado",
        text: "Conteo por charola, etiqueta correcta en el SKU correcto, orientación del producto y verificación de código antes de embarque.",
    },
    {
        name: "Metalmecánica",
        text: "Cotas críticas después del maquinado, rebaba, acabado superficial y clasificación de piezas por familia.",
    },
    {
        name: "Plástico y moldeo",
        text: "Rechupe, línea de flujo, contaminación y piezas cortas detectadas en la salida del molde, antes de acumular scrap.",
    },
];
---

<section
    id="industries"
    class={`relative ${PAD.section} overflow-clip border-t border-[#211915]/10 dark:border-white/10 ${SURFACE.base}`}
>
    <Container className="relative z-10">
        <div class="max-w-3xl mb-12" data-animate="fade-up">
            <h2
                data-reveal="heading"
                class={`${HEADING.section} mb-6`}
            >
                Visión artificial por <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-[#001489] via-[#005EB8] to-[#00B5E2] dark:from-[#4da6ff] dark:via-[#00B5E2] dark:to-[#6de0ff]"
                    >industria</span
                >
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-400">
                El mismo sistema cambia por completo según qué se inspecciona y a
                qué velocidad. Estos son los procesos donde más seguido nos
                llaman.
            </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10" data-reveal="group">
            {
                industries.map((ind, i) => (
                    <div
                        class="rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-900/50 p-6 flex flex-col gap-3 hover:border-[#005EB8]/30 dark:hover:border-[#005EB8]/50 transition-colors"
                    >
                        <h3 class="text-lg font-bold font-heading text-[#211915] dark:text-white">
                            {ind.name}
                        </h3>
                        <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                            {ind.text}
                        </p>
                    </div>
                ))
            }
        </div>

        <div
            class="rounded-xl border border-[#005EB8]/30 dark:border-[#4da6ff]/35 bg-[#005EB8]/5 dark:bg-[#00B5E2]/5 px-7 py-6 flex items-center gap-4"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="flex-shrink-0 w-6 h-6 text-[#005EB8] dark:text-[#4da6ff]"
                aria-hidden="true"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z"></path>
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z"
                ></path>
            </svg>
            <p class="text-[#211915] dark:text-gray-200 leading-relaxed">
                Integramos desde <strong class="font-bold">Monterrey</strong>,
                con instalación y puesta en marcha en planta para Nuevo León,
                Coahuila, Tamaulipas y el Bajío.
            </p>
        </div>
    </Container>
</section>
