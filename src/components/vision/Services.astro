---
import Container from "../shared/Container.astro";
import { HEADING, PAD, SURFACE } from "./typography";
import MagicBento from "../react-bits/MagicBento";
import TargetCursor from "../react-bits/TargetCursor";
import { bentoData } from "./BentoData";
---

<section
    id="services"
    class={`relative ${PAD.section} overflow-clip ${SURFACE.base}`}
>
    <TargetCursor
        spinDuration={2.1}
        hideDefaultCursor={true}
        parallaxOn={false}
        rootSelector="#services"
        client:only="react"
    />
    <Container className="relative z-10">
        <div class="max-w-3xl mb-16" data-animate="fade-up">
            <h2
                class={`${HEADING.section} mb-6`}
            >
                Servicios y <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-[#001489] to-[#00B5E2]"
                    >Capacidades</span
                >
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-400">
                Soluciones integrales de visión artificial diseñadas para la
                industria moderna, combinando potencia de IA con ejecución
                eficiente en el borde.
            </p>
        </div>

        <MagicBento
            cardData={bentoData}
            enableSpotlight={false}
            enableStars={false}
            enableBorderGlow={true}
            enableMagnetism={true}
            enableTilt={false}
            clickEffect={true}
            spotlightRadius={480}
            glowColor="0, 181, 226"
            client:visible
        />
    </Container>
</section>
