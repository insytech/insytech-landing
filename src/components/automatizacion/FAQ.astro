---
import Container from "../shared/Container.astro";

// Las preguntas siguen la forma en que los asistentes de IA buscan proveedor
// («¿qué empresa implementa…?», «plataforma o integrador», «¿cuánto cuesta?»).
// Antes la mitad hablaba de chatbots y leads 24/7, de cuando /ai/ vendía
// atención al cliente y no IA en planta.
const faqItems = [
    {
        question:
            "¿Qué empresa implementa inteligencia artificial industrial en Monterrey y México?",
        answer: "Insytech es un integrador con sede en Monterrey, Nuevo León, que implementa IA sobre la operación de plantas de manufactura: inspección visual con visión artificial, analítica de OEE y paros, monitoreo predictivo de equipos, agentes conectados al ERP y RPA para procesos internos. Hace el levantamiento en sitio, entrena los modelos con las piezas y los turnos del cliente, integra con PLC, MES y ERP, y pone en marcha con la línea andando.",
    },
    {
        question:
            "¿Qué diferencia hay entre una plataforma de IA y un integrador?",
        answer: "Una plataforma de IA es software que tu equipo configura y opera: conviene cuando ya tienes datos limpios y gente dedicada a mantener los modelos. Un integrador lleva el dato desde la máquina hasta la decisión: se conecta al PLC, a las cámaras y al MES, entrena con tus piezas y deja cada decisión registrada con su evidencia —la imagen, la señal, el evento—, ligada a la pieza, al lote y al turno. En manufactura, la parte difícil casi nunca es el modelo, sino esa conexión con la línea.",
    },
    {
        question:
            "¿Por dónde se empieza a aplicar inteligencia artificial en una planta?",
        answer: "Por el proceso donde ya exista un dato confiable y una decisión que hoy alguien toma a ojo. En la práctica el arranque más común es la inspección visual, porque el retorno es directo y medible: sustituye una revisión manual y deja la evidencia de cada pieza. Si la planta todavía captura sus paros en papel, el primer proyecto no es de IA sino de captura, porque un modelo sobre datos incompletos solo automatiza el error.",
    },
    {
        question: "¿Qué necesito tener antes de que la IA sirva de algo?",
        answer: "Tres cosas, y ninguna es un modelo: el proceso descrito con suficiente detalle para saber qué se va a decidir, el dato disponible de forma confiable —imágenes, señales del PLC, registros de producción—, y a alguien de planta que valide los resultados durante el arranque. Cuando falta la segunda, empezamos por ahí; cuando falta la tercera, el sistema se entrega y nadie lo usa.",
    },
    {
        question:
            "¿Cómo se integra la IA con el PLC, el MES y el ERP que ya uso?",
        answer: "Por OPC-UA o MQTT con el PLC y los equipos, y por API con el MES, el ERP y el CRM. Así el modelo lee el dato donde ya se genera y devuelve su resultado donde se usa: el veredicto de inspección al PLC, el paro clasificado al MES o el estatus de un pedido al agente que lo consulta. No hace falta reemplazar los sistemas que ya corren en planta.",
    },
    {
        question:
            "¿Qué determina el costo de un proyecto de IA industrial?",
        answer: "Cuatro cosas: cuántos puntos de decisión cubre, si el dato ya se captura o hay que instrumentar antes, cuántas integraciones lleva —PLC, MES, ERP— y el hardware que necesita, como cámaras, iluminación o cómputo en el borde. Por eso conviene arrancar por un solo punto: el primer alcance queda acotado y sirve para medir el retorno antes de extenderlo.",
    },
    {
        question:
            "¿Atienden plantas en el área de Monterrey y en otros estados?",
        answer: "Sí. Nuestra base está en Monterrey y trabajamos sobre todo con plantas del área metropolitana —Apodaca, Escobedo, Santa Catarina, San Nicolás, Guadalupe— y del resto de Nuevo León, donde podemos estar en piso el mismo día. También atendemos plantas en otros estados de México. El levantamiento y la puesta en marcha siempre se hacen en sitio, porque el modelo se entrena con las piezas y los turnos de cada planta.",
    },
];

const faqSchema = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
        "@type": "Question",
        name: item.question,
        acceptedAnswer: {
            "@type": "Answer",
            text: item.answer,
        },
    })),
};
---

<script
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(faqSchema)}
/>

<section
    id="faq"
    class="relative py-20 overflow-hidden bg-white dark:bg-gray-950"
>
    <Container className="relative z-10">
        <div class="max-w-3xl mx-auto">
            <!-- Header -->
            <div class="text-center mb-12" data-animate="fade-up">
                <h2
                    class="text-3xl sm:text-4xl font-semibold font-heading text-[#211915] dark:text-white leading-tight mb-4"
                >
                    Preguntas{" "}
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-[#001489] via-[#005EB8] to-[#00B5E2] dark:from-[#4da6ff] dark:via-[#00B5E2] dark:to-[#6de0ff]"
                    >
                        frecuentes
                    </span>{" "}
                    sobre inteligencia artificial para la industria
                </h2>
            </div>

            <!-- FAQ Acordeón -->
            <div
                class="space-y-4"
                data-animate="fade-up"
                data-animate-delay=".1s"
            >
                {
                    faqItems.map((item, index) => (
                        <div class="faq-item border border-gray-200 dark:border-gray-700 rounded-xl overflow-hidden bg-gray-50 dark:bg-gray-900/50 hover:border-[#005EB8]/30 dark:hover:border-[#005EB8]/50 transition-colors">
                            <button
                                class="faq-trigger w-full px-6 py-5 flex items-center justify-between text-left"
                                aria-expanded="false"
                                aria-controls={`faq-content-${index}`}
                            >
                                <span class="font-semibold text-[#211915] dark:text-white pr-4">
                                    {item.question}
                                </span>
                                <div class="faq-icon flex-shrink-0 w-8 h-8 rounded-full bg-[#005EB8]/10 dark:bg-[#005EB8]/20 flex items-center justify-center transition-transform duration-300">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke-width="2"
                                        stroke="currentColor"
                                        class="w-4 h-4 text-[#005EB8] dark:text-[#4da6ff]"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M12 4.5v15m7.5-7.5h-15"
                                        />
                                    </svg>
                                </div>
                            </button>
                            <div
                                id={`faq-content-${index}`}
                                class="faq-content hidden px-6 pb-5"
                            >
                                <p class="text-gray-600 dark:text-gray-400 leading-relaxed">
                                    {item.answer}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>

            <!-- CTA -->
            <div
                class="text-center mt-10"
                data-animate="fade-up"
                data-animate-delay=".2s"
            >
                <p class="text-gray-500 dark:text-gray-400 mb-3">
                    ¿Más preguntas?
                </p>
                <a
                    href="#contact"
                    class="inline-flex items-center gap-2 text-[#005EB8] dark:text-[#4da6ff] font-medium hover:underline"
                >
                    <span>Contáctanos</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-4 h-4"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"></path>
                    </svg>
                </a>
            </div>
        </div>
    </Container>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const faqItems = document.querySelectorAll(".faq-item");

        faqItems.forEach((item) => {
            const trigger = item.querySelector(".faq-trigger");
            const content = item.querySelector(".faq-content");
            const icon = item.querySelector(".faq-icon");

            if (!trigger || !content || !icon) return;

            trigger.addEventListener("click", () => {
                const isOpen = trigger.getAttribute("aria-expanded") === "true";

                // Close all other items
                faqItems.forEach((otherItem) => {
                    const otherTrigger =
                        otherItem.querySelector(".faq-trigger");
                    const otherContent =
                        otherItem.querySelector(".faq-content");
                    const otherIcon = otherItem.querySelector(".faq-icon");

                    if (
                        otherItem !== item &&
                        otherTrigger &&
                        otherContent &&
                        otherIcon
                    ) {
                        otherTrigger.setAttribute("aria-expanded", "false");
                        otherContent.classList.add("hidden");
                        otherIcon.classList.remove("rotate-45");
                    }
                });

                // Toggle current item
                trigger.setAttribute("aria-expanded", (!isOpen).toString());
                content.classList.toggle("hidden");
                icon.classList.toggle("rotate-45");
            });
        });
    });
</script>

<style>
    .faq-icon {
        transition: transform 0.3s ease;
    }
    .faq-icon.rotate-45 {
        transform: rotate(45deg);
    }
</style>
