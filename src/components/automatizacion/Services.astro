---
import Container from "../shared/Container.astro";
import { HEADING, PAD, SURFACE } from "@utils/typography";

// Era el último bloque de chatbots que quedaba en pie: cuatro tarjetas de
// atención al cliente, automatización de ventas, integración multicanal y
// soporte técnico, sobre seis capas de SVG de fondo y con `backdrop-filter` en
// cada tarjeta. Vendía un producto distinto al de la página y era además lo más
// caro de pintar del documento.
//
// Lo que cuenta ahora es la cuarta de las cinco aplicaciones —los agentes— en
// detalle, y desde el ángulo industrial: no "conversan", actúan sobre los
// sistemas donde vive la información de la operación. Las cuatro capacidades
// salen del FAQ de esta misma página, que ya declaraba la conexión con CRM, ERP
// y MES por API, los canales de WhatsApp, Messenger y web, y el escalamiento a
// una persona.
//
// La presentación sigue el patrón de la sección `.ai` de fourmula.ai: un titular
// grande y luego paneles amplios y redondeados, cada uno con una etiqueta en
// monoespaciada con viñeta. Sustituye a las tarjetas pequeñas, que junto a los
// paneles azules de arriba se leían como de otro sitio.
//
// Sin imágenes a propósito: ninguna foto industrial ilustra "un agente consulta
// el ERP" sin mentir.
const capabilities = [
    {
        title: "Consulta a tus sistemas",
        body: "Responde «¿dónde va la orden 4821?» leyendo el ERP y el MES, sin que nadie tenga que abrir el sistema ni interrumpir a producción.",
        href: "#contact",
        cta: "Contar tu caso",
    },
    {
        title: "Alta y seguimiento en el CRM",
        body: "Registra al interesado, le da seguimiento fuera de horario y avisa a la persona que corresponde en lugar de dejar el mensaje esperando al lunes.",
        href: "#contact",
        cta: "Contar tu caso",
    },
    {
        title: "Disparo de flujos internos",
        body: "Abre el ticket, notifica al turno y escala cuando la condición lo pide. Es el mismo procedimiento que hoy alguien ejecuta a mano, sin depender de que se acuerde.",
        href: "#contact",
        cta: "Contar tu caso",
    },
    {
        title: "Atención en el canal del cliente",
        body: "WhatsApp con API oficial, Messenger y el widget del sitio desde una sola configuración, con paso a una persona en cuanto la conversación lo requiere.",
        href: "#contact",
        cta: "Contar tu caso",
    },
];
---

<section
    id="services"
    class={`relative overflow-clip ${PAD.section} ${SURFACE.base}`}
>
    <Container className="relative z-10">
        <div class="max-w-3xl mb-12" data-animate="fade-up">
            <p
                class="text-xs font-mono text-[#005EB8] dark:text-blue-400 uppercase tracking-[0.3em] mb-4"
            >
                Una de las cinco, en detalle
            </p>

            <h2 data-reveal="heading" class={`${HEADING.section} mb-4`}>
                Agentes que actúan sobre tus sistemas, no que solo conversan
            </h2>

            <p class="text-lg text-gray-600 dark:text-gray-400">
                La diferencia entre un chatbot y un agente útil en manufactura es
                si puede leer y escribir en los sistemas donde está la
                información. Estos se conectan por API a tu ERP, tu CRM y tu{" "}
                <a href="/tracking/" class="svc-link">software MES</a>.
            </p>
        </div>

        <div class="svc-grid" data-reveal="group">
            {
                capabilities.map((cap, i) => (
                    <article class="svc-panel">
                        <p class="svc-label">
                            <span class="svc-dot" aria-hidden="true" />
                            {String(i + 1).padStart(2, "0")} · {cap.title}
                        </p>
                        <p class="svc-body">{cap.body}</p>
                        <a class="svc-link-cta" href={cap.href}>
                            {cap.cta}
                            <svg
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M5 12h14M13 6l6 6-6 6" />
                            </svg>
                        </a>
                    </article>
                ))
            }
        </div>
    </Container>
</section>

<style>
    .svc-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1.25rem;
    }

    /* Paneles amplios y muy redondeados, como los de la referencia: el contraste
       con los paneles azules de arriba lo da la superficie, no un borde duro. */
    .svc-panel {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: clamp(1.75rem, 3vw, 2.75rem);
        border-radius: 2rem;
        background: rgb(0 94 184 / 0.05);
        transition: background-color 0.35s ease;
    }

    .svc-panel:hover {
        background: rgb(0 94 184 / 0.09);
    }

    :global(.dark) .svc-panel {
        background: rgb(77 166 255 / 0.07);
    }

    :global(.dark) .svc-panel:hover {
        background: rgb(77 166 255 / 0.12);
    }

    .svc-label {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        margin: 0;
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        font-size: 0.72rem;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #005eb8;
    }

    :global(.dark) .svc-label {
        color: #00b5e2;
    }

    .svc-dot {
        width: 0.4rem;
        height: 0.4rem;
        border-radius: 999px;
        background: currentColor;
        flex-shrink: 0;
    }

    .svc-body {
        margin: 0;
        font-family: var(--font-heading);
        font-size: clamp(1.2rem, 1.9vw, 1.65rem);
        font-weight: 600;
        line-height: 1.35;
        letter-spacing: -0.01em;
        color: #211915;
        text-wrap: pretty;
    }

    :global(.dark) .svc-body {
        color: rgb(255 255 255);
    }

    .svc-link-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: auto;
        font-size: 0.9rem;
        font-weight: 600;
        color: #005eb8;
    }

    .svc-link-cta svg {
        width: 0.95rem;
        height: 0.95rem;
        transition: transform 0.3s cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .svc-link-cta:hover svg {
        transform: translateX(3px);
    }

    :global(.dark) .svc-link-cta {
        color: #00b5e2;
    }

    .svc-link {
        font-weight: 500;
        color: #005eb8;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    :global(.dark) .svc-link {
        color: #00b5e2;
    }

    @media (max-width: 767px) {
        .svc-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
