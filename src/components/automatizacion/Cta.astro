---
import { Zap, Brain, Workflow, LifeBuoy } from "@lucide/astro";
import StepsPanel from "../shared/StepsPanel.astro";

// Los cuatro pasos salen del FAQ de esta página: se arranca por un punto, el
// modelo se entrena con datos del cliente, se integra con lo que ya corre en
// planta y se pone en marcha con la línea andando.
//
// El cuarto paso decía «Con soporte 24/7». Se cambió porque el CTA no es el
// lugar para comprometer un nivel de servicio que se negocia por contrato.
const steps = [
    { icon: Zap, title: "Arranque", detail: "Por un punto de inspección" },
    { icon: Brain, title: "Entrenamiento", detail: "Con tus piezas y tus turnos" },
    { icon: Workflow, title: "Integración", detail: "Con lo que ya corre en planta" },
    { icon: LifeBuoy, title: "Puesta en marcha", detail: "Con la línea andando" },
];
---

<StepsPanel
    title="Empecemos por"
    accent="un punto de inspección"
    intro="Así arranca un proyecto de IA en planta con nosotros."
    steps={steps}
    cta={{ text: "Solicita tu demo gratuita", href: "#contact" }}
    note="Sin compromiso • Consulta gratuita • Diagnóstico de tu caso"
/>
