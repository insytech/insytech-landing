---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import { HEADING, PAD, SURFACE } from "@utils/typography";

// Sustituye a About.astro, que era el bloque «¿Por qué elegir nuestros
// chatbots?»: un robot animado con partículas flotando y cuatro insignias —24/7
// Disponible, IA Avanzada, Personalizable, Integración Fácil— que no dicen nada
// verificable y que además hablaban de atender clientes, no de planta.
//
// Lo que va en su lugar responde la objeción real de un comprador industrial,
// que no es "¿por qué IA?" sino "¿qué necesito de mi lado y cómo empieza esto?".
// Los tres bloques no son inventados: salen de las respuestas del FAQ de esta
// misma página sobre por dónde se empieza y qué hace falta tener antes.
//
// La columna izquierda es `sticky` y las tres etapas pasan a su lado. Es el
// mismo recurso que el índice fijo de /vision/ pero sin pinning: no secuestra el
// scroll ni consume pantallas de más, y no necesita una línea de JavaScript.
// `position: sticky` sobrevive aquí porque la sección usa `overflow-clip` y no
// `overflow-hidden`, que sí habría creado un contenedor de scroll y lo habría
// roto.
//
// La presentación se alineó con el resto de /ai/: las etapas eran tarjetas
// blancas con borde y sombra, que al lado de los paneles azules y de los paneles
// redondeados de agentes se leían como de otra plantilla. Ahora son filas
// separadas por filetes, con el número en grande como en los paneles y sin caja
// alrededor.
const stages = [
    {
        number: "01",
        title: "Lo que pones tú",
        body: "El proceso descrito con detalle suficiente para saber qué se va a decidir, el dato disponible de forma confiable —imágenes, señales del PLC, registros de producción— y alguien de planta que valide los resultados durante el arranque.",
        note: "Si el dato todavía se captura en papel, el primer proyecto no es de IA sino de captura.",
    },
    {
        number: "02",
        title: "Lo que ponemos nosotros",
        body: "El levantamiento en sitio, el modelo entrenado con tus propias piezas y tus propios turnos, la integración con lo que ya corre en planta por OPC-UA, MQTT o API, y la puesta en marcha con la línea andando.",
        note: "Nada de modelos genéricos entrenados con imágenes de otra fábrica.",
    },
    {
        number: "03",
        title: "Cómo se sabe que funciona",
        body: "Se compara contra el criterio que la planta usa hoy, no contra una métrica de laboratorio. Cada decisión deja evidencia —la imagen, el registro, el evento— y con los casos que falla se ajusta antes de ampliar el alcance.",
        note: "Primero un punto de inspección, y se extiende cuando ese punto ya se sostiene solo.",
    },
];
---

<section
    id="how-it-works"
    class={`relative overflow-clip ${PAD.section} ${SURFACE.base}`}
>
    <Container className="relative z-10">
        <div class="hiw-grid">
            <div class="hiw-aside-cell">
                <div class="hiw-aside">
                <p
                    class="text-xs font-mono text-[#005EB8] dark:text-blue-400 uppercase tracking-[0.3em] mb-4"
                >
                    Cómo trabajamos
                </p>

                <h2 data-reveal="heading" class={`${HEADING.section} mb-5`}>
                    Qué hace falta para que la IA sirva en tu planta
                </h2>

                <p class="text-lg text-gray-600 dark:text-gray-400 mb-6">
                    La IA no sustituye a la instrumentación: se apoya en ella. Se
                    conecta a tu{" "}
                    <a href="/control/" class="hiw-link">
                        automatización y control
                    </a>, a tu{" "}
                    <a href="/tracking/" class="hiw-link">
                        trazabilidad de producción
                    </a>{" "}
                    y a tu{" "}
                    <a href="/software/" class="hiw-link">
                        software industrial
                    </a>, que son los que generan el dato sobre el que puede
                    decidir.
                </p>

                {/* Texto distinto al del hero a propósito: los dos llevan a
                    #contact, y dos anclas idénticas al mismo destino se anuncian
                    como duplicadas y no dicen a qué se llega. */}
                <BtnLink
                    href="#contact"
                    text="Empecemos por un punto"
                    variant="primary"
                />
                </div>
            </div>

            <ol class="hiw-stages" data-reveal="group">
                {
                    stages.map((stage) => (
                        <li class="hiw-stage">
                            <span class="hiw-number" aria-hidden="true">
                                {stage.number}
                            </span>
                            <div class="hiw-content">
                                <h3 class="hiw-title">{stage.title}</h3>
                                <p class="hiw-body">{stage.body}</p>
                                <p class="hiw-note">{stage.note}</p>
                            </div>
                        </li>
                    ))
                }
            </ol>
        </div>
    </Container>
</section>

<style>
    .hiw-grid {
        display: grid;
        grid-template-columns: minmax(18rem, 26rem) 1fr;
        gap: clamp(2rem, 5vw, 5rem);
        align-items: start;
    }

    /* La celda ocupa toda la altura de la fila y el `sticky` va dentro. Puesto
       directamente sobre el ítem de la reja no se pegaba: con `align-items:
       start` el ítem mide lo que su contenido y no le queda recorrido por el que
       deslizarse.
       El `top` no es el hueco bajo el nav: es dónde se queda parada la columna
       mientras las etapas pasan al lado. Con 7rem se pegaba arriba del todo y
       quedaba descolgada; a esta altura queda ópticamente centrada. */
    .hiw-aside-cell {
        align-self: stretch;
    }

    .hiw-aside {
        position: sticky;
        top: clamp(6rem, 22vh, 13rem);
    }

    .hiw-link {
        font-weight: 500;
        color: #005eb8;
        text-decoration: underline;
        text-underline-offset: 2px;
        transition: color 0.25s ease;
    }

    .hiw-link:hover {
        color: #001489;
    }

    :global(.dark) .hiw-link {
        color: #00b5e2;
    }

    .hiw-stages {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    /* Filas con filete en vez de tarjetas: mismo recurso que los paneles de
       arriba, donde la separación la marca una línea de un píxel y no una caja. */
    .hiw-stage {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: clamp(1.25rem, 3vw, 2.5rem);
        padding: clamp(1.75rem, 3vw, 2.5rem) 0;
        border-top: 1px solid rgb(229 231 235);
    }

    .hiw-stage:last-child {
        border-bottom: 1px solid rgb(229 231 235);
    }

    :global(.dark) .hiw-stage,
    :global(.dark) .hiw-stage:last-child {
        border-color: rgb(31 41 55);
    }

    /* El número en grande, como en los paneles azules: es lo que hace que las dos
       secciones se lean como el mismo sistema. */
    .hiw-number {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 4vw, 3.25rem);
        font-weight: 800;
        line-height: 0.95;
        letter-spacing: -0.03em;
        color: rgb(0 94 184 / 0.28);
    }

    :global(.dark) .hiw-number {
        color: rgb(0 181 226 / 0.32);
    }

    :global(.dark) .hiw-number {
        color: #00b5e2;
    }

    .hiw-title {
        font-family: var(--font-heading);
        font-size: clamp(1.25rem, 2vw, 1.6rem);
        font-weight: 700;
        color: #211915;
        margin-bottom: 0.6rem;
    }

    :global(.dark) .hiw-title {
        color: rgb(255 255 255);
    }

    .hiw-body {
        color: rgb(75 85 99);
        line-height: 1.7;
        margin-bottom: 0.75rem;
    }

    :global(.dark) .hiw-body {
        color: rgb(156 163 175);
    }

    /* La línea que aterriza cada etapa. Va en cursiva y no en color para que se
       lea como una aclaración honesta y no como otro argumento de venta. */
    .hiw-note {
        font-size: 0.9rem;
        font-style: italic;
        line-height: 1.6;
        color: rgb(107 114 128);
        padding-left: 0.9rem;
        border-left: 2px solid rgb(0 94 184 / 0.25);
    }

    :global(.dark) .hiw-note {
        color: rgb(107 114 128);
        border-left-color: rgb(0 181 226 / 0.3);
    }

    @media (max-width: 1023px) {
        .hiw-grid {
            grid-template-columns: 1fr;
        }

        /* Sin columna al lado, fijar el encabezado no aporta nada y estorba. */
        .hiw-aside {
            position: static;
        }
    }
</style>
