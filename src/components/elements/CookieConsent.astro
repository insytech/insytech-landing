---
// Aviso de cookies bajo consentimiento tácito (LFPDPPP).
//
// Antes esto eran 576 líneas en TRES bloques <script> —el segundo y el tercero
// copia literal uno del otro— que escuchaban los mismos botones y escribían tres
// esquemas de almacenamiento distintos. Y ninguno tocaba Google Analytics: el
// banner prometía que la analítica se activaba «solo con tu consentimiento»,
// guardaba la respuesta y nadie la leía nunca. La promesa era falsa, que es el
// problema de verdad, no la cookie.
//
// Ahora hay un solo script, un solo almacenamiento, y «Rechazar» apaga la
// medición de verdad: GoogleAnalytics.astro lee esta misma clave antes de
// cargar gtag y escucha el evento `cookie-consent` para cortar en caliente.
//
// También se retiró el modal de preferencias con interruptores de «Funcionales»
// y «Analíticas»: la única categoría que el sitio usa de verdad es la analítica,
// así que ofrecer un interruptor de funcionales era pedir permiso para algo que
// no existe.
---

<div
    data-cookie-banner
    hidden
    role="region"
    aria-label="Aviso de cookies"
    class="fixed z-[60] bottom-4 left-4 right-4 md:left-1/2 md:-translate-x-1/2 max-w-3xl mx-auto bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-800 rounded-2xl shadow-xl p-4 md:p-5"
>
    <div class="flex flex-col md:flex-row md:items-start gap-4">
        <div class="flex-1 text-sm text-gray-700 dark:text-gray-300">
            <p class="font-semibold text-gray-900 dark:text-gray-100">
                Medimos cómo se usa este sitio
            </p>
            <p class="mt-1">
                Usamos Google Analytics para saber qué páginas sirven y qué
                contenido publicar. La medición empieza cuando entras; si la
                rechazas, dejamos de medirte aquí mismo y en tus próximas
                visitas. No usamos cookies de publicidad ni vendemos tu
                navegación. Más detalle en el <a
                    href="/privacy/"
                    class="underline text-[#005EB8] dark:text-[#00B5E2]"
                    >aviso de privacidad</a
                >.
            </p>
        </div>
        <div class="flex-shrink-0 flex gap-2">
            <button
                type="button"
                data-cc-reject
                class="px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-700 text-gray-700 dark:text-gray-200 hover:bg-gray-50 dark:hover:bg-gray-800"
                >Rechazar</button
            >
            <button
                type="button"
                data-cc-accept
                class="px-4 py-2 rounded-lg bg-[#005EB8] text-white hover:bg-[#004a92]"
                >Aceptar</button
            >
        </div>
    </div>
</div>

<script>
    (() => {
        const init = () => {
            const banner = document.querySelector("[data-cookie-banner]");
            if (!banner) return;

            const read = () => {
                try {
                    const ls = localStorage.getItem("cookieConsent");
                    if (ls) return ls;
                } catch {}
                const m = document.cookie.match(
                    /(?:^|; )cookie_consent=([^;]*)/,
                );
                return m ? decodeURIComponent(m[1]) : "";
            };

            const decide = (value: "accepted" | "rejected") => {
                try {
                    localStorage.setItem("cookieConsent", value);
                } catch {}
                // La cookie duplica el localStorage a propósito: en navegación
                // privada el localStorage puede lanzar, y entonces la decisión
                // sobrevive igual dentro de la sesión.
                document.cookie = `cookie_consent=${value}; max-age=31536000; path=/; SameSite=Lax`;
                // GoogleAnalytics.astro escucha esto para cortar el envío sin
                // esperar a la siguiente carga.
                window.dispatchEvent(
                    new CustomEvent("cookie-consent", { detail: value }),
                );
                banner.setAttribute("hidden", "");
            };

            if (!read()) banner.removeAttribute("hidden");

            document
                .querySelector("[data-cc-accept]")
                ?.addEventListener("click", () => decide("accepted"));
            document
                .querySelector("[data-cc-reject]")
                ?.addEventListener("click", () => decide("rejected"));

            // Permite reabrir la decisión desde donde sea (por ejemplo el pie).
            document
                .querySelectorAll("[data-open-cookie-preferences]")
                .forEach((el) =>
                    el.addEventListener("click", (e) => {
                        e.preventDefault();
                        banner.removeAttribute("hidden");
                    }),
                );
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", init, { once: true });
        } else {
            init();
        }
    })();
</script>
