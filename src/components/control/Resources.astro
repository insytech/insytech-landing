---
import RelatedPosts from "../shared/RelatedPosts.astro";
import type { RelatedPost } from "../shared/RelatedPosts.astro";
import { HEADING, PAD, SURFACE } from "@utils/typography";

// La página no enlazaba un solo post, y es la más delgada de las de servicio
// (1,574 palabras). Dos de estos rankean mejor que ella para temas vecinos:
// `como-elegir-proveedor-automatizacion-inteligente` está en la posición 5.91 y
// `automatizacion-y-control-industrial-guia` en la 9.
const posts: readonly RelatedPost[] = [
    {
        title: "Automatización industrial: guía de control de procesos",
        summary:
            "Qué se automatiza primero y cómo se mide si valió la pena.",
        href: "/blog/automatizacion-y-control-industrial-guia/",
    },
    {
        title: "Cómo elegir un proveedor de automatización inteligente",
        summary: "Diez preguntas que separan a un integrador de un vendedor.",
        href: "/blog/como-elegir-proveedor-automatizacion-inteligente/",
    },
    {
        title: "Trazabilidad industrial y sistemas MES",
        summary:
            "Qué hacer con los datos una vez que el PLC y el SCADA los generan.",
        href: "/blog/trazabilidad-sistemas-mes-planta/",
    },
    {
        title: "Inteligencia artificial en la industria",
        summary: "Casos reales de IA en manufactura, sin promesas de folleto.",
        href: "/blog/inteligencia-artificial-industria-manufactura/",
    },
    {
        title: "Automatización por proyecto en el corredor de Nuevo León",
        summary:
            "Qué entra en la primera fase, qué se deja para después y cómo se ejecuta.",
        href: "/blog/automatizacion-industrial-monterrey/",
    },
    {
        title: "Sistema SCADA en Monterrey: cómo elegir plataforma e integrador",
        summary:
            "Qué resuelve un SCADA en piso de planta y cómo comparar Ignition, Aveva y WinCC.",
        href: "/blog/sistema-scada-monterrey/",
    },
];
---

<RelatedPosts
    posts={posts}
    heading="Antes de automatizar, léete esto"
    intro="Escribimos sobre lo que nos preguntan en las juntas. Sin vender."
    class={`${PAD.minor} ${SURFACE.base}`}
    headingClass={HEADING.minor}
/>
