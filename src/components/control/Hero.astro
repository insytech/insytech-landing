---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";

// Datos ciertos por construcción: la fundación en 2018 la confirmó el cliente, y
// las marcas de PLC, las plataformas de SCADA y el soporte los declara esta
// misma página más abajo y el FAQ. Ninguno es una promesa.
const stats = [
    { value: "Desde 2018", label: "En planta" },
    { value: "4", label: "Marcas de PLC" },
    { value: "4", label: "Plataformas SCADA" },
];

// Diagrama escalera del hero. La geometría vive aquí y el estado lo mueve el
// script de abajo: el servidor ya pinta un estado energizado (motor en marcha,
// pieza detectada, timer cumplido) para que la primera imagen y quien no
// ejecute JS vean el diagrama "vivo". Las direcciones son IEC genéricas a
// propósito, para no atar el hero a una sola marca de PLC.
const R0 = 64; // rung 0
const B0 = 114; // rama de retención del rung 0
const R1 = 210; // rung 1
const R2 = 300; // rung 2

// `s` es la clave de energía del tramo; el script la resuelve en cada scan.
const wires = [
    { s: "t", x1: 24, y1: R0, x2: 92, y2: R0 },
    { s: "start", x1: 108, y1: R0, x2: 150, y2: R0 },
    { s: "t", x1: 48, y1: R0, x2: 48, y2: B0 },
    { s: "t", x1: 48, y1: B0, x2: 92, y2: B0 },
    { s: "seal", x1: 108, y1: B0, x2: 150, y2: B0 },
    { s: "seal", x1: 150, y1: B0, x2: 150, y2: R0 },
    { s: "pA", x1: 150, y1: R0, x2: 212, y2: R0 },
    { s: "pB", x1: 228, y1: R0, x2: 312, y2: R0 },
    { s: "pC", x1: 328, y1: R0, x2: 470, y2: R0 },
    { s: "pC", x1: 490, y1: R0, x2: 536, y2: R0 },
    { s: "t", x1: 24, y1: R1, x2: 92, y2: R1 },
    { s: "q1", x1: 108, y1: R1, x2: 212, y2: R1 },
    { s: "q2", x1: 228, y1: R1, x2: 300, y2: R1 },
    { s: "q2", x1: 440, y1: R1, x2: 536, y2: R1 },
    { s: "t", x1: 24, y1: R2, x2: 92, y2: R2 },
    { s: "r1", x1: 108, y1: R2, x2: 212, y2: R2 },
    { s: "r2", x1: 228, y1: R2, x2: 470, y2: R2 },
    { s: "r2", x1: 490, y1: R2, x2: 536, y2: R2 },
];

// `c` es la clave de estado del contacto: "t" cuando deja pasar corriente.
const contacts = [
    { c: "start", x: 100, y: R0, tag: "PB_ARRANQUE", addr: "%I0.0", nc: false },
    // La retención lleva sus etiquetas debajo: arriba chocarían con la dirección de PB_ARRANQUE.
    { c: "seal", x: 100, y: B0, tag: "MOTOR_M1", addr: "%Q0.0", nc: false, below: true },
    { c: "stop", x: 220, y: R0, tag: "PB_PARO", addr: "%I0.1", nc: true },
    { c: "estop", x: 320, y: R0, tag: "PARO_EMERG_OK", addr: "%I0.2", nc: false },
    { c: "q1", x: 100, y: R1, tag: "MOTOR_M1", addr: "%Q0.0", nc: false },
    { c: "sens", x: 220, y: R1, tag: "SENSOR_PIEZA", addr: "%I0.3", nc: false },
    { c: "dnc", x: 100, y: R2, tag: "T_ESPERA.DN", addr: "", nc: false },
    { c: "fault", x: 220, y: R2, tag: "BANDA_FALLA", addr: "%I0.4", nc: true },
];

const coils = [
    { c: "m1", x: 480, y: R0, tag: "MOTOR_M1", addr: "%Q0.0" },
    { c: "conv", x: 480, y: R2, tag: "BANDA_MARCHA", addr: "%Q0.1" },
];

const rungs = [
    { n: 0, y: R0, text: "Arranque del motor con retención" },
    { n: 1, y: R1, text: "Espera con pieza en posición" },
    { n: 2, y: R2, text: "Marcha de la banda con enclavamiento de falla" },
];

// Estado que pinta el servidor. Todo energizado salvo el botón de arranque,
// que ya se soltó: el motor sigue por la retención.
const initialPower = new Set(["t", "seal", "pA", "pB", "pC", "q1", "q2", "r1", "r2"]);
const initialPass = new Set(["seal", "stop", "estop", "m1", "q1", "sens", "q2", "dnc", "fault", "conv"]);
---

<section
    data-control-hero
    class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-gray-50 via-white to-gray-100 dark:from-gray-950 dark:via-gray-900 dark:to-gray-950"
>
    <!-- Animated grid pattern -->
    <div class="absolute inset-0 opacity-30 dark:opacity-20">
        <div
            class="absolute inset-0"
            style="background-image: linear-gradient(rgba(0, 94, 184, 0.1) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 94, 184, 0.1) 1px, transparent 1px); background-size: 60px 60px;"
        >
        </div>
    </div>

    <!-- Floating industrial elements -->
    <div class="absolute inset-0 overflow-hidden">
        <!-- Glowing orbs -->
        <div
            class="absolute top-1/4 right-1/4 w-96 h-96 bg-[#00B5E2]/5 rounded-full blur-3xl animate-pulse"
        >
        </div>
        <div
            class="absolute bottom-1/3 left-1/4 w-72 h-72 bg-[#005EB8]/5 rounded-full blur-3xl animate-pulse"
            style="animation-delay: 1s;"
        >
        </div>

        <!-- Circuit lines -->
        <svg
            class="absolute top-0 right-0 w-1/2 h-full opacity-10 dark:opacity-20"
            viewBox="0 0 400 800"
        >
            <path
                d="M 50 0 L 50 200 L 150 200 L 150 400 L 250 400 L 250 600 L 350 600 L 350 800"
                stroke="url(#circuitGradient)"
                stroke-width="2"
                fill="none"
                class="circuit-path"></path>
            <path
                d="M 150 0 L 150 100 L 250 100 L 250 300 L 350 300 L 350 500"
                stroke="url(#circuitGradient)"
                stroke-width="2"
                fill="none"
                class="circuit-path"
                style="animation-delay: 0.5s;"></path>
            <path
                d="M 300 0 L 300 150 L 200 150 L 200 350 L 100 350 L 100 550 L 50 550"
                stroke="url(#circuitGradient)"
                stroke-width="2"
                fill="none"
                class="circuit-path"
                style="animation-delay: 1s;"></path>
            <!-- Nodes -->
            <circle cx="150" cy="200" r="4" fill="#00B5E2"></circle>
            <circle cx="250" cy="400" r="4" fill="#00B5E2"></circle>
            <circle cx="250" cy="100" r="4" fill="#00B5E2"></circle>
            <circle cx="200" cy="350" r="4" fill="#00B5E2"></circle>
            <defs>
                <linearGradient
                    id="circuitGradient"
                    x1="0%"
                    y1="0%"
                    x2="0%"
                    y2="100%"
                >
                    <stop offset="0%" stop-color="#005EB8"></stop>
                    <stop offset="50%" stop-color="#00B5E2"></stop>
                    <stop offset="100%" stop-color="#005EB8"></stop>
                </linearGradient>
            </defs>
        </svg>
    </div>

    <Container className="relative z-10">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
            <!-- Content -->
            <div class="py-20 lg:py-32">

                <!-- Title -->
                <h1
                    class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight mb-6"
                    data-animate="fade-up"
                    data-animate-delay=".1s"
                >
                    {
                        /* El {" "} va explícito porque Astro 7 se come el
                           espacio entre una palabra y un span contiguo. Los dos
                           spans son `block`, así que en pantalla no se notaba,
                           pero el nombre accesible del H1 y el texto que indexa
                           el buscador salían como "para tulínea". */
                    }
                    <span class="block text-[#211915] dark:text-white"
                        >Automatización industrial para tu</span
                    >{" "}
                    <span
                        class="block text-transparent bg-clip-text bg-gradient-to-r from-[#001489] via-[#005EB8] to-[#00B5E2] dark:from-[#4da6ff] dark:via-[#00B5E2] dark:to-[#6de0ff]"
                    >
                        línea de producción
                    </span>
                </h1>

                <!-- Description -->
                <p
                    class="text-lg text-gray-600 dark:text-gray-400 max-w-xl mb-10 leading-relaxed"
                    data-animate="fade-up"
                    data-animate-delay=".2s"
                >
                    Integración de PLC, SCADA e IoT industrial diseñada para
                    maximizar tu eficiencia operativa y reducir tiempos muertos.
                </p>

                <!-- CTAs -->
                <div
                    class="flex flex-wrap gap-4 mb-12"
                    data-animate="fade-up"
                    data-animate-delay=".3s"
                >
                    <BtnLink
                        href="#contact"
                        text="Solicitar cotización"
                        variant="primary"
                        className="px-8 py-4"
                    />
                    <BtnLink
                        href="#services"
                        text="Ver soluciones"
                        variant="secondary"
                        className="px-8 py-4 border-2 border-gray-300 dark:border-gray-600"
                    />
                </div>

                <!-- Cuatro datos verificables, no cifras de folleto: los años
                     vienen del deck de ventas, y las marcas, las plataformas y el
                     soporte los declara esta misma página más abajo y el FAQ.
                     Antes aquí vivía un conteo de proyectos y un porcentaje de
                     uptime que no decía uptime de qué, ninguno con respaldo. -->
                <!-- Rejilla y no flex-wrap: los separadores son bordes, así que
                     solo existen donde hay vecino y no queda ninguno colgando al
                     final de la fila. Tres columnas desde móvil: los tres valores
                     son cortos y caben. -->
                <div
                    class="grid grid-cols-3 gap-y-6"
                    data-animate="fade-up"
                    data-animate-delay=".4s"
                >
                    {
                        stats.map((stat, i) => (
                            <div
                                class:list={[
                                    "px-5 first:pl-0",
                                    "border-l border-gray-200 dark:border-gray-700 first:border-l-0",
                                ]}
                            >
                                <div class="text-3xl font-bold text-[#005EB8] dark:text-[#00B5E2]">
                                    {stat.value}
                                </div>
                                <div class="text-sm text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                                    {stat.label}
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>

            <!-- Visual: diagrama escalera en modo en línea, con SCADA y sensores flotando -->
            <div class="relative hidden lg:block" data-animate="slide-left">
                <div class="relative">
                    <!-- Escalera en lugar de Structured Text: es lo que ingeniería
                         de automatización y mantenimiento lee de un vistazo en el
                         software de programación o en un tablero. -->
                    <div
                        class="relative text-gray-900 dark:text-gray-100 bg-gray-100 dark:bg-gray-800 rounded-2xl shadow-2xl shadow-gray-900/30 dark:shadow-black/50 p-5 border border-gray-300 dark:border-gray-600 ld-mono"
                    >
                        <!-- Header -->
                        <div class="flex items-center justify-between mb-3 text-xs text-gray-500 dark:text-gray-400">
                            <span>OB1 · Main · LD</span>
                            <span class="ld-run">EN LÍNEA · RUN</span>
                        </div>

                        <svg
                            class="ld"
                            data-ladder
                            viewBox="0 0 576 342"
                            role="img"
                            aria-label="Diagrama escalera: arranque de motor con retención, temporizador TON por sensor de pieza y marcha de la banda"
                        >
                            <g transform="translate(16,0)">
                                <line class="rail-l" x1="24" y1="30" x2="24" y2="322"></line>
                                <line class="rail-r" x1="536" y1="30" x2="536" y2="322"></line>

                                {
                                    rungs.map((r) => (
                                        <Fragment>
                                            <text class="num" x="4" y={r.y + 4} text-anchor="middle">{r.n}</text>
                                            <text class="cmt" x="34" y={r.y - 40}>{`(* ${r.text} *)`}</text>
                                        </Fragment>
                                    ))
                                }

                                {
                                    wires.map((w) => (
                                        <line
                                            class:list={["w", { on: initialPower.has(w.s) }]}
                                            data-s={w.s}
                                            x1={w.x1}
                                            y1={w.y1}
                                            x2={w.x2}
                                            y2={w.y2}
                                        />
                                    ))
                                }

                                {
                                    contacts.map((ct) => (
                                        <g data-c={ct.c} class:list={{ t: initialPass.has(ct.c) }}>
                                            <rect class="fill" x={ct.x - 8} y={ct.y - 13} width="16" height="26" />
                                            <line class="bar" x1={ct.x - 8} y1={ct.y - 13} x2={ct.x - 8} y2={ct.y + 13} />
                                            <line class="bar" x1={ct.x + 8} y1={ct.y - 13} x2={ct.x + 8} y2={ct.y + 13} />
                                            {ct.nc && (
                                                <line class="bar" x1={ct.x - 12} y1={ct.y + 11} x2={ct.x + 12} y2={ct.y - 11} />
                                            )}
                                            <text class="tag" x={ct.x} y={ct.below ? ct.y + 26 : ct.y - 21} text-anchor="middle">{ct.tag}</text>
                                            {ct.addr && (
                                                <text class="addr" x={ct.x} y={ct.below ? ct.y + 38 : ct.y + 28} text-anchor="middle">{ct.addr}</text>
                                            )}
                                        </g>
                                    ))
                                }

                                {
                                    coils.map((cl) => (
                                        <g data-c={cl.c} class:list={{ t: initialPass.has(cl.c) }}>
                                            <ellipse class="fill" cx={cl.x} cy={cl.y} rx="10" ry="12" />
                                            <path class="bar" d={`M${cl.x - 5} ${cl.y - 13} Q${cl.x - 15} ${cl.y} ${cl.x - 5} ${cl.y + 13}`} />
                                            <path class="bar" d={`M${cl.x + 5} ${cl.y - 13} Q${cl.x + 15} ${cl.y} ${cl.x + 5} ${cl.y + 13}`} />
                                            <text class="tag" x={cl.x} y={cl.y - 21} text-anchor="middle">{cl.tag}</text>
                                            <text class="addr" x={cl.x} y={cl.y + 28} text-anchor="middle">{cl.addr}</text>
                                        </g>
                                    ))
                                }

                                <!-- Temporizador TON del rung 1 -->
                                <g data-c="q2" class="t">
                                    <rect class="box" x="300" y={R1 - 30} width="140" height="62" rx="4"></rect>
                                </g>
                                <text class="tag" x="370" y={R1 - 38} text-anchor="middle">T_ESPERA</text>
                                <text class="box-t" x="312" y={R1 - 12}>TON</text>
                                <text class="box-v" x="312" y={R1 + 8}>PT  T#2s</text>
                                <text class="box-v" data-et x="312" y={R1 + 23}>ET  T#2.0s</text>
                                <text class="dn t" data-dn x="430" y={R1 + 8} text-anchor="end">DN</text>
                            </g>
                        </svg>

                        <div class="flex justify-end gap-4 mt-1 text-[0.68rem] text-gray-500 dark:text-gray-400">
                            <span class="inline-flex items-center gap-1.5"><i class="ld-key ld-key-on"></i>Energizado</span>
                            <span class="inline-flex items-center gap-1.5"><i class="ld-key ld-key-off"></i>Sin flujo</span>
                        </div>
                    </div>

                    <!-- SCADA Panel floating card: refleja el mismo estado que el diagrama -->
                    <div
                        class="absolute -top-20 -right-6 bg-white dark:bg-gray-800 rounded-xl shadow-xl p-4 border border-gray-100 dark:border-gray-700 w-48"
                    >
                        <div class="flex items-center gap-2 mb-3">
                            <div
                                class="w-8 h-8 rounded-lg bg-gradient-to-br from-[#005EB8] to-[#00B5E2] flex items-center justify-center"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="2"
                                    stroke="currentColor"
                                    class="w-4 h-4 text-white"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25"
                                    ></path>
                                </svg>
                            </div>
                            <span
                                class="text-sm font-semibold text-gray-900 dark:text-white"
                                >SCADA</span
                            >
                        </div>
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-gray-500">Motor 1</span>
                                <span class="led on-g" data-led="m1"></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-gray-500">Banda</span>
                                <span class="led on-g" data-led="conv"></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-gray-500">Sensor pieza</span>
                                <span class="led on-y" data-led="sens"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Sensors floating card -->
                    <div
                        class="absolute -bottom-4 -left-6 bg-white dark:bg-gray-800 rounded-xl shadow-xl p-4 border border-gray-100 dark:border-gray-700"
                    >
                        <div class="flex items-center gap-3">
                            <div
                                class="w-10 h-10 rounded-lg bg-[#00B5E2]/10 flex items-center justify-center"
                            >
                                <svg
                                    xmlns="http://www.w3.org/2000/svg"
                                    fill="none"
                                    viewBox="0 0 24 24"
                                    stroke-width="2"
                                    stroke="currentColor"
                                    class="w-5 h-5 text-[#00B5E2]"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"
                                    ></path>
                                </svg>
                            </div>
                            <div>
                                <div
                                    class="text-sm font-semibold text-gray-900 dark:text-white"
                                >
                                    12 Sensores
                                </div>
                                <div class="text-xs text-gray-500">
                                    Conectados vía OPC-UA
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </Container>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2">
        <div
            class="w-6 h-10 rounded-full border-2 border-gray-300 dark:border-gray-600 flex items-start justify-center p-1"
        >
            <div
                class="w-1 h-2 bg-gray-400 dark:bg-gray-500 rounded-full animate-bounce"
            >
            </div>
        </div>
    </div>
</section>

<script>
    // Simulación del modo "en línea": cada cuadro evalúa los tres rungs como un
    // scan de PLC y marca qué tramos llevan corriente. La secuencia se repite:
    // arranque, pieza detectada, cuenta del timer, banda en marcha, paro.
    const CYCLE_MS = 11000;
    const PRESET_MS = 2000;

    type Inputs = { start: boolean; stop: boolean; estop: boolean; sensor: boolean; fault: boolean };

    function inputsAt(t: number): Inputs {
        return {
            start: t > 600 && t < 1200,
            stop: t > 7600 && t < 8200,
            estop: true,
            sensor: t > 2200 && t < 6600,
            fault: false,
        };
    }

    function runLadder(svg: SVGSVGElement) {
        const wires = svg.querySelectorAll<SVGElement>("[data-s]");
        const parts = svg.querySelectorAll<SVGElement>("[data-c]");
        const et = svg.querySelector<SVGTextElement>("[data-et]");
        const dn = svg.querySelector<SVGTextElement>("[data-dn]");
        // LEDs acotados al hero para no tocar otro `data-led` de la página.
        const leds = (svg.closest("[data-control-hero]") ?? svg).querySelectorAll<HTMLElement>("[data-led]");

        // Mismo estado que pinta el servidor, para que el primer cuadro no salte.
        let m1 = true;
        let acc = PRESET_MS;

        function scan(i: Inputs, dt: number) {
            // Rung 0 se evalúa dos veces para que la retención tome su propio valor.
            let pA = i.start || m1;
            let pB = pA && !i.stop;
            let pC = pB && i.estop;
            m1 = pC;
            pA = i.start || m1;
            pB = pA && !i.stop;
            pC = pB && i.estop;

            const q1 = m1;
            const q2 = q1 && i.sensor;
            acc = q2 ? Math.min(PRESET_MS, acc + dt) : 0;
            const done = acc >= PRESET_MS;
            const r2 = done && !i.fault;

            const power: Record<string, boolean> = { t: true, start: i.start, seal: m1, pA, pB, pC, q1, q2, r1: done, r2 };
            const pass: Record<string, boolean> = {
                start: i.start, seal: m1, stop: !i.stop, estop: i.estop, m1: pC,
                q1, sens: i.sensor, q2, dnc: done, fault: !i.fault, conv: r2,
            };
            wires.forEach((el) => el.classList.toggle("on", !!power[el.dataset.s ?? ""]));
            parts.forEach((el) => el.classList.toggle("t", !!pass[el.dataset.c ?? ""]));
            if (et) et.textContent = `ET  T#${(acc / 1000).toFixed(1)}s`;
            dn?.classList.toggle("t", done);

            const led: Record<string, string> = { m1: m1 ? "on-g" : "", conv: r2 ? "on-g" : "", sens: i.sensor ? "on-y" : "" };
            leds.forEach((el) => {
                el.classList.remove("on-g", "on-y");
                const cls = led[el.dataset.led ?? ""];
                if (cls) el.classList.add(cls);
            });
        }

        // Con movimiento reducido se queda el estado energizado del servidor.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        // Solo corre mientras el diagrama está en pantalla. En móvil la tarjeta
        // está oculta (`hidden lg:block`), así que ahí nunca arranca.
        let clock = 0;
        let last = 0;
        let raf = 0;
        let visible = false;
        // El primer arranque deja ver el estado energizado del servidor un
        // momento antes de reiniciar la secuencia desde cero.
        let warmup = true;
        let warmupTimer = 0;

        function frame(now: number) {
            const dt = last ? Math.min(100, now - last) : 0;
            last = now;
            clock = (clock + dt) % CYCLE_MS;
            scan(inputsAt(clock), dt);
            raf = requestAnimationFrame(frame);
        }

        // Único punto que arranca el loop, así nunca hay dos corriendo.
        function start() {
            if (raf || !visible) return;
            last = 0;
            raf = requestAnimationFrame(frame);
        }

        function stop() {
            window.clearTimeout(warmupTimer);
            warmupTimer = 0;
            if (raf) cancelAnimationFrame(raf);
            raf = 0;
        }

        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            if (!visible) return stop();
            if (!warmup) return start();
            if (warmupTimer) return;
            warmupTimer = window.setTimeout(() => {
                warmupTimer = 0;
                warmup = false;
                m1 = false;
                acc = 0;
                start();
            }, 1500);
        }).observe(svg);
    }

    const ladder = document.querySelector<SVGSVGElement>("[data-ladder]");
    if (ladder) runLadder(ladder);
</script>

