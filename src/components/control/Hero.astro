---
// /control/ hero: a full-bleed section (the floating navbar sits over it) with
// the copy on the left and the PLC ladder screen on the right, bleeding off
// the viewport's right edge. The ladder geometry, SVG markup and scan-cycle
// script are the same ones this hero always had. Surface and screen follow the
// site theme: light is a soft brand-tinted surface with a light, IDE-like
// ladder editor; dark uses the /software/ dark recipe with the dark screen.
import BtnLink from "../shared/BtnLink.astro";

// Verifiable facts, copied verbatim from Hero.astro.
const stats = [
    { value: "Desde 2018", label: "En planta" },
    { value: "4", label: "Marcas de PLC" },
    { value: "4", label: "Plataformas SCADA" },
];

// Ladder diagram geometry, copied verbatim from Hero.astro. The state is driven
// by the script below; IEC-generic addresses on purpose, not tied to one PLC brand.
const R0 = 64; // rung 0
const B0 = 114; // rung 0 seal-in branch
const R1 = 210; // rung 1
const R2 = 300; // rung 2

// `s` is the energization key for the segment; the script resolves it each scan.
const wires = [
    { s: "t", x1: 24, y1: R0, x2: 92, y2: R0 },
    { s: "start", x1: 108, y1: R0, x2: 150, y2: R0 },
    { s: "t", x1: 48, y1: R0, x2: 48, y2: B0 },
    { s: "t", x1: 48, y1: B0, x2: 92, y2: B0 },
    { s: "seal", x1: 108, y1: B0, x2: 150, y2: B0 },
    { s: "seal", x1: 150, y1: B0, x2: 150, y2: R0 },
    { s: "pA", x1: 150, y1: R0, x2: 212, y2: R0 },
    { s: "pB", x1: 228, y1: R0, x2: 312, y2: R0 },
    { s: "pC", x1: 328, y1: R0, x2: 470, y2: R0 },
    { s: "pC", x1: 490, y1: R0, x2: 536, y2: R0 },
    { s: "t", x1: 24, y1: R1, x2: 92, y2: R1 },
    { s: "q1", x1: 108, y1: R1, x2: 212, y2: R1 },
    { s: "q2", x1: 228, y1: R1, x2: 300, y2: R1 },
    { s: "q2", x1: 440, y1: R1, x2: 536, y2: R1 },
    { s: "t", x1: 24, y1: R2, x2: 92, y2: R2 },
    { s: "r1", x1: 108, y1: R2, x2: 212, y2: R2 },
    { s: "r2", x1: 228, y1: R2, x2: 470, y2: R2 },
    { s: "r2", x1: 490, y1: R2, x2: 536, y2: R2 },
];

// `c` is the contact state key: "t" when it passes current.
const contacts = [
    { c: "start", x: 100, y: R0, tag: "PB_ARRANQUE", addr: "%I0.0", nc: false },
    // The seal-in label sits below: above it would collide with PB_ARRANQUE's address.
    { c: "seal", x: 100, y: B0, tag: "MOTOR_M1", addr: "%Q0.0", nc: false, below: true },
    { c: "stop", x: 220, y: R0, tag: "PB_PARO", addr: "%I0.1", nc: true },
    { c: "estop", x: 320, y: R0, tag: "PARO_EMERG_OK", addr: "%I0.2", nc: false },
    { c: "q1", x: 100, y: R1, tag: "MOTOR_M1", addr: "%Q0.0", nc: false },
    { c: "sens", x: 220, y: R1, tag: "SENSOR_PIEZA", addr: "%I0.3", nc: false },
    { c: "dnc", x: 100, y: R2, tag: "T_ESPERA.DN", addr: "", nc: false },
    { c: "fault", x: 220, y: R2, tag: "BANDA_FALLA", addr: "%I0.4", nc: true },
];

const coils = [
    { c: "m1", x: 480, y: R0, tag: "MOTOR_M1", addr: "%Q0.0" },
    { c: "conv", x: 480, y: R2, tag: "BANDA_MARCHA", addr: "%Q0.1" },
];

const rungs = [
    { n: 0, y: R0, text: "Arranque del motor con retención" },
    { n: 1, y: R1, text: "Espera con pieza en posición" },
    { n: 2, y: R2, text: "Marcha de la banda con enclavamiento de falla" },
];

// Server-painted state: everything energized except the start button, already
// released, with the motor held by the seal-in contact.
const initialPower = new Set(["t", "seal", "pA", "pB", "pC", "q1", "q2", "r1", "r2"]);
const initialPass = new Set(["seal", "stop", "estop", "m1", "q1", "sens", "q2", "dnc", "fault", "conv"]);
---

<section
    data-control-hero-panel
    class="hero-section relative overflow-clip"
>
    <!-- Full-bleed hero, not a card: no radius/border/shadow, background spans
         the viewport edge to edge and starts at the very top of the page —
         the fixed navbar floats over it, same as the live Hero.astro. Only
         the content column below (.hero-content) gets nav-clearance padding. -->

    <!-- Background lines drawn once with stroke-dashoffset. -->
    <div class="hero-bg pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <svg viewBox="0 0 1200 640" preserveAspectRatio="xMidYMid slice">
            <path d="M60 580 H420 L470 530 H640"></path>
            <path d="M40 70 H300 L340 30 H560"></path>
            <path d="M600 610 H1180"></path>
            <path d="M620 40 H1180"></path>
        </svg>
    </div>

    <!-- Content column: aligned like the rest of the page (same left inset as
         <Container>), but not wrapped in it — the right side has no padding,
         so the PLC screen can bleed all the way to the viewport's right edge
         (see `.plc-col`'s margin-right). -->
    <div class="hero-content mx-auto w-full max-w-7xl pl-4 sm:pl-8 md:pl-14 lg:pl-5">
        <div class="hero-grid grid items-center gap-6 lg:gap-10">
            <!-- Copy column -->
            <div class="hero-copy grid content-center gap-6 pr-4 sm:pr-8 md:pr-14 lg:pr-5">
                <h1
                    class="text-4xl sm:text-5xl lg:text-[clamp(32px,3.7vw,50px)] font-extrabold leading-tight"
                    data-animate="fade-up"
                    data-animate-delay=".1s"
                >
                    {
                        /* Explicit {" "} because Astro eats the space before an
                           adjacent block-level span; see Hero.astro. */
                    }
                    <span class="block text-[#211915] dark:text-white">Automatización industrial para tu</span
                    >{" "}
                    <span
                        class="block text-transparent bg-clip-text bg-gradient-to-r from-[#001489] via-[#005EB8] to-[#00B5E2] dark:from-[#4da6ff] dark:via-[#00B5E2] dark:to-[#6de0ff]"
                    >
                        línea de producción
                    </span>
                </h1>

                <p
                    class="max-w-xl text-lg leading-relaxed text-gray-600 dark:text-[#9AA6C8]"
                    data-animate="fade-up"
                    data-animate-delay=".2s"
                >
                    Integración de PLC, SCADA e IoT industrial diseñada para
                    maximizar tu eficiencia operativa y reducir tiempos muertos.
                </p>

                <div class="flex flex-wrap gap-4" data-animate="fade-up" data-animate-delay=".3s">
                    <BtnLink
                        href="#contact"
                        text="Solicitar cotización"
                        variant="primary"
                        className="px-8 py-4"
                    />
                    {
                        /* Light theme: the live Hero.astro's normal secondary
                           look (`text-primary` #005EB8, `border-gray-300`).
                           Dark theme: `--primary` is redefined to #00B5E2 via
                           `dark:[--primary:...]` on the outer <a>, which
                           `className` reaches (the `secondary` variant's
                           `text-primary` span itself is not reachable via
                           `className` — see CTAPanel.astro's comment, which
                           still needs the override unconditionally since that
                           panel stays dark in both themes). */
                    }
                    <BtnLink
                        href="#services"
                        text="Ver soluciones"
                        variant="secondary"
                        className="px-8 py-4 border-2 border-gray-300 dark:border-gray-600 dark:[--primary:#00B5E2]"
                    />
                </div>

                <div
                    class="hero-facts grid grid-cols-[repeat(3,auto)] justify-start gap-y-6 border-t pt-5"
                    data-animate="fade-up"
                    data-animate-delay=".4s"
                >
                    {
                        /* Smaller gaps and type at mobile: the auto-sized
                           grid columns don't shrink below their content's
                           own minimum, so at 390px three `pr-5 mr-5`
                           (40px each) gaps plus a 24px value left no room
                           for the "Plataformas SCADA" column and it
                           overflowed the panel. */
                    }
                    {
                        stats.map((stat) => (
                            <div class="hero-fact pr-2 mr-2 sm:pr-5 sm:mr-5">
                                <div class="whitespace-nowrap text-lg sm:text-2xl font-extrabold text-[#211915] dark:text-white">
                                    {stat.value}
                                </div>
                                <div class="text-[9px] sm:text-[10.5px] uppercase tracking-wide sm:tracking-wider text-gray-500 dark:text-[#9AA6C8]">
                                        {stat.label}
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>

                <!-- Visual: online ladder screen, bleeding off the right edge on
                     desktop; contained and horizontally scrollable on mobile. -->
                <div class="plc-col relative" data-animate="slide-left">
                    <!-- SCADA floating card: mirrors the diagram's state -->
                    <div class="float-card absolute z-10 w-48 rounded-xl border border-[#D9DFEA] dark:border-white/10 bg-white dark:bg-[rgb(20,29,51)] p-4 text-[#211915] dark:text-white shadow-xl">
                        <div class="mb-3 flex items-center gap-2">
                            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-br from-[#005EB8] to-[#00B5E2]">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-4 w-4 text-white">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25"></path>
                                </svg>
                            </div>
                            <span class="text-sm font-semibold text-gray-900 dark:text-white">SCADA</span>
                        </div>
                        <div class="space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-gray-500 dark:text-gray-400">Motor 1</span>
                                <span class="led on-g" data-led="m1"></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-gray-500 dark:text-gray-400">Banda</span>
                                <span class="led on-g" data-led="conv"></span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-xs text-gray-500 dark:text-gray-400">Sensor pieza</span>
                                <span class="led on-y" data-led="sens"></span>
                            </div>
                        </div>
                    </div>

                    <div class="plc-screen relative overflow-hidden shadow-2xl">
                        <div class="plc-header flex items-center justify-between gap-2 px-3.5 py-2 font-mono text-[11px]">
                            <span>OB1 · Main · LD</span>
                            <span class="run-badge">EN LÍNEA · RUN</span>
                        </div>

                        <div class="plc-body overflow-x-auto">
                            <svg
                                class="ld"
                                data-ladder
                                viewBox="0 0 576 342"
                                role="img"
                                aria-label="Diagrama escalera: arranque de motor con retención, temporizador TON por sensor de pieza y marcha de la banda"
                            >
                                <g transform="translate(16,0)">
                                    <line class="rail-l" fill="none" x1="24" y1="30" x2="24" y2="322"></line>
                                    <line class="rail-r" fill="none" x1="536" y1="30" x2="536" y2="322"></line>

                                    {
                                        rungs.map((r) => (
                                            <Fragment>
                                                <text class="num" x="4" y={r.y + 4} text-anchor="middle">{r.n}</text>
                                                <text class="cmt" x="34" y={r.y - 40}>{`(* ${r.text} *)`}</text>
                                            </Fragment>
                                        ))
                                    }

                                    {
                                        wires.map((w) => (
                                            <line
                                                class:list={["w", { on: initialPower.has(w.s) }]}
                                                data-s={w.s}
                                                x1={w.x1}
                                                y1={w.y1}
                                                x2={w.x2}
                                                y2={w.y2}
                                            />
                                        ))
                                    }

                                    {
                                        contacts.map((ct) => (
                                            <g data-c={ct.c} class:list={{ t: initialPass.has(ct.c) }}>
                                                <rect class="fill" x={ct.x - 8} y={ct.y - 13} width="16" height="26" />
                                                <line class="bar" fill="none" x1={ct.x - 8} y1={ct.y - 13} x2={ct.x - 8} y2={ct.y + 13} />
                                                <line class="bar" fill="none" x1={ct.x + 8} y1={ct.y - 13} x2={ct.x + 8} y2={ct.y + 13} />
                                                {ct.nc && (
                                                    <line class="bar" fill="none" x1={ct.x - 12} y1={ct.y + 11} x2={ct.x + 12} y2={ct.y - 11} />
                                                )}
                                                <text class="tag" x={ct.x} y={ct.below ? ct.y + 26 : ct.y - 21} text-anchor="middle">{ct.tag}</text>
                                                {ct.addr && (
                                                    <text class="addr" x={ct.x} y={ct.below ? ct.y + 38 : ct.y + 28} text-anchor="middle">{ct.addr}</text>
                                                )}
                                            </g>
                                        ))
                                    }

                                    {
                                        coils.map((cl) => (
                                            <g data-c={cl.c} class:list={{ t: initialPass.has(cl.c) }}>
                                                <ellipse class="fill" cx={cl.x} cy={cl.y} rx="10" ry="12" />
                                                <path class="bar" fill="none" d={`M${cl.x - 5} ${cl.y - 13} Q${cl.x - 15} ${cl.y} ${cl.x - 5} ${cl.y + 13}`} />
                                                <path class="bar" fill="none" d={`M${cl.x + 5} ${cl.y - 13} Q${cl.x + 15} ${cl.y} ${cl.x + 5} ${cl.y + 13}`} />
                                                <text class="tag" x={cl.x} y={cl.y - 21} text-anchor="middle">{cl.tag}</text>
                                                <text class="addr" x={cl.x} y={cl.y + 28} text-anchor="middle">{cl.addr}</text>
                                            </g>
                                        ))
                                    }

                                    <!-- Rung 1 timer (TON) -->
                                    <g data-c="q2" class="t">
                                        <rect class="box" x="300" y={R1 - 30} width="140" height="62" rx="4"></rect>
                                    </g>
                                    <text class="tag" x="370" y={R1 - 38} text-anchor="middle">T_ESPERA</text>
                                    <text class="box-t" x="312" y={R1 - 12}>TON</text>
                                    <text class="box-v" x="312" y={R1 + 8}>PT  T#2s</text>
                                    <text class="box-v" data-et x="312" y={R1 + 23}>ET  T#2.0s</text>
                                    <text class="dn t" data-dn x="430" y={R1 + 8} text-anchor="end">DN</text>
                                </g>
                            </svg>
                        </div>

                        <div class="ld-legend flex justify-end gap-4 px-3.5 py-2 text-[10px] font-mono">
                            <span class="inline-flex items-center gap-1.5"><i class="ld-key ld-key-on"></i>Energizado</span>
                            <span class="inline-flex items-center gap-1.5"><i class="ld-key ld-key-off"></i>Sin flujo</span>
                        </div>
                    </div>

                    <!-- Sensors floating card -->
                    <div class="float-card sens-card absolute z-10 rounded-xl border border-[#D9DFEA] dark:border-white/10 bg-white dark:bg-[rgb(20,29,51)] p-4 text-[#211915] dark:text-white shadow-xl">
                        <div class="flex items-center gap-3">
                            <div class="flex h-10 w-10 items-center justify-center rounded-lg bg-[#00B5E2]/10">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5 text-[#00B5E2]">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z"></path>
                                </svg>
                            </div>
                            <div>
                                <div class="text-sm font-semibold text-gray-900 dark:text-white">12 Sensores</div>
                                <div class="text-xs text-gray-500 dark:text-gray-400">Conectados vía OPC-UA</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

    <!-- Right-edge fade so the bleeding screen dissolves into the section
         background. Anchored to the section itself (full viewport width),
         not `.hero-content` (which is narrower) — the section is what
         actually reaches the edge the screen bleeds to. Desktop only. -->
    <div class="edge-fade pointer-events-none absolute inset-y-0 right-0 z-20" aria-hidden="true"></div>
</section>

<script>
    // Online-mode simulation: each frame evaluates the three rungs as one PLC
    // scan and marks which segments carry current. Sequence: start, part
    // detected, timer counts, conveyor runs, stop. Same logic as Hero.astro.
    const CYCLE_MS = 11000;
    const PRESET_MS = 2000;

    type Inputs = { start: boolean; stop: boolean; estop: boolean; sensor: boolean; fault: boolean };

    function inputsAt(t: number): Inputs {
        return {
            start: t > 600 && t < 1200,
            stop: t > 7600 && t < 8200,
            estop: true,
            sensor: t > 2200 && t < 6600,
            fault: false,
        };
    }

    function runLadder(svg: SVGSVGElement) {
        const wires = svg.querySelectorAll<SVGElement>("[data-s]");
        const parts = svg.querySelectorAll<SVGElement>("[data-c]");
        const et = svg.querySelector<SVGTextElement>("[data-et]");
        const dn = svg.querySelector<SVGTextElement>("[data-dn]");
        // LEDs scoped to this hero so we never touch another `data-led`.
        const leds = (svg.closest("[data-control-hero-panel]") ?? svg).querySelectorAll<HTMLElement>("[data-led]");

        // Same state the server paints, so the first frame doesn't jump.
        let m1 = true;
        let acc = PRESET_MS;

        function scan(i: Inputs, dt: number) {
            // Rung 0 evaluates twice so the seal-in takes its own value.
            let pA = i.start || m1;
            let pB = pA && !i.stop;
            let pC = pB && i.estop;
            m1 = pC;
            pA = i.start || m1;
            pB = pA && !i.stop;
            pC = pB && i.estop;

            const q1 = m1;
            const q2 = q1 && i.sensor;
            acc = q2 ? Math.min(PRESET_MS, acc + dt) : 0;
            const done = acc >= PRESET_MS;
            const r2 = done && !i.fault;

            const power: Record<string, boolean> = { t: true, start: i.start, seal: m1, pA, pB, pC, q1, q2, r1: done, r2 };
            const pass: Record<string, boolean> = {
                start: i.start, seal: m1, stop: !i.stop, estop: i.estop, m1: pC,
                q1, sens: i.sensor, q2, dnc: done, fault: !i.fault, conv: r2,
            };
            wires.forEach((el) => el.classList.toggle("on", !!power[el.dataset.s ?? ""]));
            parts.forEach((el) => el.classList.toggle("t", !!pass[el.dataset.c ?? ""]));
            if (et) et.textContent = `ET  T#${(acc / 1000).toFixed(1)}s`;
            dn?.classList.toggle("t", done);

            const led: Record<string, string> = { m1: m1 ? "on-g" : "", conv: r2 ? "on-g" : "", sens: i.sensor ? "on-y" : "" };
            leds.forEach((el) => {
                el.classList.remove("on-g", "on-y");
                const cls = led[el.dataset.led ?? ""];
                if (cls) el.classList.add(cls);
            });
        }

        // Reduced motion keeps the server-painted energized state.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        // Only runs while the diagram is on screen.
        let clock = 0;
        let last = 0;
        let raf = 0;
        let visible = false;
        // First run holds the server's energized state a moment before
        // restarting the sequence from zero.
        let warmup = true;
        let warmupTimer = 0;

        function frame(now: number) {
            const dt = last ? Math.min(100, now - last) : 0;
            last = now;
            clock = (clock + dt) % CYCLE_MS;
            scan(inputsAt(clock), dt);
            raf = requestAnimationFrame(frame);
        }

        function start() {
            if (raf || !visible) return;
            last = 0;
            raf = requestAnimationFrame(frame);
        }

        function stop() {
            window.clearTimeout(warmupTimer);
            warmupTimer = 0;
            if (raf) cancelAnimationFrame(raf);
            raf = 0;
        }

        new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting;
            if (!visible) return stop();
            if (!warmup) return start();
            if (warmupTimer) return;
            warmupTimer = window.setTimeout(() => {
                warmupTimer = 0;
                warmup = false;
                m1 = false;
                acc = 0;
                start();
            }, 1500);
        }).observe(svg);
    }

    document.querySelectorAll<SVGSVGElement>("[data-ladder]").forEach(runLadder);
</script>

<style>
    /* Theme tokens. Light is the default (no `.dark` ancestor); dark
       overrides via `:global(.dark)`, same pattern as Hero.astro's own
       `.ld-mono` tokens. */
    .hero-section {
        /* `isolation: isolate` makes the section establish its own stacking
           context even though it only has `position: relative` (no z-index):
           without one, the -z-10/-z-20 background layers below stack against
           whatever ancestor DOES establish a context, which could paint them
           behind unrelated content instead of just behind this section's own
           background. */
        isolation: isolate;
        --panel: #ffffff;
        --panel-line: rgba(0, 94, 184, 0.14);
        --bg-line: #005eb8;
        background: radial-gradient(120% 70% at 88% 0%, rgba(0, 181, 226, 0.16) 0%, #eef3fb 45%, #ffffff 100%);
    }
    /* Dark theme: the brand's actual dark identity (measured on /software/'s
       dark hero), not an invented saturated navy. */
    :global(.dark) .hero-section {
        --panel: #10203f;
        --panel-line: rgba(0, 181, 226, 0.18);
        --bg-line: #00b5e2;
        background:
            radial-gradient(60% 80% at 85% 30%, rgba(0, 181, 226, 0.16), transparent 70%),
            radial-gradient(50% 70% at 10% 100%, rgba(0, 94, 184, 0.14), transparent 70%),
            linear-gradient(#0d1731, #10203f);
    }

    /* The PLC screen now has its own light/dark treatment (owner-reversed
       decision — it no longer stays dark in both themes, since a dark screen
       bleeding into a light hero via `.edge-fade` looked like a smear).
       Light: white/blue "engineering IDE" screen, brand blue for energized.
       Dark: the previous always-dark look, unchanged. */
    .plc-screen {
        --energized: #005eb8;
        --dead: #9aa6bf;
        --ld-bg: #f7f9fc;
        --ld-border: #d9dfea;
        --ld-shadow: 0 20px 40px -20px rgba(0, 20, 137, 0.15), 0 0 0 1px rgba(0, 94, 184, 0.05);
        --ld-header-bg: rgba(0, 94, 184, 0.04);
        --ld-header-text: #5b6275;
        --ld-divider: rgba(0, 94, 184, 0.12);
