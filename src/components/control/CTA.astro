---
// /control/ CTA: inset dark card with the phone number visible, using the
// `inverse` + `primary` BtnLink variants. The white quote button delays its
// `hover:bg-[#172554]` by 220ms (third entry of BtnLink's transition list:
// transform, border-color, background-color) so the #172554 circle visibly grows
// first, like the navbar's primary "Contáctanos", and the fill only catches up to
// hide the corner halo. `!` is needed to beat BtnLink's scoped transition rule.
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
---

<section class="relative py-24 overflow-hidden">
    <Container>
        <div class="cta-panel grid items-center gap-6 rounded-[22px] text-white">
            <div>
                <h2
                    class="text-3xl sm:text-4xl lg:text-5xl font-bold leading-tight"
                    data-animate="fade-up"
                    data-animate-delay=".1s"
                >
                    Automatiza tu planta con{" "}
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-[#38bdf8] via-[#00B5E2] to-[#005EB8]"
                    >
                        tecnología probada
                    </span>
                </h2>

                <p
                    class="mt-3 max-w-[54ch] text-base text-[#B8C4E6]"
                    data-animate="fade-up"
                    data-animate-delay=".2s"
                >
                    Agenda una consulta sin costo y descubre cómo podemos optimizar
                    tu operación con soluciones de automatización a tu medida.
                </p>
            </div>

            <div class="cta-side grid justify-items-start gap-4" data-animate="fade-up" data-animate-delay=".3s">
                <div class="flex flex-wrap gap-3">
                    <BtnLink
                        href="#contact"
                        text="Solicitar cotización"
                        variant="inverse"
                        className="px-8 py-4 ![transition-delay:0ms,0ms,220ms]"
                    />
                    <BtnLink
                        href="tel:+528128927509"
                        text="Llamar ahora"
                        variant="primary"
                        className="px-8 py-4"
                    />
                </div>
                <div class="grid gap-0.5">
                    <span class="font-mono text-[10.5px] uppercase tracking-[0.12em] text-[#9fb3e8]">
                        O márcanos directo
                    </span>
                    <b class="select-all font-mono text-[17px] font-semibold">+52 81 2892 7509</b>
                </div>
            </div>
        </div>
    </Container>
</section>

<style>
    .cta-panel {
        /* #001489 is an official brand color, kept; the dark endpoint moves
           to the brand's actual dark-surface family instead of an invented
           navy. */
        background: linear-gradient(120deg, #001489, #10203f 70%);
        padding: clamp(26px, 4vw, 46px);
        grid-template-columns: minmax(0, 1.3fr) auto;
    }
    @media (max-width: 860px) {
        .cta-panel {
            grid-template-columns: 1fr;
        }
    }
</style>
