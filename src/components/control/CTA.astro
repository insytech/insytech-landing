---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
---

<section
    class="relative py-24 bg-gray-50 dark:bg-[#0B1121] overflow-hidden transition-colors duration-300"
>
    <!-- Background pattern -->
    <div class="absolute inset-0">
        <!-- Grid pattern overlay - Subtle & Clean -->
        <div
            class="absolute w-full h-full bg-[linear-gradient(60deg,transparent_25%,rgba(0,181,226,0.03)_25%,rgba(0,181,226,0.03)_50%,transparent_50%)] bg-[length:60px_60px] dark:opacity-10"
        >
        </div>

        <!-- Subtle gradient mask for depth -->
        <div
            class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-gray-50/50 dark:to-[#0B1121]/80"
        >
        </div>
    </div>

    <Container className="relative z-10">
        <div class="max-w-4xl mx-auto text-center">

            <h2
                class="text-3xl sm:text-4xl lg:text-5xl font-bold font-heading text-gray-900 dark:text-white leading-tight mb-6 tracking-tight"
                data-animate="fade-up"
                data-animate-delay=".1s"
            >
                Automatiza tu planta con{" "}
                <span
                    class="text-transparent bg-clip-text bg-gradient-to-r from-[#005EB8] via-[#00B5E2] to-[#4da6ff] dark:from-[#38bdf8] dark:via-[#00B5E2] dark:to-[#005EB8]"
                >
                    tecnología probada
                </span>
            </h2>

            <p
                class="text-xl text-gray-600 dark:text-slate-400 mb-10 max-w-2xl mx-auto"
                data-animate="fade-up"
                data-animate-delay=".2s"
            >
                Agenda una consulta sin costo y descubre cómo podemos optimizar
                tu operación con soluciones de automatización a tu medida.
            </p>

            <!-- CTAs -->
            <div
                class="flex flex-wrap justify-center gap-4"
                data-animate="fade-up"
                data-animate-delay=".3s"
            >
                <BtnLink
                        href="#contact"
                        text="Solicitar cotización"
                        variant="primary"
                        className="px-8 py-4"
                    />
                <BtnLink
                    href="tel:+528128927509"
                    text="Llamar ahora"
                    variant="secondary"
                    className="px-8 py-4 border-2 border-gray-300 dark:border-gray-600"
                />
            </div>
        </div>
    </Container>
</section>
