---
import Container from "../shared/Container.astro";

// Los tres frentes por los que se paga un proyecto de automatización, dichos
// sin porcentaje. Antes había aquí dos cifras de reducción y de ahorro sin
// respaldo: el mecanismo es cierto y se sostiene contra el FAQ, la magnitud
// depende de la línea y no la hemos medido.
const returns = [
    {
        title: "Menos tiempos muertos",
        body: "La detección temprana de fallas evita el paro no planeado, que es donde se va el turno.",
    },
    {
        title: "Calidad consistente",
        body: "Al quitar la variabilidad manual, la pieza sale igual en el primer turno y en el tercero.",
    },
    {
        title: "Visibilidad en tiempo real",
        body: "Decidir sobre lo que está pasando en la línea, no sobre el reporte de ayer.",
    },
];
---

<section class="relative py-24 bg-gray-50 dark:bg-gray-900 overflow-hidden">
    <Container>
        <div class="grid lg:grid-cols-2 gap-16 items-center">
            <!-- Image Side -->
            <div class="relative" data-animate="slide-left">
                <div class="relative rounded-sm overflow-hidden">
                    <!-- Main image -->
                    <div
                        class="aspect-[4/3] bg-gradient-to-br from-[#001489] to-[#005EB8]"
                    >
                        <img
                            src="/images/control/performance.webp"
                            alt="Operador supervisando la línea de producción desde el tablero de control y automatización de una planta industrial"
                            class="w-full h-full object-cover"
                            loading="lazy"
                        />
                    </div>

                    <!-- Overlay accent -->
                    <div
                        class="absolute bottom-0 left-0 right-0 h-2 bg-gradient-to-r from-[#001489] via-[#005EB8] to-[#00B5E2]"
                    >
                    </div>
                </div>

                <!-- Decorative elements -->
                <div
                    class="absolute -bottom-6 -right-6 w-32 h-32 border-4 border-[#005EB8]/20 rounded-sm -z-10"
                >
                </div>
                <div
                    class="absolute -top-6 -left-6 w-24 h-24 bg-[#00B5E2]/10 rounded-sm -z-10"
                >
                </div>

            </div>

            <!-- Content Side -->
            <div data-animate="fade-up">

                <h2
                    class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#211915] dark:text-white leading-tight mb-6"
                >
                    Resultados de automatizar{" "}
                    <span
                        class="text-transparent bg-clip-text bg-gradient-to-r from-[#001489] via-[#005EB8] to-[#00B5E2] dark:from-[#4da6ff] dark:via-[#00B5E2] dark:to-[#6de0ff]"
                    >
                        el control de procesos
                    </span>
                </h2>

                <p
                    class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed mb-8"
                >
                    Automatizar el control no es comprar un tablero: es que la
                    línea deje de depender de que alguien se dé cuenta. El
                    retorno viene de tres frentes, y todo se integra con nuestros
                    sistemas de <a
                        href="/tracking/"
                        class="font-medium text-[#005EB8] dark:text-[#00B5E2] underline underline-offset-2 hover:opacity-80 transition-opacity"
                        >trazabilidad y monitoreo</a
                    > y de <a
                        href="/vision/"
                        class="font-medium text-[#005EB8] dark:text-[#00B5E2] underline underline-offset-2 hover:opacity-80 transition-opacity"
                        >visión con inteligencia artificial</a
                    >.
                </p>

                <!-- De dónde viene el retorno -->
                <div class="grid sm:grid-cols-3 gap-4 mb-8">
                    {
                        returns.map((item) => (
                            <div class="p-4 bg-white dark:bg-gray-800 rounded-sm border border-gray-100 dark:border-gray-700">
                                <div class="font-bold text-[#211915] dark:text-white mb-1">
                                    {item.title}
                                </div>
                                <div class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                                    {item.body}
                                </div>
                            </div>
                        ))
                    }
                </div>

                <!-- Features list -->
                <ul class="space-y-3 mb-8">
                    <li
                        class="flex items-center gap-3 text-gray-700 dark:text-gray-300"
                    >
                        <div
                            class="w-6 h-6 rounded-sm bg-[#00B5E2]/10 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-4 h-4 text-[#00B5E2]"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M4.5 12.75l6 6 9-13.5"></path>
                            </svg>
                        </div>
                        <span>Diagnóstico remoto 24/7</span>
                    </li>
                    <li
                        class="flex items-center gap-3 text-gray-700 dark:text-gray-300"
                    >
                        <div
                            class="w-6 h-6 rounded-sm bg-[#00B5E2]/10 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-4 h-4 text-[#00B5E2]"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M4.5 12.75l6 6 9-13.5"></path>
                            </svg>
                        </div>
                        <span>Integración con sistemas existentes</span>
                    </li>
                    <li
                        class="flex items-center gap-3 text-gray-700 dark:text-gray-300"
                    >
                        <div
                            class="w-6 h-6 rounded-sm bg-[#00B5E2]/10 flex items-center justify-center flex-shrink-0"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                fill="none"
                                viewBox="0 0 24 24"
                                stroke-width="2"
                                stroke="currentColor"
                                class="w-4 h-4 text-[#00B5E2]"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M4.5 12.75l6 6 9-13.5"></path>
                            </svg>
                        </div>
                        <span>Capacitación completa de operadores</span>
                    </li>
                </ul>

                <a
                    href="#contact"
                    class="inline-flex items-center gap-3 px-8 py-4 bg-[#005EB8] text-white font-semibold rounded-sm hover:bg-[#001489] transition-colors group"
                >
                    <span>Conocer más</span>
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                        stroke="currentColor"
                        class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
                    </svg>
                </a>
            </div>
        </div>
    </Container>
</section>
