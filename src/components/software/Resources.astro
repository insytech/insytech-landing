---
import RelatedPosts from "../shared/RelatedPosts.astro";
import type { RelatedPost } from "../shared/RelatedPosts.astro";
import { HEADING, PAD, SURFACE } from "@utils/typography";

// Canibalización medida (GSC, 28 días a 2026-08-28): para «software industrial»
// el post /blog/desarrollo-software-industrial-a-la-medida/ sale en la posición 8
// y esta página en la 32, y Google sirve las dos. Enlazarlo desde aquí agrupa el
// tema en vez de repartirlo. Los otros tres cubren las consultas vecinas.
// El cluster completo son ~11 impresiones en 28 días, así que no justifica
// consolidar ni redirigir: se deja enlazado y se mide.
const posts: readonly RelatedPost[] = [
    {
        title: "Desarrollo de software a la medida para la industria",
        summary:
            "Qué pedir, qué exigir y cómo se ve un primer proyecto bien planteado.",
        href: "/blog/desarrollo-software-industrial-a-la-medida/",
    },
    {
        title: "Trazabilidad industrial y sistemas MES",
        summary:
            "Qué resuelve un MES en piso de planta y qué necesita de su ERP.",
        href: "/blog/trazabilidad-sistemas-mes-planta/",
    },
    {
        title: "Inteligencia artificial en la industria",
        summary: "Casos reales de IA en manufactura, sin promesas de folleto.",
        href: "/blog/inteligencia-artificial-industria-manufactura/",
    },
    {
        title: "Cómo elegir un proveedor de automatización inteligente",
        summary: "Diez preguntas que separan a un integrador de un vendedor.",
        href: "/blog/como-elegir-proveedor-automatizacion-inteligente/",
    },
];
---

<RelatedPosts
    posts={posts}
    heading="Antes de contratar un desarrollo, léete esto"
    intro="Escribimos sobre lo que nos preguntan en las juntas. Sin vender."
    class={`${PAD.minor} ${SURFACE.base}`}
    headingClass={HEADING.minor}
/>
