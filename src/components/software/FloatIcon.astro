---
// Small stroke icons for the floating notification cards on device mockups.
// Centralizes the icon set so no glyph/emoji ever ends up in the markup.
type IconName =
    | "check"
    | "refresh"
    | "role"
    | "arrow-right"
    | "arrow-up-right"
    | "sync"
    | "bell"
    | "cart"
    | "card"
    | "checklist";

interface Props {
    name: IconName;
    class?: string;
}

const { name, class: className = "" } = Astro.props;
---

{
    name === "check" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M20 6 9 17l-5-5" />
        </svg>
    )
}
{
    name === "checklist" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <rect x="4" y="3" width="16" height="18" rx="2" />
            <path d="M8 9h8M8 13h5M9.5 17l1.5 1.5L14 15" />
        </svg>
    )
}
{
    name === "refresh" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M21 12a9 9 0 1 1-3-6.7" />
            <path d="M21 4v5h-5" />
        </svg>
    )
}
{
    name === "role" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <rect x="6.5" y="6.5" width="11" height="11" rx="2" transform="rotate(45 12 12)" />
        </svg>
    )
}
{
    name === "arrow-right" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
    )
}
{
    name === "arrow-up-right" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M7 17 17 7M8 7h9v9" />
        </svg>
    )
}
{
    name === "sync" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M7 4v9M7 4 3.5 7.5M7 4l3.5 3.5" />
            <path d="M17 20v-9M17 20l-3.5-3.5M17 20l3.5-3.5" />
        </svg>
    )
}
{
    name === "bell" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.73 21a2 2 0 0 1-3.46 0" />
        </svg>
    )
}
{
    name === "cart" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <path d="M3 4h2l2.4 11h11L21 7H6.2" />
            <circle cx="9" cy="20" r="1.4" />
            <circle cx="18" cy="20" r="1.4" />
        </svg>
    )
}
{
    name === "card" && (
        <svg
            class={className}
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
        >
            <rect x="2" y="5" width="20" height="14" rx="3" />
            <path d="M2 10h20" />
        </svg>
    )
}
