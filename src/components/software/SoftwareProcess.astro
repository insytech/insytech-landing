---
import Container from "../shared/Container.astro";
import { HEADING, PAD, SURFACE } from "@utils/typography";

// Los plazos salen del cronograma real de un proyecto pequeño de cuatro módulos
// (cotización S01076): 10 semanas de arranque a entrega, más 10 días hábiles de
// pruebas del cliente. Los bloques funcionales corren de 15 a 20 días hábiles
// cada uno y las tareas internas en tramos de 5 o 10 días. Son aproximados a
// propósito y así se dicen en la página: es un rango observado en un proyecto,
// no un compromiso contractual.
//
// El paso 01 va SIN plazo deliberadamente. El cronograma arranca ya con los
// requerimientos definidos, así que no hay ni un dato sobre cuánto dura el
// levantamiento; ponerle semanas sería inventarlo.
const steps = [
    {
        number: "01",
        title: "Análisis y Descubrimiento",
        duration: null,
        description:
            "Entendemos sus procesos actuales, identificamos cuellos de botella y definimos los requerimientos técnicos y funcionales del proyecto.",
    },
    {
        number: "02",
        title: "Arquitectura y entorno en pie",
        duration: "Semanas 1-2",
        description:
            "Servidor, base de datos, certificados y despliegue continuo funcionando, más el control de accesos por rol. Al cerrar la segunda semana ya hay una plataforma donde entrar.",
    },
    {
        number: "03",
        title: "Desarrollo por bloques funcionales",
        duration: "3 a 4 semanas por bloque",
        description:
            "Cada bloque se entrega funcionando y se valida antes de abrir el siguiente. Los bloques se traslapan, así que su equipo ve avance útil cada quincena y no un único entregable al final.",
    },
    {
        number: "04",
        title: "Puesta en marcha y pruebas",
        duration: "1 semana por bloque, más 2 de pruebas suyas",
        description:
            "Cada bloque cierra con una semana de pruebas de integración y ajuste en sitio. Tras la entrega quedan dos semanas para que su gente pruebe el sistema con producción real.",
    },
];
---

<section id="process" class={`relative overflow-clip ${PAD.section} ${SURFACE.raised}`}>
    <!-- Decorative elements -->
    <div
        class="absolute top-0 right-0 w-1/3 h-full bg-[#005EB8]/5 skew-x-12 transform origin-top pointer-events-none"
    >
    </div>

    <Container className="relative z-10">
        <div class="grid lg:grid-cols-2 gap-20 items-center">
            <div>
                <p
                    class="text-xs font-mono text-[#005EB8] dark:text-blue-400 uppercase tracking-[0.3em] mb-4"
                >
                    Metodología
                </p>
                <h2 data-reveal="heading" class={`${HEADING.section} mb-8`}>
                    Cómo desarrollamos software a la medida por industria
                </h2>
                <p class="text-lg text-gray-600 dark:text-gray-400 mb-6">
                    Nuestra metodología combina las mejores prácticas de
                    ingeniería de software con un profundo conocimiento del
                    entorno industrial, asegurando soluciones robustas, seguras
                    y fáciles de usar.
                </p>
                <p class="text-lg text-gray-600 dark:text-gray-400 mb-10">
                    Como referencia: un sistema pequeño de cuatro módulos nos
                    tomó <strong class="font-semibold text-[#211915] dark:text-white"
                        >10 semanas</strong
                    > del arranque a la entrega, más dos semanas de pruebas del
                    cliente. Los plazos de abajo son aproximados y salen de ese
                    proyecto: el suyo se estima sobre su alcance.
                </p>

                <div class="space-y-4">
                    <div
                        class="flex items-center gap-4 p-4 rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 shadow-sm"
                    >
                        <div
                            class="w-10 h-10 rounded-full bg-green-500/10 flex items-center justify-center text-green-500"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><polyline points="20 6 9 17 4 12"
                                ></polyline></svg
                            >
                        </div>
                        <span
                            class="font-semibold text-[#211915] dark:text-white"
                            >Seguridad de Datos de Grado Industrial</span
                        >
                    </div>
                    <div
                        class="flex items-center gap-4 p-4 rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 shadow-sm"
                    >
                        <div
                            class="w-10 h-10 rounded-full bg-blue-500/10 flex items-center justify-center text-blue-500"
                        >
                            <svg
                                xmlns="http://www.w3.org/2000/svg"
                                width="20"
                                height="20"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                ><polyline points="20 6 9 17 4 12"
                                ></polyline></svg
                            >
                        </div>
                        <span
                            class="font-semibold text-[#211915] dark:text-white"
                            >Arquitecturas Escalables en la Nube o Local</span
                        >
                    </div>
                </div>
            </div>

            <div class="grid gap-6" data-reveal="group">
                {
                    steps.map((step) => (
                        <div class="relative p-6 rounded-2xl bg-white dark:bg-gray-900 border border-gray-100 dark:border-gray-800 shadow-sm hover:shadow-md transition-shadow group overflow-hidden">
                            <div class="absolute -right-4 -top-8 text-8xl font-bold text-gray-50 dark:text-gray-800/50 group-hover:text-blue-50 dark:group-hover:text-blue-900/20 transition-colors pointer-events-none italic">
                                {step.number}
                            </div>
                            <div class="relative z-10">
                                {step.duration && (
                                    <p class="text-xs font-mono text-[#005EB8] dark:text-blue-400 uppercase tracking-widest mb-2">
                                        {step.duration}
                                    </p>
                                )}
                                <h3 class="text-xl font-bold text-[#211915] dark:text-white mb-2">
                                    {step.title}
                                </h3>
                                <p class="text-gray-600 dark:text-gray-400">
                                    {step.description}
                                </p>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </Container>
</section>
