---
// Dark methodology panel with a blurred cyan light arc, ported from the
// approved mockup. Each step is a single `.proc-row` element — title and
// description live in a plain `.proc-row-body` block, never nested inside the
// same grid cell as the row itself (that's the bug the earlier mockup had).
const steps = [
    {
        number: "01",
        title: "Descubrimiento",
        description: "Alcance y requerimientos por escrito.",
        active: true,
    },
    {
        number: "02",
        title: "Diseño y arquitectura",
        description: "Pantallas, flujo y base técnica.",
        active: false,
    },
    {
        number: "03",
        title: "Desarrollo por bloques",
        description: "Cada bloque se valida con usted.",
        active: false,
    },
    {
        number: "04",
        title: "Publicación y mantenimiento",
        description: "A producción o a las tiendas de apps.",
        active: false,
    },
] as const;
---

<div class="mx-2 mt-28">
    <section class="proc relative overflow-clip rounded-[28px] sm:rounded-[44px]">
        <div class="proc-arc" aria-hidden="true"></div>
        <div class="relative grid gap-10 lg:grid-cols-2 items-center px-6 sm:px-10 lg:px-14 py-12 sm:py-14 lg:py-18">
            <div>
                <p class="proc-eyebrow" data-animate="fade-up">Cómo trabajamos</p>
                <h2
                    class="proc-h2 mt-4 mb-5 text-4xl sm:text-5xl lg:text-6xl"
                    data-reveal="heading"
                >
                    No adapte su negocio a una plantilla
                </h2>
                <p
                    class="proc-body mb-7 max-w-[30rem]"
                    data-animate="fade-up"
                    data-animate-delay="0.1s"
                >
                    Entregas por bloques que usted prueba antes de abrir el
                    siguiente. Siempre sabe qué está funcionando y qué
                    falta.
                </p>
                <a
                    href="#contact"
                    class="proc-cta"
                    data-animate="fade-up"
                    data-animate-delay="0.15s"
                >
                    Cotizar mi proyecto
                </a>
            </div>

            <div class="proc-flow" data-reveal="group">
                {
                    steps.map((step) => (
                        <div class:list={["proc-row", { "proc-row-on": step.active }]}>
                            <span class="proc-n">{step.number}</span>
                            <div class="proc-row-body">
                                <b>{step.title}</b>
                                <small>{step.description}</small>
                            </div>
                        </div>
                    ))
                }
            </div>
        </div>
    </section>
</div>

<style>
    .proc {
        background: #0b1228;
        color: #f4f7fc;
    }
    .proc-arc {
        position: absolute;
        inset: -40% -10% auto 30%;
        height: 90%;
        border-radius: 50%;
        border: 36px solid transparent;
        border-top-color: rgba(0, 181, 226, 0.55);
        filter: blur(28px);
        transform: rotate(-8deg);
        pointer-events: none;
    }

    .proc-eyebrow {
        display: flex;
        gap: 8px;
        align-items: center;
        font-weight: 800;
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #6dd6f5;
    }

    .proc-h2 {
        position: relative;
        font-family: "FieldworkGeo", "Raleway", sans-serif;
        font-weight: 900;
        letter-spacing: -0.02em;
        /* data-reveal masks each line in an overflow box; tighter than
           1.15 clips the FieldworkGeo descenders (g, p). */
        line-height: 1.15;
        text-wrap: balance;
    }

    .proc-body {
        position: relative;
        color: #b7c1d6;
    }

    .proc-cta {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: "Raleway", sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 14px 24px;
        border-radius: 12px;
        text-decoration: none;
        background: #fff;
        color: #0d1530;
    }
    .proc-cta:focus-visible {
        outline: 2px solid #00b5e2;
        outline-offset: 3px;
    }

    .proc-flow {
        position: relative;
        display: grid;
        gap: 10px;
    }

    .proc-row {
        display: grid;
        grid-template-columns: 44px 1fr;
        gap: 14px;
        align-items: center;
        padding: 14px 16px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.08);
    }
    .proc-row-on {
        background: rgba(0, 181, 226, 0.12);
        border-color: rgba(0, 181, 226, 0.4);
    }

    .proc-n {
        font-family: "IBM Plex Mono", ui-monospace, monospace;
        font-size: 0.8rem;
        color: #6dd6f5;
        width: 44px;
        height: 44px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        background: rgba(0, 181, 226, 0.12);
    }

    .proc-row-body {
        display: block;
        min-width: 0;
    }
    .proc-row-body b {
        display: block;
        font-size: 1rem;
    }
    .proc-row-body small {
        display: block;
        color: #9aa6bf;
        font-size: 0.82rem;
    }
</style>
