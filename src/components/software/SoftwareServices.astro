---
// Folder-tab services section, ported from the approved grassfeld-inspired
// mockup (odd/tasks/software-repositioning.md, T4). Five panes (E-commerce,
// Aplicaciones web, Landing pages, Escritorio, Apps móviles), each with a
// device mockup and floating cards, plus a 7s autoplay that stops on any user
// interaction and a pointer-parallax effect on the device stage.
import BrowserFrame from "./BrowserFrame.astro";
import DesktopFrame from "./DesktopFrame.astro";
import PhoneFrame from "./PhoneFrame.astro";
import FloatIcon from "./FloatIcon.astro";
import IntegrationHighlights from "./IntegrationHighlights.astro";

const tabs = [
    {
        id: "ecom",
        label: "E-commerce",
        icon: `<path d="M3 4h2l2.4 11h11L21 7H6.2"/><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/>`,
    },
    {
        id: "web",
        label: "Aplicaciones web",
        icon: `<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/>`,
    },
    {
        id: "lp",
        label: "Landing pages",
        icon: `<path d="M4 5h16v6H4zM4 15h7v4H4zM14 15h6v4h-6z"/>`,
    },
    {
        id: "desk",
        label: "Escritorio",
        icon: `<rect x="2" y="4" width="20" height="13" rx="2"/><path d="M8 21h8M12 17v4"/>`,
    },
    {
        id: "mob",
        label: "Apps móviles",
        icon: `<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>`,
    },
] as const;

const productTints = [
    "linear-gradient(135deg,#cfe6fb,#7fb7ec)",
    "linear-gradient(135deg,#c9f1fb,#5fd3ef)",
    "linear-gradient(135deg,#d3e9fa,#5aa7e6)",
    "linear-gradient(135deg,#dff0fb,#9cd6f2)",
] as const;
---

<section id="solutions" class="svc relative overflow-clip pt-24 pb-10 lg:pt-32" data-software-services>
    <div class="svc-head mx-auto max-w-3xl px-4 text-center">
        <h2 class="svc-h2 text-4xl md:text-5xl lg:text-6xl" data-reveal="heading">
            Un equipo para todo el software de su empresa
        </h2>
        <p class="mt-5 max-w-xl mx-auto text-lg text-[#4a5566] dark:text-gray-400">
            Diseñamos, programamos, publicamos y le damos mantenimiento.
            Cada proyecto arranca de lo que su negocio necesita resolver,
            no de una plantilla.
        </p>
    </div>

    <div
        class="svc-tabs svc-tabs-auto mt-9 flex justify-center gap-1 flex-wrap px-4"
        role="tablist"
        aria-label="Servicios"
        data-tablist
    >
        {
            tabs.map((tab, index) => (
                <button
                    type="button"
                    class="svc-tab"
                    role="tab"
                    id={`t-${tab.id}`}
                    aria-controls={`p-${tab.id}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    tabindex={index === 0 ? 0 : -1}
                    data-tab
                >
                    <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                        set:html={tab.icon}
                    />
                    {tab.label}
                    <span class="svc-prog" aria-hidden="true" data-prog />
                </button>
            ))
        }
    </div>

    <div class="px-2">
        <div class="svc-tabwrap" data-tabwrap>
            <!-- E-commerce -->
            <div class="svc-pane" role="tabpanel" id="p-ecom" aria-labelledby="t-ecom" data-pane>
                <div class="svc-pane-txt">
                    <span class="svc-pane-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 4h2l2.4 11h11L21 7H6.2"></path>
                            <circle cx="9" cy="20" r="1.4"></circle>
                            <circle cx="18" cy="20" r="1.4"></circle>
                        </svg>
                    </span>
                    <h3>Tiendas en línea propias</h3>
                    <p>
                        Tiendas propias con catálogo, carrito, pagos en
                        línea y panel para administrar pedidos e
                        inventario.
                    </p>
                    <ul class="svc-feats">
                        <li>Pasarelas de pago</li>
                        <li>Envíos</li>
                        <li>Facturación o ERP</li>
                        <li>Panel de pedidos</li>
                    </ul>
                    <div>
                        <a href="#contact" class="svc-cta">Cotizar mi tienda</a>
                    </div>
                </div>
                <div class="svc-pane-vis" data-pane-vis>
                    <BrowserFrame url="tienda.suempresa.mx">
                        <div class="svc-shop-nav">
                            Su marca
                            <span><em>Catálogo</em><em>Ofertas</em><em>Carrito · 2</em></span>
                        </div>
                        <div class="svc-shop-hero">
                            <div>
                                <small>Temporada nueva</small>
                                <b>Todo el catálogo, a un clic</b>
                            </div>
                            <span class="svc-pill-w">Comprar</span>
                        </div>
                        <div class="svc-grid4">
                            {
                                productTints.map((tint) => (
                                    <div class="svc-prod">
                                        <div class="svc-prod-ph" style={{ background: tint }} />
                                        <div class="svc-prod-l" />
                                        <div class="svc-prod-l svc-prod-l-s" />
                                    </div>
                                ))
                            }
                        </div>
                    </BrowserFrame>
                    <div class="svc-float svc-float-r">
                        <span class="svc-float-ic"><FloatIcon name="check" class="w-[18px] h-[18px]" /></span>
                        <div><b>Pedido confirmado</b><small>#1042 · correo enviado al cliente</small></div>
                    </div>
                    <div class="svc-float svc-float-l">
                        <span class="svc-float-ic svc-float-ic-blue"><FloatIcon name="refresh" class="w-[18px] h-[18px]" /></span>
                        <div><b>Inventario actualizado</b><small>Sincronizado con su ERP</small></div>
                    </div>
                </div>
            </div>

            <!-- Web apps -->
            <div class="svc-pane" role="tabpanel" id="p-web" aria-labelledby="t-web" data-pane hidden>
                <div class="svc-pane-txt">
                    <span class="svc-pane-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                            <path d="M3 9h18M8 14h4"></path>
                        </svg>
                    </span>
                    <h3>Sistemas web para operar su empresa</h3>
                    <p>
                        Portales de clientes, sistemas internos y
                        plataformas con usuarios, roles y reportes, que se
                        usan desde cualquier navegador.
                    </p>
                    <ul class="svc-feats">
                        <li>Accesos por rol</li>
                        <li>Reportes</li>
                        <li>Integración por API</li>
                        <li>Nube o servidor propio</li>
                    </ul>
                    <div>
                        <a href="#contact" class="svc-cta">Cotizar mi sistema</a>
                    </div>
                </div>
                <div class="svc-pane-vis" data-pane-vis>
                    <BrowserFrame url="portal.suempresa.mx">
                        <div class="svc-shop-nav">
                            Portal de clientes
                            <span><em>Solicitudes</em><em>Reportes</em><em>Usuarios</em></span>
                        </div>
                        <div class="svc-kpis">
                            <div><small>Solicitudes abiertas</small><i style="width:70%"></i></div>
                            <div><small>En revisión</small><i style="width:45%"></i></div>
                            <div><small>Resueltas</small><i style="width:85%"></i></div>
                        </div>
                        <div class="svc-table">
                            <div><span>Cliente</span><span>Rol</span><span>Estado</span></div>
                            <div><span>Comercial del Norte</span><span>Administrador</span><span class="svc-tag">Activo</span></div>
                            <div><span>Distribuidora Sur</span><span>Consulta</span><span class="svc-tag svc-tag-c">Invitado</span></div>
                            <div><span>Grupo Regio</span><span>Compras</span><span class="svc-tag">Activo</span></div>
                        </div>
                    </BrowserFrame>
                    <div class="svc-float svc-float-r">
                        <span class="svc-float-ic"><FloatIcon name="role" class="w-[16px] h-[16px]" /></span>
                        <div><b>Rol: Supervisor</b><small>Ve reportes, no edita precios</small></div>
                    </div>
                </div>
            </div>

            <!-- Landing -->
            <div class="svc-pane" role="tabpanel" id="p-lp" aria-labelledby="t-lp" data-pane hidden>
                <div class="svc-pane-txt">
                    <span class="svc-pane-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M4 5h16v6H4zM4 15h7v4H4zM14 15h6v4h-6z"></path>
                        </svg>
                    </span>
                    <h3>Landing pages para sus campañas</h3>
                    <p>
                        Páginas de campaña y sitios corporativos rápidos,
                        optimizados para buscadores y con formularios
                        conectados a su CRM.
                    </p>
                    <ul class="svc-feats">
                        <li>SEO técnico</li>
                        <li>Medición de conversiones</li>
                        <li>Formularios a su CRM</li>
                        <li>Carga rápida</li>
                    </ul>
                    <div>
                        <a href="#contact" class="svc-cta">Cotizar mi landing</a>
                    </div>
                </div>
                <div class="svc-pane-vis" data-pane-vis>
                    <BrowserFrame url="suempresa.mx/campana">
                        <div class="svc-lp">
                            <b>Su propuesta de valor, en una línea</b>
                            <span class="svc-lp-l"></span>
                            <span class="svc-lp-l svc-lp-l-s"></span>
                            <span class="svc-lp-cta">Solicitar información</span>
                        </div>
                        <div class="svc-lp-form"><span></span><span></span><span></span></div>
                    </BrowserFrame>
                    <div class="svc-float svc-float-r">
                        <span class="svc-float-ic"><FloatIcon name="arrow-right" class="w-[18px] h-[18px]" /></span>
                        <div><b>Nuevo prospecto</b><small>Enviado a su CRM</small></div>
                    </div>
                    <div class="svc-float svc-float-l">
                        <span class="svc-float-ic svc-float-ic-blue"><FloatIcon name="arrow-up-right" class="w-[18px] h-[18px]" /></span>
                        <div><b>Conversión registrada</b><small>Campaña de otoño</small></div>
                    </div>
                </div>
            </div>

            <!-- Desktop -->
            <div class="svc-pane" role="tabpanel" id="p-desk" aria-labelledby="t-desk" data-pane hidden>
                <div class="svc-pane-txt">
                    <span class="svc-pane-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="13" rx="2"></rect>
                            <path d="M8 21h8M12 17v4"></path>
                        </svg>
                    </span>
                    <h3>Aplicaciones de escritorio para trabajo intensivo</h3>
                    <p>
                        Software que se instala en las computadoras de su
                        equipo, para trabajo intensivo, con archivos
                        locales o sin depender de internet.
                    </p>
                    <ul class="svc-feats">
                        <li>Sin conexión</li>
                        <li>Sincroniza después</li>
                        <li>Archivos locales</li>
                        <li>Actualizaciones controladas</li>
                    </ul>
                    <div>
                        <a href="#contact" class="svc-cta">Cotizar mi aplicación</a>
                    </div>
                </div>
                <div class="svc-pane-vis" data-pane-vis>
                    <DesktopFrame title="Inventario — Almacén central">
                        <Fragment slot="sidebar">
                            <span class="svc-side-on">Existencias</span>
                            <span>Entradas</span>
                            <span>Salidas</span>
                            <span>Reportes</span>
                        </Fragment>
                        <div class="svc-tools"><span></span><span></span><span></span></div>
                        <div class="svc-table">
                            <div><span>Artículo</span><span>Ubicación</span><span>Estado</span></div>
                            <div><span>Caja de cartón M</span><span>Pasillo 4</span><span class="svc-tag">Disponible</span></div>
                            <div><span>Cinta de embalaje</span><span>Pasillo 2</span><span class="svc-tag svc-tag-c">Por surtir</span></div>
                            <div><span>Etiqueta térmica</span><span>Pasillo 7</span><span class="svc-tag">Disponible</span></div>
                        </div>
                    </DesktopFrame>
                    <div class="svc-float svc-float-r">
                        <span class="svc-float-ic"><FloatIcon name="sync" class="w-[18px] h-[18px]" /></span>
                        <div><b>Sin conexión</b><small>Los cambios se sincronizan al volver</small></div>
                    </div>
                </div>
            </div>

            <!-- Mobile -->
            <div class="svc-pane" role="tabpanel" id="p-mob" aria-labelledby="t-mob" data-pane hidden>
                <div class="svc-pane-txt">
                    <span class="svc-pane-ic">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="7" y="2" width="10" height="20" rx="2"></rect>
                            <path d="M11 18h2"></path>
                        </svg>
                    </span>
                    <h3>Apps móviles para sus clientes o su equipo</h3>
                    <p>
                        Aplicaciones para iOS y Android para sus clientes o
                        para su equipo en campo, conectadas al mismo
                        sistema que el resto de su operación.
                    </p>
                    <ul class="svc-feats">
                        <li>iOS y Android</li>
                        <li>Notificaciones</li>
                        <li>Modo sin conexión</li>
                        <li>Publicación en tiendas</li>
                    </ul>
                    <div>
                        <a href="#contact" class="svc-cta">Cotizar mi app</a>
                    </div>
                </div>
                <div class="svc-pane-vis" data-pane-vis>
                    <PhoneFrame class="svc-phone-crop">
                        <div class="svc-phone-screen">
                            <div class="svc-phone-top">
                                <div><small>Ruta de hoy</small><b>6 visitas</b></div>
                                <span class="svc-avatar"></span>
                            </div>
                            <div class="svc-hero-card">
                                <small>Siguiente visita</small>
                                <b>Comercial del Norte · 11:30</b>
                            </div>
                            <div class="svc-steps">
                                <div class="svc-step svc-step-ok"><span></span>Distribuidora Sur</div>
                                <div class="svc-step svc-step-now"><span></span>Comercial del Norte</div>
                                <div class="svc-step"><span></span>Grupo Regio</div>
                            </div>
                        </div>
                    </PhoneFrame>
                    <div class="svc-float svc-float-rt">
                        <span class="svc-float-ic"><FloatIcon name="bell" class="w-[18px] h-[18px]" /></span>
                        <div><b>Nueva orden asignada</b><small>Hace un momento</small></div>
                    </div>
                    <div class="svc-float svc-float-l">
                        <span class="svc-float-ic svc-float-ic-blue"><FloatIcon name="check" class="w-[18px] h-[18px]" /></span>
                        <div><b>Visita registrada</b><small>Se sube al tener señal</small></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <IntegrationHighlights />
</section>

<script>
    // Accessible folder tabs with a 7s autoplay that stops on any user
    // interaction, and a pointer-parallax effect on each device stage.
    // Scoped to [data-software-services] so it never touches another
    // tablist on the page.
    (function () {
        const root = document.querySelector("[data-software-services]");
        if (!root) return;

        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        const tablistEl = root.querySelector<HTMLElement>("[data-tablist]");
        const tabwrapEl = root.querySelector<HTMLElement>("[data-tabwrap]");
        const tabs = Array.from(
            root.querySelectorAll<HTMLButtonElement>("[data-tab]"),
        );
        if (!tablistEl || !tabwrapEl || tabs.length === 0) return;
        // Re-bind as non-nullable consts: TS doesn't carry the null check
        // above into the nested function declarations below.
        const tablist = tablistEl;
        const tabwrap = tabwrapEl;

        function select(target: HTMLButtonElement) {
            tabs.forEach((tab) => {
                const on = tab === target;
                tab.setAttribute("aria-selected", String(on));
                tab.tabIndex = on ? 0 : -1;
                const pane = document.getElementById(
                    tab.getAttribute("aria-controls") ?? "",
                );
                if (!pane) return;
                pane.hidden = !on;
                pane.classList.remove("svc-pane-enter");
                if (on && !reduce) {
                    // Force reflow so the enter animation replays.
                    void pane.offsetWidth;
                    pane.classList.add("svc-pane-enter");
                }
            });
        }

        function stopAuto() {
            tablist.classList.remove("svc-tabs-auto");
        }
        if (reduce) stopAuto();

        tablist.addEventListener("animationend", (event) => {
            if (
                !tablist.classList.contains("svc-tabs-auto") ||
                !(event.target as HTMLElement).classList.contains(
                    "svc-prog",
                )
            ) {
                return;
            }
            const currentIndex = tabs.findIndex(
                (tab) => tab.getAttribute("aria-selected") === "true",
            );
            select(tabs[(currentIndex + 1) % tabs.length]);
        });

        function pause(on: boolean) {
            tablist.classList.toggle("svc-tabs-paused", on);
        }
        [tablist, tabwrap].forEach((el) => {
            el.addEventListener("pointerenter", () => pause(true));
            el.addEventListener("pointerleave", () => pause(false));
        });

        if ("IntersectionObserver" in window) {
            new IntersectionObserver(
                (entries) => pause(!entries[0].isIntersecting),
                { threshold: 0.35 },
            ).observe(tabwrap);
        }

        if (!reduce) {
            root.querySelectorAll<HTMLElement>("[data-pane-vis]").forEach(
                (vis) => {
                    vis.addEventListener("pointermove", (event) => {
                        const rect = vis.getBoundingClientRect();
                        const px = (
                            (event.clientX - rect.left) / rect.width -
                            0.5
                        ).toFixed(3);
                        const py = (
                            (event.clientY - rect.top) / rect.height -
                            0.5
                        ).toFixed(3);
                        vis.style.setProperty("--px", px);
                        vis.style.setProperty("--py", py);
                    });
                    vis.addEventListener("pointerleave", () => {
                        vis.style.setProperty("--px", "0");
                        vis.style.setProperty("--py", "0");
                    });
                },
            );
        }

        tabs.forEach((tab, index) => {
            tab.addEventListener("click", () => {
                stopAuto();
                select(tab);
            });
            tab.addEventListener("keydown", (event) => {
                if (event.key !== "ArrowRight" && event.key !== "ArrowLeft") {
                    return;
                }
                event.preventDefault();
                const next =
                    tabs[
                        (index +
                            (event.key === "ArrowRight" ? 1 : tabs.length - 1)) %
                            tabs.length
                    ];
                stopAuto();
                select(next);
                next.focus();
            });
        });
    })();
</script>

<style>
    .svc-h2 {
        font-family: var(--font-heading);
        font-weight: 800;
        letter-spacing: -0.02em;
        /* data-reveal masks each line in an overflow box; tighter than
           1.15 clips the heading descenders (g, p). */
        line-height: 1.15;
        color: #211915;
        text-wrap: balance;
    }
    :global(.dark) .svc-h2 {
        color: #ffffff;
    }

    /* ---------- tabs ---------- */
    .svc-tab {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: "Raleway", sans-serif;
        font-weight: 700;
        font-size: 0.95rem;
        color: #6c7788;
        background: #f2f5fa;
        border: 0;
        padding: 13px 22px 14px;
        border-radius: 18px 18px 0 0;
        cursor: pointer;
        overflow: clip;
        transition:
            background 0.25s,
            color 0.25s;
    }
    :global(.dark) .svc-tab {
        color: #8893a6;
        background: #111a31;
    }
    .svc-tab svg {
        width: 17px;
        height: 17px;
        flex: none;
        opacity: 0.7;
        transition:
            opacity 0.25s,
            color 0.25s;
    }
    .svc-tab:hover {
        color: #211915;
    }
    :global(.dark) .svc-tab:hover {
        color: #f4f7fc;
    }
    .svc-tab[aria-selected="true"] {
        background: #dcecf9;
        color: #211915;
    }
    :global(.dark) .svc-tab[aria-selected="true"] {
        background: #14294a;
        color: #f4f7fc;
    }
    .svc-tab[aria-selected="true"] svg {
        opacity: 1;
        color: #005eb8;
    }
    .svc-tab:focus-visible {
        outline: 2px solid #00b5e2;
        outline-offset: 3px;
    }

    .svc-prog {
        position: absolute;
        left: 18px;
        right: 18px;
        bottom: 6px;
        height: 2px;
        border-radius: 2px;
        background: #e2e8f1;
        transform-origin: left;
        transform: scaleX(0);
        opacity: 0;
    }
    :global(.svc-tabs-auto)
        .svc-tab[aria-selected="true"]
        .svc-prog {
        opacity: 1;
        background: linear-gradient(90deg, #005eb8, #00b5e2);
        animation: svc-fill 7s linear forwards;
    }
    :global(.svc-tabs-auto.svc-tabs-paused)
        .svc-tab[aria-selected="true"]
        .svc-prog {
        animation-play-state: paused;
    }
    @keyframes svc-fill {
        to {
            transform: scaleX(1);
        }
    }

    .svc-tabwrap {
        background: #dcecf9;
        border-radius: 44px;
        padding: 8px;
        max-width: 1200px;
        margin: 0 auto;
    }
    :global(.dark) .svc-tabwrap {
        background: #14294a;
    }

    @media (max-width: 640px) {
        .svc-tabwrap {
            border-radius: 28px;
        }
        .svc-tabs {
            justify-content: flex-start;
            overflow-x: auto;
            flex-wrap: nowrap;
        }
        .svc-tab {
            flex: none;
        }
    }

    /* ---------- panes ---------- */
    .svc-pane {
        display: grid;
        gap: 24px;
        align-items: stretch;
    }
    @media (min-width: 960px) {
        .svc-pane {
            grid-template-columns: 0.9fr 1.1fr;
            min-height: 500px;
        }
    }
    .svc-pane[hidden] {
        display: none !important;
    }

    .svc-pane-txt {
        /* Anchored to the top (not centered) and a fixed pane height on
           .svc-pane-vis below: the icon and h3 must land at the same offset
           on every tab so switching tabs never makes the layout jump. */
        padding: 56px 36px 44px;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
