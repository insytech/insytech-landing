---
// Tarjeta de imagen + título en mayúsculas + una línea + flecha.
//
// Se extrajo al necesitar la segunda variante en la sección de agentes de /ai/:
// copiar el marcado y los estilos habría dejado dos patrones que se
// desincronizan al primer ajuste. El patrón viene de boa-concept.com —de ahí la
// estructura y nada más; color, tipografía y radios son los del proyecto.
//
// La imagen es opcional a propósito. En la referencia conviven tarjetas con foto
// y tarjetas de solo texto en la misma reja, y hay contenidos —un agente que
// consulta un ERP— que ninguna foto industrial ilustra sin mentir. Sin `image`
// la tarjeta se compacta y el título sube.
interface Props {
    title: string;
    body: string;
    href: string;
    /** Texto del enlace para lectores de pantalla; la flecha es decorativa. */
    cta: string;
    image?: string;
    alt?: string;
    /** Relación de aspecto de la imagen, cuando la hay. */
    ratio?: string;
    class?: string;
}

const {
    title,
    body,
    href,
    cta,
    image,
    alt = "",
    ratio = "16 / 9",
    class: className = "",
} = Astro.props;
---

<a href={href} class:list={["media-card", className]}>
    {
        image && (
            <span class="media-card__media" style={`--ratio: ${ratio};`}>
                <img src={image} alt={alt} loading="lazy" decoding="async" />
            </span>
        )
    }

    <span class="media-card__body">
        <span class="media-card__text">
            <h3 class="media-card__title">{title}</h3>
            <span class="media-card__desc">{body}</span>
        </span>

        <span class="media-card__arrow" aria-hidden="true">
            <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
        </span>
    </span>

    <span class="sr-only">{cta}</span>
</a>

<style>
    .media-card {
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid rgb(229 231 235);
        border-radius: 1rem;
        background: rgb(255 255 255);
        transition:
            border-color 0.35s ease,
            box-shadow 0.35s ease,
            transform 0.35s cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .media-card:hover {
        border-color: rgb(0 94 184 / 0.4);
        box-shadow: 0 18px 44px rgb(0 20 137 / 0.12);
        transform: translateY(-3px);
    }

    .media-card__media {
        display: block;
        overflow: hidden;
        aspect-ratio: var(--ratio, 16 / 9);
        background: rgb(0 94 184 / 0.06);
    }

    .media-card__media img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.7s cubic-bezier(0.2, 0.6, 0.2, 1);
    }

    .media-card:hover .media-card__media img {
        transform: scale(1.05);
    }

    .media-card__body {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex: 1;
        padding: 1.35rem 1.4rem 1.5rem;
    }

    .media-card__text {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        min-width: 0;
    }

    .media-card__title {
        margin: 0;
        font-family: var(--font-heading);
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #211915;
        line-height: 1.2;
    }

    .media-card__desc {
        font-size: 0.92rem;
        line-height: 1.6;
        color: rgb(75 85 99);
    }

    /* La flecha se desplaza y se rellena al pasar el ratón. Va con `transform`
       para no disparar relayout. */
    .media-card__arrow {
        display: grid;
        place-items: center;
        flex-shrink: 0;
        width: 2.1rem;
        height: 2.1rem;
        border: 1px solid rgb(0 94 184 / 0.25);
        border-radius: 999px;
        color: #005eb8;
        transition:
            transform 0.35s cubic-bezier(0.2, 0.6, 0.2, 1),
            background-color 0.35s ease,
            border-color 0.35s ease,
            color 0.35s ease;
    }

    .media-card__arrow svg {
        width: 0.95rem;
        height: 0.95rem;
    }

    .media-card:hover .media-card__arrow {
        transform: translateX(3px);
        border-color: #005eb8;
        background: #005eb8;
        color: #ffffff;
    }

    :global(.dark) .media-card {
        border-color: rgb(31 41 55);
        background: rgb(3 7 18);
    }

    :global(.dark) .media-card:hover {
        border-color: rgb(0 181 226 / 0.45);
        box-shadow: 0 18px 44px rgb(0 0 0 / 0.5);
    }

    :global(.dark) .media-card__title {
        color: rgb(255 255 255);
    }

    :global(.dark) .media-card__desc {
        color: rgb(156 163 175);
    }

    :global(.dark) .media-card__arrow {
        color: #00b5e2;
        border-color: rgb(0 181 226 / 0.3);
    }

    :global(.dark) .media-card:hover .media-card__arrow {
        background: #00b5e2;
        border-color: #00b5e2;
        color: #021018;
    }
</style>
