---
export interface Props {
    href: string;
    text: string;
    className?: string;
    /** `inverse` es el mismo botón sobre superficie oscura: relleno blanco
     *  sólido y texto Reflex Blue, con el mismo círculo que crece en hover. El
     *  primario azul sería invisible sobre los paneles de /ai/, que van sobre
     *  #001489, y el secundario deja el fondo transparente. */
    variant: "primary" | "secondary" | "inverse";
}

const { href, text, className, variant } = Astro.props;

const getThemeStyle = (variant: "primary" | "secondary" | "inverse") => {
    if (variant === "primary") {
        return "bg-[#005EB8] border-transparent relative after:bg-[#172554] hover:border-[#172554]";
    }
    if (variant === "inverse") {
        // Sin `after:bg-*` propio: la clase base ya fija el círculo en #172554 y
        // gana por orden. El círculo oscuro es además el correcto, porque el
        // texto pasa a blanco al entrar y el contraste se mantiene en los dos
        // estados.
        //
        // `hover:bg-[#172554]` no es decorativo: el círculo es un cuadrado
        // redondeado que crece desde el centro y no cubre del todo las esquinas
        // del botón, así que sobre relleno blanco quedaba un halo claro en el
        // borde. En el primario no se nota porque debajo hay azul; aquí el fondo
        // vira al mismo color que el círculo y el borde desaparece.
        return "bg-white border-transparent relative hover:bg-[#172554] hover:border-[#172554]";
    }
    return "text-primary";
};

const getTextColor = (variant: "primary" | "secondary" | "inverse") => {
    if (variant === "primary") {
        return "text-white";
    }
    if (variant === "inverse") {
        // En reposo Reflex Blue sobre blanco; en hover el group-hover:text-white
        // de la clase base lo lleva a blanco sobre el círculo oscuro.
        return "text-[#001489]";
    }
    // text-primary = var(--primary): oficial Blue #005EB8 (light) / Light Blue #00B5E2 (dark).
    return "text-primary";
};
---

<a
    href={href}
    class={`btn-link group inline-flex items-center justify-center px-6 py-3 rounded-full outline-none relative overflow-hidden border
                    after:absolute after:inset-x-0 after:aspect-square after:origin-center after:rounded-full after:top-0 after:left-0 after:bg-[#172554]
                    ${getThemeStyle(variant)} ${className}`}
>
    <span
        class={`relative ${getTextColor(variant)} z-10 transition-colors duration-300 group-hover:text-white`}
    >
        {text}
    </span>
</a>

<style>
    /* Transiciones acotadas por propiedad: las clases de duración y easing de
       Tailwind no emiten transition-property, así que sin esto el enlace
       transiciona `all` (valor inicial de CSS) fuera de GPU. */
    .btn-link {
        transition:
            transform 160ms cubic-bezier(0.23, 1, 0.32, 1),
            border-color 250ms cubic-bezier(0.23, 1, 0.32, 1),
            background-color 250ms cubic-bezier(0.23, 1, 0.32, 1);
    }

    /* Movimiento original del relleno (scale 0 -> 2.5, 300ms linear): decisión
       de diseño confirmada, no tocar.
       Vive aquí y no en clases `scale-*` de Tailwind 4 porque esas emiten la
       propiedad `scale`, que se multiplica con `transform` en vez de
       reemplazarlo — mezclarlas dejaba el círculo a ~0.875 en hover. */
    .btn-link::after {
        transform: scale(0);
        opacity: 0.7;
        transition:
            transform 300ms linear,
            opacity 300ms linear;
    }

    /* Feedback de pulsación: sutil (0.95-0.98) y rápido (100-160ms). */
    .btn-link:active {
        transform: scale(0.97);
    }

    /* El relleno de hover vive aquí y no en clases `hover:` de Tailwind: en
       táctil el tap dejaría el estado hover pegado. */
    @media (hover: hover) and (pointer: fine) {
        .btn-link:hover::after {
            opacity: 1;
            transform: scale(2.5);
        }
    }
</style>
