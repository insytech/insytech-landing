---
// Rejilla de lecturas relacionadas para una página de servicio.
//
// El enlace post -> servicio ya existía; el de vuelta no. Cuando los posts de un
// tema rankean por encima de la página de servicio de ese mismo tema, agruparlos
// desde la página consolida la autoridad en vez de competir contra ellos. Se
// extrajo de vision/Resources.astro al necesitar la segunda variante.
import Container from "./Container.astro";

export interface RelatedPost {
    title: string;
    summary: string;
    href: string;
}

interface Props {
    posts: readonly RelatedPost[];
    heading: string;
    /** Línea de apoyo bajo el encabezado. */
    intro: string;
    /** Superficie y ritmo vertical de la sección anfitriona. */
    class?: string;
    /** Nivel de la escala tipográfica que le toca a esta sección. */
    headingClass: string;
}

const {
    posts,
    heading,
    intro,
    class: className = "",
    headingClass,
} = Astro.props;
---

<section id="resources" class={`relative overflow-clip ${className}`}>
    <Container className="relative z-10">
        <div class="max-w-3xl mb-10" data-animate="fade-up">
            <h2 data-reveal="heading" class={`${headingClass} mb-4`}>
                {heading}
            </h2>
            <p class="text-lg text-gray-600 dark:text-gray-400">
                {intro}
            </p>
        </div>

        <div class="grid md:grid-cols-2 gap-5" data-reveal="group">
            {
                posts.map((post) => (
                    <a
                        href={post.href}
                        class="group rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900/50 p-6 flex items-start justify-between gap-5 hover:border-[#005EB8]/40 dark:hover:border-[#4da6ff]/50 transition-colors"
                    >
                        <span class="flex flex-col gap-2">
                            <span class="font-bold font-heading text-[#211915] dark:text-white group-hover:text-[#005EB8] dark:group-hover:text-[#4da6ff] transition-colors">
                                {post.title}
                            </span>
                            <span class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
                                {post.summary}
                            </span>
                        </span>
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke-width="2"
                            stroke="currentColor"
                            class="flex-shrink-0 w-4 h-4 mt-1 text-[#005EB8] dark:text-[#4da6ff]"
                            aria-hidden="true"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25"></path>
                        </svg>
                    </a>
                ))
            }
        </div>
    </Container>
</section>
