---
import BandPanel from "../mocks/BandPanel.astro";
import OeeRing from "../mocks/OeeRing.astro";
import RadioChips from "./RadioChips.astro";

/**
 * Dashboard de OEE en grande. Ningún aro y ninguna barra lleva número: el arco
 * es una forma y no afirma ninguna magnitud (misma regla que ManagementMock).
 * Donde iría la cifra va una barra esqueleto.
 *
 * NO lleva gráfico: el MES real no tiene ninguna librería de charts y esta
 * pantalla suya muestra aros, tarjetas de factor y TABLAS. Dibujar un histograma
 * aquí inventaría una capacidad que el producto no trae, que es la misma falta
 * que publicar una cifra sin respaldo aunque no haya número de por medio. (El
 * histograma del Shift Report del HMI sí existe, y ahí se queda.)
 *
 * El control Hourly / By Shift / Daily es un grupo de radios y el CSS enseña los
 * renglones de esa granularidad. Cero JS.
 *
 * Sin ids: la marquesina de la banda 2 pinta esta pantalla dos veces. `uid`
 * separa el grupo de radios y los selectores van por `data-opt`.
 */
export interface Props {
    uid: string;
}

const { uid } = Astro.props;
const rings = [
    { label: "Availability", offset: 34 },
    { label: "Performance", offset: 48 },
    { label: "Quality", offset: 20 },
] as const;

/** Anchos de la barra de progreso: geometría, no porcentaje afirmado. */
const factors = [
    { label: "Availability", note: "Runtime vs planned time", bar: "w-3/4" },
    { label: "Performance", note: "Cycle time vs target", bar: "w-2/3" },
    { label: "Quality", note: "Good parts vs produced", bar: "w-4/5" },
] as const;

/** Tres granularidades del MISMO desglose. Ninguna celda lleva número: donde
 *  iría el valor de OEE va una barra, que es una forma. Los anchos de barra son
 *  geometría de la clase de Tailwind y no afirman ninguna magnitud. */
const series = {
    hourly: {
        value: "hourly",
        label: "Hourly",
        rows: [
            { line: "Plant 1 · Line A", period: "08:00", bar: "w-3/4" },
            { line: "Plant 1 · Line B", period: "09:00", bar: "w-2/3" },
            { line: "Plant 1 · Line C", period: "10:00", bar: "w-4/5" },
            { line: "Plant 2 · Line D", period: "11:00", bar: "w-1/2" },
        ],
    },
    shift: {
        value: "shift",
        label: "By Shift",
        rows: [
            { line: "Plant 1 · Line A", period: "Shift 1", bar: "w-2/3" },
            { line: "Plant 1 · Line B", period: "Shift 1", bar: "w-4/5" },
            { line: "Plant 1 · Line C", period: "Shift 2", bar: "w-1/2" },
            { line: "Plant 2 · Line D", period: "Shift 3", bar: "w-3/4" },
        ],
    },
    daily: {
        value: "daily",
        label: "Daily",
        rows: [
            { line: "Plant 1 · Line A", period: "Mon", bar: "w-4/5" },
            { line: "Plant 1 · Line B", period: "Tue", bar: "w-1/2" },
            { line: "Plant 1 · Line C", period: "Wed", bar: "w-3/4" },
            { line: "Plant 2 · Line D", period: "Thu", bar: "w-2/3" },
        ],
    },
} as const;

const granularities = Object.values(series).map((s) => ({
    value: s.value,
    label: s.label,
}));
---

<!-- La clase envuelve al panel COMPLETO: el control de granularidad se pinta en
     la cabecera (slot `actions`) y las reglas `:has()` tienen que verlo desde el
     mismo ancestro que los tres desgloses. -->
<div class="mes-oee h-full">
<BandPanel title="OEE Dashboard" tag="Live" bodyClass="min-h-0 flex-1 p-2">
    <RadioChips
        slot="actions"
        name={`${uid}-oee-gran`}
        label="Granularity"
        options={granularities}
    />

    <div class="flex h-full gap-3">
        <div class="flex w-[230px] shrink-0 flex-col items-center justify-center gap-3">
            <OeeRing box={128} stroke={12} dash={339} offset={88} class="h-32 w-32">
                <span
                    class="text-[11px] font-semibold uppercase tracking-wide text-gray-700 dark:text-gray-200"
                >
                    Plant OEE
                </span>
                <span class="text-[10px] uppercase text-gray-400">live</span>
            </OeeRing>

            <div class="grid w-full grid-cols-3 gap-2">
                {
                    rings.map((r) => (
                        <div class="flex flex-col items-center gap-1">
                            <OeeRing
                                box={48}
                                stroke={4}
                                dash={138}
                                offset={r.offset}
                                class="h-12 w-12"
                                arcClass="text-[#00B5E2]"
                            />
                            <span class="text-[9px] text-gray-500 dark:text-gray-400">
                                {r.label}
                            </span>
                        </div>
                    ))
                }
            </div>
        </div>

        <div class="flex min-w-0 flex-1 flex-col gap-2">
            <div class="grid shrink-0 grid-cols-3 gap-2">
                {
                    factors.map((f) => (
                        <div class="flex flex-col gap-1.5 rounded-lg border border-gray-100 bg-gray-50/60 p-2 dark:border-gray-800 dark:bg-gray-800/30">
                            <span class="text-[10px] font-semibold text-gray-800 dark:text-gray-200">
                                {f.label}
                            </span>
                            <div class="h-4 w-10 rounded bg-gray-200 dark:bg-gray-600" />
                            <div class="h-1.5 w-full overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
                                <div
                                    class:list={[
                                        "h-full rounded-full bg-[#005EB8] dark:bg-[#00B5E2]",
                                        f.bar,
                                    ]}
                                />
                            </div>
                            <span class="text-[9px] leading-tight text-gray-500 dark:text-gray-400">
                                {f.note}
                            </span>
                        </div>
                    ))
                }
            </div>

            <!-- Los tres desgloses comparten hueco y el alto lo fija el flex:
                 cambiar de granularidad no redimensiona el panel. -->
            <div
                class="flex min-h-0 flex-1 flex-col rounded-lg border border-gray-100 p-2 dark:border-gray-800"
            >
                <div
                    class="mb-1 flex shrink-0 items-center gap-2 border-b border-gray-100 pb-1 text-[9px] font-semibold uppercase tracking-wide text-gray-400 dark:border-gray-800"
                >
                    <span class="flex-1">Location / Line</span>
                    <span class="w-12">Period</span>
                    <span class="w-24 text-right">OEE</span>
                </div>
                <div class="min-h-0 flex-1">
                    {
                        Object.entries(series).map(([key, s]) => (
                            <div
                                class="flex h-full flex-col justify-around"
                                data-rows={key}
                            >
                                {s.rows.map((r) => (
                                    <div class="flex items-center gap-2 text-[10px]">
                                        <span class="min-w-0 flex-1 truncate font-medium text-gray-700 dark:text-gray-300">
                                            {r.line}
                                        </span>
                                        <span class="w-12 shrink-0 font-mono text-[9px] text-gray-400">
                                            {r.period}
                                        </span>
                                        <div class="h-1.5 w-24 shrink-0 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700">
                                            <div
                                                class:list={[
                                                    "h-full rounded-full bg-[#005EB8] dark:bg-[#00B5E2]",
                                                    r.bar,
                                                ]}
                                            />
                                        </div>
                                    </div>
                                ))}
                            </div>
                        ))
                    }
                </div>
            </div>
        </div>
    </div>
</BandPanel>
</div>

<style is:global>
    .mes-oee [data-rows] {
        display: none;
    }
    .mes-oee:has(input[data-opt="hourly"]:checked) [data-rows="hourly"],
    .mes-oee:has(input[data-opt="shift"]:checked) [data-rows="shift"],
    .mes-oee:has(input[data-opt="daily"]:checked) [data-rows="daily"] {
        display: flex;
    }
</style>
