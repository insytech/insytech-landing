---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
import { SURFACE } from "@utils/typography";
import AndonGridMock from "./mocks/AndonGridMock.astro";
import VisualAidMock from "./mocks/VisualAidMock.astro";
import OeeGaugeMock from "./mocks/OeeGaugeMock.astro";
import BomMock from "./mocks/BomMock.astro";
import AndonFlowMock from "./mocks/AndonFlowMock.astro";
import ArchitectureFlowMock from "./mocks/ArchitectureFlowMock.astro";
import ScanPromptMock from "./mocks/ScanPromptMock.astro";
import ShiftReportMock from "./mocks/ShiftReportMock.astro";
import HmiTerminalScreen from "./screens/HmiTerminalScreen.astro";
import AndonDashboardScreen from "./screens/AndonDashboardScreen.astro";
import OeeDashboardScreen from "./screens/OeeDashboardScreen.astro";

/** Dos bandas. La de arriba se desplaza y lleva paneles de un solo propósito.
 *  La de abajo lleva pantallas COMPUESTAS del doble de área (700x420) y se
 *  desplaza MUCHO más despacio (el carril mide 720px por hueco, o sea 700px de
 *  pantalla más los 20 de separación): la diferencia de velocidad entre bandas
 *  es lo que da profundidad, y a 12 px/s la pantalla grande se alcanza a leer
 *  mientras pasa. Se para al pasar el ratón o al entrar el foco, que es lo que
 *  la deja usable siendo interactiva.
 *
 *  Los paneles de un solo propósito que la banda 2 dejó libres pasaron a la
 *  banda 1, y los tres paneles de diagrama van separados en el orden: pasando
 *  uno al lado del otro se leerían como el mismo panel tres veces. */
const bandMoving = [
    ScanPromptMock,
    VisualAidMock,
    AndonFlowMock,
    BomMock,
    OeeGaugeMock,
    AndonGridMock,
    ShiftReportMock,
    ArchitectureFlowMock,
];
/** Orden a propósito: el Operator Terminal va EN MEDIO para que caiga centrado
 *  en el viewport al cargar (ver el margen del carril en el CSS de abajo). Es la
 *  pantalla que mejor engancha a quien acaba de bajar del hero. */
const bandStatic = [AndonDashboardScreen, HmiTerminalScreen, OeeDashboardScreen];

const doubled = <T,>(row: readonly T[]): T[] => [...row, ...row];
---

<section
    class={`mes-scene relative overflow-x-clip ${SURFACE.base} pt-28 pb-16 lg:pt-32`}
>
    <!-- Fondo: retícula de puntos y un resplandor estático. Nada de esto se
         anima ni se transforma; la banda ya es todo el movimiento. -->
    <div class="pointer-events-none absolute inset-0 z-0">
        <div
            class="absolute inset-0 bg-[radial-gradient(#e5e7eb_1px,transparent_1px)] [background-size:20px_20px] opacity-70 dark:bg-[radial-gradient(#1f2937_1px,transparent_1px)]"
        >
        </div>
        <div
            class="absolute left-1/2 top-1/4 h-[50%] w-[80%] -translate-x-1/2 rounded-full bg-cyan-200/10 blur-[120px]"
        >
        </div>
    </div>

    <Container className="relative z-10">
        <div class="flex flex-col items-center text-center">
            <h1
                class="mb-6 max-w-6xl text-4xl font-bold leading-tight sm:text-5xl lg:text-6xl"
                data-animate="fade-up"
                data-animate-delay=".1s"
            >
                {
                    /* Los dos tramos van como `block`: así el corte cae SIEMPRE
                       entre "industrial" y "y MES", a cualquier ancho, en vez de
                       depender de que el max-width dé la cuenta justa. Antes iban
                       en línea con un {" "} y un <br />, y a lg:text-6xl la
                       primera línea todavía se partía sola en dos. */
                }
                <span class="block text-gray-900 dark:text-white"
                    >Sistema de trazabilidad industrial</span
                >
                <span
                    class="block bg-gradient-to-r from-[#001489] via-[#005EB8] to-[#00B5E2] bg-clip-text text-transparent dark:from-[#4da6ff] dark:via-[#00B5E2] dark:to-[#6de0ff]"
                    >y MES en tiempo real</span
                >
            </h1>

            <p
                class="mb-10 max-w-2xl text-lg leading-relaxed text-gray-600 dark:text-gray-400"
                data-animate="fade-up"
                data-animate-delay=".2s"
            >
                Trazabilidad de cada pieza y cada lote, con dashboards de
                producción, monitoreo de OEE y andon digital. Un MES que sabe
                qué pasó en su planta, cuándo y en qué máquina.
            </p>

            <div
                class="mb-14 flex flex-wrap justify-center gap-4"
                data-animate="fade-up"
                data-animate-delay=".3s"
            >
                <BtnLink
                    href="#contact"
                    text="Solicitar demo"
                    variant="primary"
                    className="px-8 py-4"
                />
                <BtnLink
                    href="#planner"
                    text="Ver soluciones"
                    variant="secondary"
                    className="px-8 py-4 border-2 border-gray-300 dark:border-gray-600"
                />
            </div>
        </div>
    </Container>

    <!-- Banda 1: marquesina. overflow-x-clip y no overflow-hidden: hidden
         crearía un contenedor de scroll y rompería los sticky de la página. Sin
         mask-image: el corte duro en los dos bordes es lo que dice "esto
         continúa". El desplazamiento negativo corta también el borde izquierdo. -->
    <div class="mes-band relative z-10 w-full overflow-x-clip">
        <ul class="mes-track -ml-[90px] flex w-max list-none">
            {
                doubled(bandMoving).map((Panel) => (
                    <li class="h-[290px] w-[280px] shrink-0 pr-5 md:w-[340px]">
                        <Panel />
                    </li>
                ))
            }
        </ul>
    </div>

    <!-- Banda 2: la misma marquesina que la de arriba pero cuatro veces más
         lenta. overflow-x-clip y NO overflow-x-auto: un contenedor de scroll
         sacaba una barra horizontal de verdad. El espaciado va en el padding del
         carril y no en `gap` para que el 50% del keyframe caiga exacto.

         Los controles de las pantallas siguen siendo tabulables —al contrario
         que los paneles de la banda 1— porque entrar el foco para la banda. -->
    <div class="mes-band2 relative z-10 mt-5 w-full overflow-x-clip">
        <ul class="mes-track2 flex w-max list-none">
            {
                doubled(bandStatic).map((Screen, i) => (
                    <li class="h-[420px] w-[720px] shrink-0 pr-5">
                        {/* uid separa los grupos de radios de las dos copias de
                            la marquesina: sin él, marcar una pestaña en una
                            desmarcaría la de la otra. */}
                        <Screen uid={`s${i}`} />
                    </li>
                ))
            }
        </ul>
    </div>

</section>

<style>
    /* El carril arranca ya en su sitio: nunca en opacity 0 ni width 0, así que
       si la animación no corre nunca (sin JS, reduced-motion, fuera de
       pantalla) la banda se ve completa y estática. */
    .mes-track {
        animation-name: mes-marquee;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
        animation-duration: 58s;
        animation-play-state: paused;
        will-change: transform;
    }

    /* `is-live` la conmuta el IntersectionObserver de la página sobre
       `.mes-scene`: fuera de pantalla el carril no consume frames. */
    .mes-scene.is-live .mes-track {
        animation-play-state: running;
    }

    /* Banda 2: mismo keyframe, 180s. Seis huecos de 720px son 4320px de carril y
       el -50% son 2160px: ~12 px/s frente a los ~47 px/s de la banda 1. */
    .mes-track2 {
        /* Centrado del Operator Terminal al cargar. Es el segundo hueco del
           carril, así que su pantalla de 700px va de 720px a 1420px en
           coordenadas del carril y su centro cae en 1070px. El margen se deriva
           de 50vw y no de un px fijo: un px fijo centraría solo a un ancho.

           Ojo: es una propiedad DEL MOMENTO DE CARGA. La banda se mueve a ~12
           px/s, así que el centrado se va perdiendo despacio (±100px en ~17s). */
        margin-left: calc(50vw - 1070px);
        animation-name: mes-marquee;
        animation-timing-function: linear;
        animation-iteration-count: infinite;
        animation-duration: 180s;
        animation-play-state: paused;
        will-change: transform;
    }

    .mes-scene.is-live .mes-track2 {
        animation-play-state: running;
    }

    /* Se para al pasar el ratón y al entrar el foco. El `:focus-within` es la
       mitad importante: es lo que deja las pestañas, el conmutador Grid/Layout y
       el control de granularidad usables con el teclado. Van después y con más
       especificidad que la regla de `is-live`, así que ganan; y fuera de
       pantalla o con reduced-motion la banda sigue parada de todas formas. */
    .mes-scene.is-live .mes-band2:hover .mes-track2,
    .mes-scene.is-live .mes-band2:focus-within .mes-track2 {
        animation-play-state: paused;
    }

    @keyframes mes-marquee {
        to {
            transform: translate3d(-50%, 0, 0);
        }
    }

    /* En móvil la pasada es más lenta: los paneles son más anchos en relación a
       la pantalla y a la velocidad de escritorio el barrido marea. */
    @media (max-width: 767px) {
        .mes-track {
            animation-duration: 80s;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .mes-track,
        .mes-track2 {
            animation: none;
        }
    }
</style>
