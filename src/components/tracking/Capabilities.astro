---
import Container from "../shared/Container.astro";
import { HEADING, PAD, SURFACE } from "@utils/typography";
import PlannerMock from "./mocks/PlannerMock.astro";
import ManagementMock from "./mocks/ManagementMock.astro";
import HmiMock from "./mocks/HmiMock.astro";
import AndonMock from "./mocks/AndonMock.astro";

// Las cuatro capacidades del MES eran cuatro componentes con la misma columna
// doble escrita cuatro veces. Aquí solo cambian el copy, el mock, el lado en el
// que va el mock y la forma de la lista; todo lo demás es una sola plantilla.
//
// Los cuatro son pares entre sí: se quedan en HEADING.section a propósito.
// Promover uno a `display` haría creer que es el argumento de la página.

/** Enlaces dentro de la prosa: el copy viaja como HTML para que sean anclas de verdad. */
const PROSE_LINK =
    "text-[#005EB8] dark:text-[#00B5E2] font-medium underline underline-offset-2 hover:text-[#004a92] dark:hover:text-blue-300 transition-colors";

type Feature = {
    /** `d` del único path del icono (todos son trazo, viewBox 24). */
    path: string;
    /** Color del icono. */
    iconClass: string;
    /** Solo en la forma `card`: fondo de la cajita del icono. */
    boxClass?: string;
    title: string;
    description: string;
};

type Items =
    /** Lista de verificación: solo texto. */
    | { shape: "check"; entries: string[] }
    /** Dos tarjetas en rejilla. */
    | { shape: "card"; entries: Feature[] }
    /** Dos filas icono + texto. */
    | { shape: "row"; entries: Feature[] };

type Capability = {
    /** Ancla de la sección: hay enlaces internos y navegación apuntando aquí. */
    id: string;
    /** `mes-scene` gatea las animaciones infinitas del mock (ver tracking/index.astro). */
    scene: boolean;
    /** Columna que ocupa el mock. */
    mockSide: "left" | "right";
    title: string;
    accent: string;
    /** HTML: puede traer anclas. */
    body: string;
    items: Items;
    link?: { href: string; label: string };
};

// Un solo acento para las cuatro: son secciones pares y la variación anterior
// (índigo, cian, verde, rojo) no codificaba nada. El verde y el rojo además
// chocaban con su uso semántico en la torre andon, donde significan línea
// corriendo y paro. Es el mismo gradiente que el CTA de esta página.
// El enlace de cierre no varía: antes era índigo, verde y rojo por sección, y
// el verde y el rojo chocaban con su significado en la torre andon.
const LINK_CLASS =
    "text-[#005EB8] dark:text-[#00B5E2] font-semibold hover:text-[#001489] dark:hover:text-[#4da6ff] inline-flex items-center gap-2 group";

const ACCENT =
    "from-[#005EB8] via-[#00B5E2] to-[#4338CA] dark:from-[#00B5E2] dark:via-[#4da6ff] dark:to-[#818CF8]";

const capabilities: Capability[] = [
    {
        id: "planner",
        scene: false,
        mockSide: "right",
        title: "Planea el turno",
        accent: "antes de que arranque",
        body: "Optimiza la asignación de turnos, gestión de estaciones y balanceo de líneas. Visualiza tu capacidad instalada y detecta cuellos de botella en segundos.",
        items: {
            shape: "check",
            entries: [
                "Programación visual de arrastrar y soltar intuitiva",
                "Asignación de turnos y operadores",
                "Balanceo de cargas entre líneas",
                "Integración directa con inventario de materia prima",
            ],
        },
        link: {
            href: "#contact",
            label: "Conocer más sobre el planeador",
        },
    },
    {
        id: "management",
        scene: true,
        mockSide: "right",
        title: "Mide el OEE",
        accent: "donde se produce",
        body: `Estructura tu planta digitalmente. Define ubicaciones, gestiona estaciones de trabajo y monitorea el OEE (Eficiencia General de los Equipos) en tiempo real para tomar decisiones basadas en datos. Complementa la <a href="/control/" class="${PROSE_LINK}">automatización de procesos</a> de tu planta. Si estás comparando propuestas, revisa qué determina el <a href="/blog/costo-sistema-trazabilidad-industrial/" class="${PROSE_LINK}">costo de un sistema de trazabilidad</a>.`,
        items: {
            shape: "card",
            entries: [
                {
                    path: "M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4",
                    iconClass: "text-blue-600 dark:text-blue-400",
                    boxClass: "bg-blue-100 dark:bg-blue-900/30",
                    title: "Modelado de Planta",
                    description:
                        "Configura líneas, celdas y estaciones con jerarquía flexible.",
                },
                {
                    path: "M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z",
                    iconClass: "text-cyan-600 dark:text-cyan-400",
                    boxClass: "bg-cyan-100 dark:bg-cyan-900/30",
                    title: "Cálculo de OEE",
                    description:
                        "Disponibilidad, Rendimiento y Calidad calculados al instante.",
                },
            ],
        },
    },
    {
        id: "hmi",
        scene: true,
        mockSide: "left",
        title: "Guía al operador",
        accent: "sin papel",
        body: "Empodera a tus operadores con interfaces táctiles diseñadas para la industria. Instrucciones claras, alertas visuales y registro de calidad en tiempo real.",
        items: {
            shape: "row",
            entries: [
                {
                    path: "M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z",
                    iconClass: "text-blue-600 dark:text-blue-400",
                    title: "Fábrica sin papel",
                    description:
                        "Digitaliza instrucciones, planos y checklists. Elimina el papel y asegura que siempre se use la versión vigente.",
                },
                {
                    path: "M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z",
                    iconClass: "text-cyan-600 dark:text-cyan-400",
                    title: "Andon Digital",
                    description:
                        "Reporte de incidencias y paros de línea con un solo toque. Notifica a mantenimiento y calidad al instante.",
                },
            ],
        },
        link: {
            href: "#contact",
            label: "Ver demo interactivo",
        },
    },
    {
        id: "andon",
        scene: true,
        mockSide: "left",
        title: "Avisa del paro",
        accent: "en cuanto ocurre",
        body: `Minimiza el tiempo de inactividad con nuestro sistema Andon digital. Notifica automáticamente a los equipos de soporte (Mantenimiento, Calidad, Materiales) y escala problemas no resueltos. Se integra con <a href="/software/" class="${PROSE_LINK}">software industrial a la medida</a>.`,
        items: {
            shape: "row",
            entries: [
                {
                    path: "M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z",
                    iconClass: "text-blue-600 dark:text-blue-400",
                    title: "Notificaciones Multicanal",
                    description:
                        "Alertas vía pantallas en piso, SMS, Email, WhatsApp o Microsoft Teams.",
                },
                {
                    path: "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z",
                    iconClass: "text-cyan-600 dark:text-cyan-400",
                    title: "Análisis de Causas Raíz",
                    description:
                        "Registra motivos de paro y genera pareto de fallas para mejora continua.",
                },
            ],
        },
        link: {
            href: "#contact",
            label: "Descubrir funcionalidades Andon",
        },
    },
];

const MOCKS = {
    planner: PlannerMock,
    management: ManagementMock,
    hmi: HmiMock,
    andon: AndonMock,
} as const;
---

{
    capabilities.map((cap) => {
        const Mock = MOCKS[cap.id as keyof typeof MOCKS];
        const mockLeft = cap.mockSide === "left";
        return (
            <section
                id={cap.id}
                class={`${cap.scene ? "mes-scene " : ""}${PAD.section} ${SURFACE.raised} overflow-hidden`}
            >
                <Container className="relative">
                    <div class="grid lg:grid-cols-2 gap-16 items-center">
                        {mockLeft && (
                            <div
                                class="relative order-2 lg:order-1 perspective-1000"
                                data-animate="slide-right"
                            >
                                <Mock />
                            </div>
                        )}

                        <div
                            class={mockLeft ? "order-1 lg:order-2" : undefined}
                            data-animate={mockLeft ? "slide-left" : "slide-right"}
                        >
                            <h2 class={`${HEADING.section} mb-6`}>
                                {cap.title}{" "}
                                <span
                                    class={`text-transparent bg-clip-text bg-gradient-to-r ${ACCENT}`}
                                >
                                    {cap.accent}
                                </span>
                            </h2>

                            <p
                                class="text-lg text-gray-600 dark:text-gray-400 mb-8 leading-relaxed"
                                set:html={cap.body}
                            />

                            {cap.items.shape === "check" && (
                                <ul class="space-y-4 mb-10">
                                    {cap.items.entries.map((item) => (
                                        <li class="flex items-start gap-3 text-gray-700 dark:text-gray-300">
                                            <div class="mt-1 w-5 h-5 rounded-full bg-green-100 dark:bg-green-500/20 flex items-center justify-center shrink-0">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-3 w-3 text-green-600 dark:text-green-400"
                                                    viewBox="0 0 20 20"
                                                    fill="currentColor"
                                                >
                                                    <path
                                                        fill-rule="evenodd"
                                                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                                        clip-rule="evenodd"
                                                    />
                                                </svg>
                                            </div>
                                            <span>{item}</span>
                                        </li>
                                    ))}
                                </ul>
                            )}

                            {cap.items.shape === "card" && (
                                <div class="grid sm:grid-cols-2 gap-6 mb-8">
                                    {cap.items.entries.map((item) => (
                                        <div class="p-4 bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700">
                                            <div
                                                class={`w-10 h-10 rounded-lg ${item.boxClass} flex items-center justify-center mb-3`}
                                            >
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class={`h-6 w-6 ${item.iconClass}`}
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d={item.path}
                                                    />
                                                </svg>
                                            </div>
                                            <h3 class="font-bold text-gray-900 dark:text-white mb-1">
                                                {item.title}
                                            </h3>
                                            <p class="text-sm text-gray-500 dark:text-gray-400">
                                                {item.description}
                                            </p>
                                        </div>
                                    ))}
                                </div>
                            )}

                            {cap.items.shape === "row" && (
                                <div class="space-y-6 mb-10">
                                    {cap.items.entries.map((item) => (
                                        <div class="flex gap-4">
                                            <div class="w-12 h-12 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center shrink-0">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class={`h-6 w-6 ${item.iconClass}`}
                                                    fill="none"
                                                    viewBox="0 0 24 24"
                                                    stroke="currentColor"
                                                >
                                                    <path
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                        stroke-width="2"
                                                        d={item.path}
                                                    />
                                                </svg>
                                            </div>
                                            <div>
                                                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-1">
                                                    {item.title}
                                                </h3>
                                                <p class="text-gray-600 dark:text-gray-400">
                                                    {item.description}
                                                </p>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            )}

                            {cap.link && (
                                <a href={cap.link.href} class={LINK_CLASS}>
                                    {cap.link.label}
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4 transform group-hover:translate-x-1 transition-transform"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                    >
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="2"
                                            d="M17 8l4 4m0 0l-4 4m4-4H3"
                                        />
                                    </svg>
                                </a>
                            )}
                        </div>

                        {!mockLeft && (
                            <div
                                class="relative perspective-1000"
                                data-animate="slide-left"
                            >
                                <Mock />
                            </div>
                        )}
                    </div>
                </Container>
            </section>
        );
    })
}
