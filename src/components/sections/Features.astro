---
import Container from "../shared/Container.astro";
import Paragraph from "../shared/Paragraph.astro";

// Las cuatro tarjetas llevaban cada una una escena de Three.js con
// post-proceso `UnrealBloomPass`. Medido con CDP sobre scroll continuo, esa
// sección se comía el 64 % del hilo principal y 64 ms/s de script, contra el
// 13 % del resto de la home, y descargaba 656 KB de `three.module.js`. Sobre
// esa misma ventana, bloqueando el chunk, la cifra bajaba a 10 % y 9 ms/s.
//
// Y no se veía: los cuatro canvas pintaban un cuadrado vacío —el degradado CSS
// de reserva— porque los alambres blancos y cian sobre fondo casi negro, con
// bloom encima, no llegaban a contrastar. Se pagaba el precio entero por nada.
//
// Ahora cada sector tiene una escena en SVG y CSS, del mismo lenguaje que las
// tarjetas de la baraja de arriba, y sobre todo se entiende qué muestra: una
// línea con estaciones, una placa bajo punta de prueba, una báscula dinámica en
// la cinta y un herramental que alinea. Ninguna posición es aleatoria —la
// versión anterior sembraba los componentes de la placa con `Math.random()`, y
// la escena salía distinta en cada carga—, y ninguna late fuera de pantalla.

const sectors = [
    {
        id: "automotive",
        code: "AUTO-MES",
        title: "Sector Automotriz",
        description: "Implementación de sistemas MES y SCADA con integración total de PLCs y sensores mediante protocolos MODBUS para el monitoreo en tiempo real.",
        scene: "line"
    },
    {
        id: "electronics",
        code: "ELEC-MOD",
        title: "Manufactura Electrónica",
        description: "Enfoque en sistemas de ensamble convencional y estaciones de prueba funcional con trazabilidad integrada para componentes críticos.",
        scene: "test"
    },
    {
        id: "logistics",
        code: "LOGI-SCALE",
        title: "Logística y Empaque",
        description: "Sistemas de reempaquetado automatizados con básculas dinámicas integradas para el control de peso y auditoría de envíos.",
        scene: "scale"
    },
    {
        id: "metal",
        code: "META-INST",
        title: "Metal-mecánica",
        description: "Soporte en instalaciones electromecánicas de precisión y montaje técnico especializado de herramentales y periféricos industriales.",
        scene: "fixture"
    }
];
---

<section id="features" class="relative pt-12 pb-20 bg-white dark:bg-[#020308]">
    <!-- Background exactly like Process.astro but with different pattern -->
    <div class="absolute -left-10 top-0 h-full w-full flex justify-start opacity-30 dark:opacity-40 pointer-events-none">
        <div class="feature-mancha w-64 h-64 overflow-auto flex rounded-xl relative blur-3xl">
          <span class="absolute w-40 h-40 -top-1 -right-1 bg-[#00B5E2] rounded-md rotate-45"></span>
          <span class="absolute w-40 h-40 -bottom-1 -right-1 bg-[#005EB8] rounded-md rotate-45"></span>
          <span class="absolute w-40 h-40 -bottom-1 -left-1 bg-[#001489] rounded-md rotate-45"></span>
        </div>
    </div>

    <div class="absolute -right-10 -bottom-10 h-full w-full flex justify-end items-end opacity-30 dark:opacity-40 pointer-events-none">
        <div class="feature-mancha w-48 h-48 overflow-auto flex rounded-xl relative blur-3xl">
          <span class="absolute w-32 h-32 -top-1 -right-1 bg-[#00B5E2] rounded-md rotate-45"></span>
          <span class="absolute w-32 h-32 -bottom-1 -right-1 bg-[#005EB8] rounded-md rotate-45"></span>
          <span class="absolute w-32 h-32 -bottom-1 -left-1 bg-[#001489] rounded-md rotate-45"></span>
        </div>
    </div>

    <Container className="relative z-10 max-w-[1600px]">
        <!-- Header - Exact match to Services.astro -->
        <div class="max-w-6xl mb-24 md:mb-32 features-header">
            <h2 class="text-5xl md:text-7xl font-black text-[#002B49] dark:text-white leading-[1.05] tracking-tight">
                Impacto <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#005EB8] to-[#00B5E2]">Sistémico</span>
                <br /> por Sector Operativo
            </h2>
            <div class="mt-8">
                <Paragraph className="text-xl font-medium leading-relaxed max-w-2xl">
                    Nuestra infraestructura técnica redefine los límites de la manufactura moderna a través de la síntesis de automatización e inteligencia propia.
                </Paragraph>
            </div>
        </div>

        <!-- 4-Column Asymmetric Grid -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-px bg-gray-200 dark:bg-white/10 border-x border-gray-200 dark:border-white/10">
            {sectors.map((sector) => (
                <div 
                    class="group relative flex flex-col bg-white dark:bg-[#020617] p-7 lg:p-14 min-h-[600px] lg:min-h-[650px] transition-colors duration-700 sector-card overflow-hidden"
                >
                    <!-- Background Grainy Noise -->
                    <div class="absolute inset-0 opacity-[0.02] dark:opacity-[0.05] pointer-events-none mix-blend-overlay bg-noise"></div>

                    <div class="relative z-10 h-full flex flex-col">
                        <div class="flex justify-between items-start mb-16">
                            <span class="text-[11px] font-mono font-black text-[#005EB8] dark:text-[#00B5E2] tracking-widest">{sector.code}</span>
                            <div class="h-10 w-[1px] bg-gray-200 dark:bg-white/10"></div>
                        </div>

                        <h3 class="text-3xl lg:text-4xl font-black text-[#002B49] dark:text-white leading-tight tracking-tight uppercase mb-8 sector-title">
                            {sector.title}
                        </h3>
                        
                        {/* Una escena por sector, en SVG y CSS. Todas son
                            decorativas: lo que se afirma está en el texto de
                            abajo. */}
                        <div class="flex-grow flex items-center justify-center">
                            <div class="ft-scene" data-scene={sector.scene} aria-hidden="true">
                                {sector.scene === "line" && (
                                    <svg viewBox="0 0 200 200" fill="none">
                                        {/* Cuatro estaciones sobre la línea; la
                                            unidad avanza de una a otra y cada
                                            estación reporta al pasar. */}
                                        <rect class="ft-frame" x="14" y="30" width="172" height="48" rx="8" />
                                        <text class="ft-read" x="26" y="52">MES</text>
                                        {[0, 1, 2, 3].map((n) => (
                                            <rect
                                                class="ft-tile"
                                                x={78 + n * 26}
                                                y={40}
                                                width="18"
                                                height="28"
                                                rx="3"
                                                style={`--n:${n}`}
                                            />
                                        ))}
                                        <path class="ft-rail" d="M14 150h172" stroke-width="2" />
                                        {[0, 1, 2, 3].map((n) => (
                                            <g style={`--n:${n}`}>
                                                <path
                                                    class="ft-post"
                                                    d={`M${32 + n * 45} 150v-26`}
                                                    stroke-width="2"
                                                />
                                                <circle class="ft-lamp" cx={32 + n * 45} cy="118" r="5" />
                                            </g>
                                        ))}
                                        <rect class="ft-unit" x="14" y="158" width="34" height="20" rx="4" />
                                    </svg>
                                )}

                                {sector.scene === "test" && (
                                    <svg viewBox="0 0 200 200" fill="none">
                                        {/* Placa con pistas y puntos de prueba;
                                            la punta baja sobre cada uno y el
                                            punto queda marcado. */}
                                        <rect class="ft-frame" x="16" y="86" width="168" height="98" rx="8" />
                                        <path
                                            class="ft-trace"
                                            d="M34 112h44v26h48M34 150h30v20h60M126 112v46h34"
                                            stroke-width="1.5"
                                        />
                                        {[0, 1, 2, 3].map((n) => (
                                            <rect
                                                class="ft-chip"
                                                x={38 + n * 36}
                                                y={122}
                                                width="22"
                                                height="14"
                                                rx="2"
                                                style={`--n:${n}`}
                                            />
                                        ))}
                                        {[0, 1, 2, 3].map((n) => (
                                            <circle
                                                class="ft-pad"
                                                cx={49 + n * 36}
                                                cy="166"
                                                r="5"
                                                style={`--n:${n}`}
                                            />
                                        ))}
                                        <g class="ft-probe">
                                            <path d="M0 14v42" stroke-width="2.5" />
                                            <circle cx="0" cy="60" r="4" />
                                        </g>
                                    </svg>
                                )}

                                {sector.scene === "scale" && (
                                    <svg viewBox="0 0 200 200" fill="none">
                                        {/* Cinta con báscula dinámica: la caja
                                            cruza, la plataforma acusa el peso y
                                            la lectura salta al siguiente valor. */}
                                        <defs>
                                            {/* Sin este recorte se ven las tres
                                                cifras a la vez y deja de leerse
                                                como una lectura que cambia. */}
                                            <clipPath id="ft-readout">
                                                <rect x="52" y="28" width="96" height="42" rx="8" />
                                            </clipPath>
                                        </defs>
                                        <rect class="ft-frame" x="52" y="28" width="96" height="42" rx="8" />
                                        <text class="ft-read" x="66" y="54">kg</text>
                                        <g class="ft-digits" clip-path="url(#ft-readout)">
                                            <text x="140" y="54" text-anchor="end">18.4</text>
                                            <text x="140" y="96" text-anchor="end">21.7</text>
                                            <text x="140" y="138" text-anchor="end">17.2</text>
                                        </g>
                                        <path class="ft-rail" d="M12 158h176" stroke-width="2" />
                                        {[0, 1, 2, 3, 4, 5].map((n) => (
                                            <circle class="ft-roller" cx={22 + n * 31} cy="166" r="5" />
                                        ))}
                                        <rect class="ft-plate" x="76" y="146" width="48" height="8" rx="3" />
                                        {[0, 1].map((n) => (
                                            <rect
                                                class="ft-box"
                                                x="0"
                                                y="112"
                                                width="34"
                                                height="34"
                                                rx="4"
                                                style={`--n:${n}`}
                                            />
                                        ))}
                                    </svg>
                                )}

                                {sector.scene === "fixture" && (
                                    <svg viewBox="0 0 200 200" fill="none">
                                        {/* El herramental baja sobre la base y
                                            encaja; las marcas se cierran sobre el
                                            eje al asentar. */}
                                        <path
                                            class="ft-base"
                                            d="M60 176h80l18-30-18-30H60l-18 30z"
                                            stroke-width="2"
                                        />
                                        <path class="ft-axis" d="M100 20v156M32 146h136" stroke-width="1" />
                                        <g class="ft-tool">
                                            <rect x="70" y="18" width="60" height="44" rx="5" stroke-width="2" />
                                            <path d="M64 66h72" stroke-width="2.5" />
                                        </g>
                                        {[-1, 1].map((d) => (
                                            <path
                                                class="ft-mark"
                                                d={`M${100 + d * 46} 146h${d * 14}`}
                                                stroke-width="2"
                                                style={`--d:${d}`}
                                            />
                                        ))}
                                    </svg>
                                )}
                            </div>
                        </div>

                        <div class="mt-auto pt-16 space-y-6">
                            <div class="h-[1px] w-12 bg-[#00B5E2]"></div>
                            <p class="text-gray-500 dark:text-gray-400 font-medium leading-relaxed text-lg sector-desc">
                                {sector.description}
                            </p>
                        </div>
                    </div>

                    <!-- Scanline Effect -->
                    <div class="absolute inset-0 pointer-events-none bg-gradient-to-b from-transparent via-[#00B5E2]/5 to-transparent h-20 -translate-y-full group-hover:animate-scan"></div>
                </div>
            ))}
        </div>

        {/* Aquí había cuatro contadores: «10 Años operando», «+100 Proyectos
            entregados», «4 Sectores atendidos» y «24/7 Monitoreo proactivo».
            Dos no se sostienen y uno se contradecía con el resto del sitio:

            - Los años decían 10 aquí y 9 en las demás páginas. Se unifican en 9,
              que es la cifra que viene del deck de ventas.
            - «+100 proyectos entregados» es un conteo que nadie puede comprobar,
              del mismo tipo que el «150+» que ya se retiró de /control/.
            - «24/7 Monitoreo proactivo» promete un nivel de servicio que se
              negocia por contrato y no se anuncia en el copy.

            En su lugar van hechos ciertos por construcción: los años, los cuatro
            sectores que la propia reja de arriba enumera, la cobertura que ya
            declara /vision/ y el estándar bajo el que se programa, que /control/
            explica en detalle. */}
        <div class="mt-32 grid grid-cols-1 lg:grid-cols-12 gap-12 items-center features-footer border-t border-gray-100 dark:border-white/5 pt-16">
            <div class="lg:col-span-4 space-y-4">
                <h4 class="text-3xl font-black text-[#002B49] dark:text-white leading-none tracking-tight uppercase">
                    Nuestra <br /><span class="text-[#005EB8] dark:text-[#00B5E2]">Trayectoria</span>
                </h4>
            </div>
            <div class="lg:col-span-8 grid grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-12">
                <div class="space-y-3">
                    <p class="text-5xl font-black text-[#002B49] dark:text-white tracking-tighter leading-none">9</p>
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-tight">Años <br /> operando</p>
                </div>
                <div class="space-y-3">
                    <p class="text-5xl font-black text-[#00B5E2] tracking-tighter leading-none">4</p>
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-tight">Sectores <br /> atendidos</p>
                </div>
                <div class="space-y-3">
                    <p class="text-2xl font-black text-[#002B49] dark:text-white tracking-tight leading-none pt-4">Cobertura <br /> nacional</p>
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-tight">Desde <br /> Monterrey</p>
                </div>
                <div class="space-y-3">
                    <p class="text-2xl font-black text-[#00B5E2] tracking-tight leading-none pt-4">IEC <br /> 61131-3</p>
                    <p class="text-[10px] font-black text-gray-400 uppercase tracking-widest leading-tight">Estándar <br /> de programación</p>
                </div>
            </div>
        </div>
    </Container>


</section>

<style>
    @keyframes scan {
        0% {
            transform: translateY(-100%);
        }
        100% {
            transform: translateY(650px);
        }
    }

    .animate-scan {
        animation: scan 4s linear infinite;
    }

    /* --- Escenas por sector --------------------------------------------------
       Sustituyen a cuatro contextos WebGL con post-proceso. Son SVG sobre CSS,
       solo animan `transform` y `opacity`, y están paradas hasta que la tarjeta
       entra en pantalla. */
    .ft-scene {
        width: 100%;
        aspect-ratio: 1;
        color: #00b5e2;
    }

    .ft-scene svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .ft-scene :is(path, rect, circle, g) {
        stroke: currentColor;
        vector-effect: non-scaling-stroke;
    }

    /* Marcos y guías: la estructura fija sobre la que pasa el movimiento. */
    .ft-frame,
    .ft-base,
    .ft-rail,
    .ft-plate,
    .ft-roller {
        fill: none;
        opacity: 0.3;
    }

    .ft-frame,
    .ft-plate {
        stroke-width: 1.5;
    }

    .ft-roller {
        stroke-width: 1.5;
    }

    .ft-trace,
    .ft-axis {
        fill: none;
        opacity: 0.18;
    }

    .ft-read,
    .ft-digits text {
        fill: currentColor;
        stroke: none;
        font-family: var(--font-heading);
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.04em;
    }

    .ft-read {
        opacity: 0.55;
    }

    /* 1. Automotriz: la unidad recorre la línea y cada estación reporta al MES
       cuando pasa por delante. */
    .ft-unit {
        fill: currentColor;
        stroke: none;
        opacity: 0.9;
        animation: ft-advance 6s cubic-bezier(0.6, 0, 0.35, 1) infinite;
    }

    .ft-post {
        fill: none;
        opacity: 0.3;
    }

    .ft-lamp {
        fill: currentColor;
        stroke: none;
        opacity: 0.15;
        animation: ft-station 6s ease-out infinite;
        animation-delay: calc(var(--n) * 1.2s);
    }

    .ft-tile {
        fill: currentColor;
        stroke: none;
        opacity: 0.15;
        animation: ft-station 6s ease-out infinite;
        animation-delay: calc(0.25s + var(--n) * 1.2s);
    }

    @keyframes ft-advance {
        0% {
            transform: translateX(0);
        }
        88%,
        100% {
            transform: translateX(138px);
        }
    }

    @keyframes ft-station {
        0%,
        14%,
        100% {
            opacity: 0.15;
        }
        4% {
            opacity: 1;
        }
    }

    /* 2. Electrónica: la punta va de un punto de prueba al siguiente, baja y
       deja el punto marcado. */
    .ft-chip {
        fill: currentColor;
        stroke: none;
        opacity: 0.35;
    }

    .ft-pad {
        fill: none;
        stroke-width: 2;
        opacity: 0.3;
        animation: ft-tested 6s ease-out infinite;
        animation-delay: calc(var(--n) * 1.4s + 0.5s);
    }

    .ft-probe {
        fill: currentColor;
        opacity: 0.9;
        animation: ft-probe 6s cubic-bezier(0.5, 0, 0.3, 1) infinite;
    }

    .ft-probe path {
        stroke-width: 2.5;
    }

    .ft-probe circle {
        stroke: none;
    }

    @keyframes ft-tested {
        0%,
        100% {
            opacity: 0.3;
            fill: transparent;
        }
        6%,
        88% {
            opacity: 1;
            fill: currentColor;
        }
    }

    /* Cada tramo lleva la punta sobre un punto y la hunde: primero se desplaza,
       después baja, y al final vuelve al principio. */
    @keyframes ft-probe {
        0% {
            transform: translate(49px, 74px);
        }
        6% {
            transform: translate(49px, 92px);
        }
        18% {
            transform: translate(49px, 74px);
        }
        23% {
            transform: translate(85px, 74px);
        }
        29% {
            transform: translate(85px, 92px);
        }
        41% {
            transform: translate(85px, 74px);
        }
        46% {
            transform: translate(121px, 74px);
        }
        52% {
            transform: translate(121px, 92px);
        }
        64% {
            transform: translate(121px, 74px);
        }
        69% {
            transform: translate(157px, 74px);
        }
        75% {
            transform: translate(157px, 92px);
        }
        87% {
            transform: translate(157px, 74px);
        }
        100% {
            transform: translate(49px, 74px);
        }
    }

    /* 3. Logística: las cajas cruzan la báscula y la lectura salta al valor
       siguiente cuando cada una la pisa. La tira de cifras se desplaza dentro de
       su marco, como un totalizador. */
    .ft-box {
        fill: currentColor;
        stroke: none;
        opacity: 0.85;
        animation: ft-belt 5.4s linear infinite;
        animation-delay: calc(var(--n) * -2.7s);
    }

    .ft-digits {
        stroke: none;
        animation: ft-digits 5.4s steps(1) infinite;
    }

    @keyframes ft-belt {
        0% {
            transform: translateX(-30px);
        }
        100% {
            transform: translateX(200px);
        }
    }

    @keyframes ft-digits {
        0% {
            transform: translateY(0);
        }
        50% {
            transform: translateY(-42px);
        }
        100% {
            transform: translateY(-84px);
        }
    }

    /* 4. Metal-mecánica: el herramental baja sobre la base y asienta; las marcas
       se cierran sobre el eje justo al hacer contacto. */
    .ft-tool {
        fill: none;
        opacity: 0.9;
        animation: ft-descend 5s cubic-bezier(0.5, 0, 0.2, 1) infinite;
    }

    .ft-mark {
        fill: none;
        opacity: 0.25;
        animation: ft-align 5s cubic-bezier(0.5, 0, 0.2, 1) infinite;
    }

    @keyframes ft-descend {
        0%,
        8% {
            transform: translateY(-26px);
        }
        42%,
        84% {
            transform: translateY(58px);
        }
        100% {
            transform: translateY(-26px);
        }
    }

    @keyframes ft-align {
        0%,
        8% {
            transform: translateX(calc(var(--d) * 16px));
            opacity: 0.25;
        }
        42%,
        84% {
            transform: translateX(0);
            opacity: 1;
        }
        100% {
            transform: translateX(calc(var(--d) * 16px));
            opacity: 0.25;
        }
    }

    /* Nada late fuera de pantalla, igual que en la baraja de soluciones. */
    .ft-scene :is(.ft-unit, .ft-lamp, .ft-tile, .ft-pad, .ft-probe, .ft-box, .ft-digits, .ft-tool, .ft-mark) {
        animation-play-state: paused;
    }

    .ft-scene.is-live :is(.ft-unit, .ft-lamp, .ft-tile, .ft-pad, .ft-probe, .ft-box, .ft-digits, .ft-tool, .ft-mark) {
        animation-play-state: running;
    }

    @media (prefers-reduced-motion: reduce) {
        .ft-scene * {
            animation: none !important;
        }

        .animate-scan {
            animation: none;
        }
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const init = () => {
        // Las escenas solo se mueven con su tarjeta en pantalla. Antes esto lo
        // gobernaba un IntersectionObserver por canvas que arrancaba un bucle de
        // requestAnimationFrame; ahora solo conmuta una clase.
        const scenes = document.querySelectorAll(".ft-scene");
        if (scenes.length) {
            const io = new IntersectionObserver(
                (entries) => {
                    entries.forEach((e) =>
                        e.target.classList.toggle("is-live", e.isIntersecting),
                    );
                },
                { rootMargin: "10% 0px" },
            );
            scenes.forEach((scene) => io.observe(scene));
        }

        // Progressive enhancement: el contenido se ve sin JS, y sin movimiento se
        // queda visible sin animar.
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

        gsap.set(
            ".features-header, .sector-card, .sector-title, .sector-desc, .features-footer",
            { opacity: 0 },
        );

        const tl = gsap.timeline({
            scrollTrigger: { trigger: ".features-header", start: "top 95%" },
        });

        gsap.to(".feature-mancha", {
            x: "random(-30, 30)",
            y: "random(-30, 30)",
            scale: "random(0.95, 1.1)",
            duration: "random(7, 12)",
            repeat: -1,
            yoyo: true,
            ease: "sine.inOut",
        });

        tl.to(".features-header", { opacity: 1, y: 0, duration: 1.2, ease: "expo.out" })
            .to(".sector-card", { opacity: 1, duration: 1, stagger: 0.1, ease: "power2.out" }, "-=0.8")
            .to(".sector-title", { opacity: 1, y: 0, duration: 0.8, stagger: 0.1 }, "-=1")
            .to(".sector-desc", { opacity: 1, y: 0, duration: 0.8, stagger: 0.1 }, "-=0.8")
            .to(".features-footer", { opacity: 1, y: 0, duration: 1.2 }, "-=0.5");
    };

    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", init);
    else init();
</script>
