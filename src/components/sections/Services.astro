    </Container>
</section>

<style>
    .deck {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
    }

    /* El apilado entero vive en estas dos declaraciones. Cada tarjeta se pega a
       la misma altura, así que la siguiente sube y la tapa; todas se despegan
       cuando termina `.deck`, y por eso la baraja sale de pantalla como un solo
       bloque. */
    .deck-card {
        position: sticky;
        top: clamp(5.5rem, 12vh, 7.5rem);

        display: grid;
        grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
        gap: clamp(1.5rem, 4vw, 3.5rem);
        min-height: clamp(26rem, 50vh, 31rem);
        grid-template-rows: auto 1fr;
        align-items: stretch;
        padding: clamp(1.75rem, 4vw, 3.25rem);
        border-radius: 2.5rem;
        /* Recorta la ventana del editor de la primera escena, que sale a
           propósito por el borde derecho. */
        overflow: hidden;
        text-decoration: none;
        /* Origen en el centro, como en la referencia, para que la tarjeta tapada
           se hunda hacia dentro en vez de encogerse desde una esquina. */
        transform-origin: center center;
        will-change: transform;
    }

    .deck-card[data-tone="light"] {
        background: rgb(249 250 251);
        border: 1px solid rgb(229 231 235);
        --deck-fg: #002b49;
        --deck-muted: rgb(75 85 99);
        --deck-accent: #005eb8;
        --deck-chip-bg: rgb(255 255 255);
        --deck-chip-border: rgb(229 231 235);
    }

    :global(.dark) .deck-card[data-tone="light"] {
        background: #0a0f1e;
        border-color: rgb(255 255 255 / 0.07);
        --deck-fg: #ffffff;
        --deck-muted: rgb(156 163 175);
        --deck-accent: #00b5e2;
        --deck-chip-bg: rgb(255 255 255 / 0.05);
        --deck-chip-border: rgb(255 255 255 / 0.1);
    }

    .deck-card[data-tone="blue"] {
        background: #001489;
        border: 1px solid rgb(255 255 255 / 0.08);
        --deck-fg: #ffffff;
        --deck-muted: rgb(255 255 255 / 0.66);
        --deck-accent: #00b5e2;
        --deck-chip-bg: rgb(255 255 255 / 0.08);
        --deck-chip-border: rgb(255 255 255 / 0.16);
    }

    .deck-card[data-tone="deep"] {
        background: #020617;
        border: 1px solid rgb(0 181 226 / 0.18);
        --deck-fg: #ffffff;
        --deck-muted: rgb(255 255 255 / 0.64);
        --deck-accent: #00b5e2;
        --deck-chip-bg: rgb(0 181 226 / 0.08);
        --deck-chip-border: rgb(0 181 226 / 0.22);
    }

    .deck-body {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        min-width: 0;
    }

    /* Texto arriba, etiquetas y enlace abajo: la columna izquierda es una sola
       pieza aunque en el marcado sean dos, para que el enlace caiga al pie de la
       tarjeta y no flote a media altura. */
    .deck-card > .deck-body {
        grid-column: 1;
        grid-row: 1;
        align-self: start;
    }

    .deck-card > .deck-side {
        grid-column: 1;
        grid-row: 2;
        align-self: end;
    }

    .deck-card > .deck-scene {
        grid-column: 2;
        grid-row: 1 / -1;
    }

    .deck-eyebrow {
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--deck-accent);
    }

    .deck-title {
        margin: 0;
        font-family: var(--font-heading);
        font-size: clamp(1.6rem, 3vw, 2.4rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.02em;
        color: var(--deck-fg);
        text-wrap: balance;
    }

    .deck-text {
        margin: 0;
        max-width: 46ch;
        font-size: clamp(1rem, 1.2vw, 1.1rem);
        line-height: 1.65;
        color: var(--deck-muted);
        text-wrap: pretty;
    }

    /* El enlace se va al pie de la tarjeta en vez de quedar pegado a las
       etiquetas: sin fotografía, ese hueco es lo único que le da respiro. */
    .deck-side {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 1.25rem;
        align-items: flex-start;
        min-width: 0;
    }

    .deck-features {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .deck-features li {
        padding: 0.45rem 0.9rem;
        border-radius: 999px;
        background: var(--deck-chip-bg);
        border: 1px solid var(--deck-chip-border);
        font-size: 0.8rem;
        font-weight: 600;
        line-height: 1.25;
        color: var(--deck-muted);
    }

    .deck-cta {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: auto;
        font-weight: 700;
        color: var(--deck-fg);
    }

    .deck-cta svg {
        width: 1.05rem;
        height: 1.05rem;
        transition: transform 0.35s ease;
    }

    .deck-card:hover .deck-cta svg,
    .deck-card:focus-visible .deck-cta svg {
        transform: translate(3px, -3px);
    }

    .deck-card:focus-visible {
        outline: 2px solid var(--deck-accent);
        outline-offset: 4px;
    }

    /* --- Escenas ------------------------------------------------------------
       Una por solución, con el vocabulario que ya tenía la reja de abajo. Son
       CSS puro: ni una imagen ni un frame de JavaScript. Solo se animan
       `transform` y `opacity`, y solo cuando la sección está en pantalla — el
       script les pone `.is-live` con un IntersectionObserver, porque cinco
       escenas latiendo a la vez fuera de vista es exactamente el tipo de coste
       que no se nota hasta que la página va a tirones. */
    .deck-scene {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 0;
        color: var(--deck-accent);
    }

    .sc-panel {
        position: relative;
        width: 100%;
        max-width: 22rem;
        padding: 1.25rem;
        border-radius: 1.25rem;
        background: var(--deck-chip-bg);
        border: 1px solid var(--deck-chip-border);
        overflow: hidden;
    }

    .deck-scene :is(i, span, p) {
        display: block;
    }

    /* Todo lo que late queda quieto hasta que la sección entra en pantalla. */
    .deck-scene :is(.sc-caret, .sc-typed span, .sc-live i, .sc-bars i, .sc-leds i, .sc-load i, .sc-scan, .sc-part, .sc-part::after, .sc-pulse, .sc-in, .sc-out, .sc-hub, .sc-hub-ring) {
        animation-play-state: paused;
    }

    .deck-scene.is-live :is(.sc-caret, .sc-typed span, .sc-live i, .sc-bars i, .sc-leds i, .sc-load i, .sc-scan, .sc-part, .sc-part::after, .sc-pulse, .sc-in, .sc-out, .sc-hub, .sc-hub-ring) {
        animation-play-state: running;
    }

    /* 1. Software: un editor de verdad. Tres cosas lo separan de un panel de
       código cualquiera, y las tres vienen de medir la referencia: cromo propio
       oscuro aunque la tarjeta sea clara —un editor no cambia de tema con la
       página—, numeración de líneas, y que la ventana SOBRESALGA por la derecha
       en vez de caber entera. Ese recorte es la mitad del efecto: sugiere que
       hay proyecto más allá del borde.

       Los colores del editor son fijos y no salen de los tokens de la tarjeta,
       porque aquí el cromo no es superficie de marca: es un objeto que se
       muestra. */
    .deck-scene[data-scene="terminal"] {
        justify-content: flex-end;
        align-items: stretch;
    }

    .sc-ide {
        --ide-bg: #0b1220;
        --ide-panel: #0e1729;
        --ide-line: #1e293b;
        --ide-text: #94a3b8;
        --ide-strong: #e2e8f0;
        --ide-key: #38bdf8;
        --ide-fn: #c4b5fd;
        --ide-str: #7dd3a0;

        width: 34rem;
        max-width: none;
        /* Ocupa todo el alto de la tarjeta, como en la referencia: un editor
           bajito parece un recorte de código, no una ventana. */
        align-self: stretch;
        display: flex;
        flex-direction: column;
        /* Sobresale del padding de la tarjeta: el recorte lo hace el
           `overflow: hidden` de `.deck-card`. */
        margin-right: clamp(-3.25rem, -4vw, -1.75rem);
        border-radius: 0.9rem 0 0 0.9rem;
        overflow: hidden;
        background: var(--ide-bg);
        border: 1px solid var(--ide-line);
        border-right: 0;
        font-family: ui-monospace, "SFMono-Regular", "Menlo", monospace;
        font-size: 0.6rem;
        line-height: 1.85;
        box-shadow: 0 24px 60px -30px rgb(2 6 23 / 0.55);
    }

    .sc-ide-chrome {
        display: flex;
        gap: 1.1rem;
        padding: 0.55rem 0.9rem;
        border-bottom: 1px solid var(--ide-line);
        color: var(--ide-text);
    }

    .sc-ide-chrome span {
        opacity: 0.65;
        white-space: nowrap;
    }

    .sc-ide-chrome .is-active {
        opacity: 1;
        color: var(--ide-strong);
        box-shadow: inset 0 -2px 0 var(--ide-key);
    }

    .sc-ide-body {
        display: grid;
        grid-template-columns: 8.5rem 1fr;
        flex: 1;
        min-height: 0;
    }

    /* Las últimas líneas se pierden por abajo en vez de cortarse en seco: el
       archivo sigue más allá del borde inferior, igual que sigue por la derecha. */
    .sc-ide-main {
        overflow: hidden;
        mask-image: linear-gradient(to bottom, #000 78%, transparent);
    }

    .sc-ide-tree {
        padding: 0.7rem 0.75rem;
        border-right: 1px solid var(--ide-line);
        background: var(--ide-panel);
        color: var(--ide-text);
    }

    .sc-ide-branch {
        margin: 0 0 0.55rem;
        padding: 0.2rem 0.5rem;
        border-radius: 0.35rem;
        border: 1px solid var(--ide-line);
        color: var(--ide-strong);
    }

    .sc-ide-tree ul {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .sc-ide-tree li {
        display: flex;
        align-items: center;
        gap: 0.35rem;
        white-space: nowrap;
        opacity: 0.7;
    }

    /* Carpeta y archivo se distinguen por la forma del marcador, no por un icono
       importado: dos reglas de CSS frente a un SVG por fila. */
    .sc-ide-tree li::before {
        content: "";
        flex: none;
        width: 0.45rem;
        height: 0.45rem;
        border: 1px solid currentColor;
    }

    .sc-ide-tree li[data-kind="folder"]::before {
        border-radius: 0.1rem;
        background: currentColor;
        opacity: 0.5;
    }

    .sc-ide-tree li[data-kind="file"]::before {
        border-radius: 0.1rem;
    }

    .sc-ide-tree .sc-d1 {
        padding-left: 0.6rem;
    }

    .sc-ide-tree .sc-d2 {
        padding-left: 1.2rem;
    }

    .sc-ide-tree .is-active {
        opacity: 1;
        color: var(--ide-strong);
    }

    .sc-ide-path {
        margin: 0;
        padding: 0.5rem 0.9rem;
        border-bottom: 1px solid var(--ide-line);
        color: var(--ide-text);
    }

    .sc-ide-path b {
        font-weight: 600;
        color: var(--ide-strong);
    }

    /* La numeración sale de un contador, no de una columna de nodos repetidos. */
    .sc-ide-code {
        counter-reset: ln;
        margin: 0;
        padding: 0.6rem 0;
        list-style: none;
        color: var(--ide-text);
    }

    /* Nada de `display: flex` aquí: un contenedor flex descarta los nodos de
       texto que solo contienen espacios, y el código se renderizaba pegado
       ("exportasyncfunction"). La numeración va con un `::before` absoluto, así
       que la fila puede seguir siendo un bloque normal. */
    .sc-ide-code li {
        position: relative;
        padding-left: 2.4rem;
        white-space: nowrap;
    }

    .sc-ide-code li::before {
        counter-increment: ln;
        content: counter(ln);
        position: absolute;
        left: 0;
        width: 1.7rem;
        text-align: right;
        opacity: 0.35;
    }

    /* Con `:global` porque el marcado de `set:html` no recibe el atributo de
       ámbito que Astro añade al resto de la plantilla. */
    .sc-ide-code :global(b) {
        font-weight: 400;
        color: var(--ide-key);
    }

    .sc-ide-code :global(u) {
        text-decoration: none;
        color: var(--ide-fn);
    }

    .sc-ide-code :global(em) {
        font-style: normal;
        color: var(--ide-str);
    }

    .sc-ide-code :global(i) {
        font-style: normal;
        opacity: 0.5;
    }

    .sc-ide-code .sc-d1 {
        padding-left: 3.3rem;
    }

    .sc-ide-code .sc-d2 {
        padding-left: 4.2rem;
    }

    /* La línea se escribe recortando su propio ancho por pasos: un carácter por
       paso, sin medir nada en JavaScript. */
    .sc-ide-code .sc-typed {
        display: flex;
        align-items: center;
    }

    .sc-typed span {
        display: inline-block;
        overflow: hidden;
        white-space: nowrap;
        width: 26ch;
        animation: sc-typing 6s steps(26) infinite;
    }

    .deck-scene .sc-caret {
        display: inline-block;
        flex: none;
        width: 0.4rem;
        height: 0.8rem;
        background: var(--ide-strong);
        animation: sc-blink 1.1s steps(1) infinite;
    }

    @keyframes sc-typing {
        0%,
        5% {
            width: 0;
        }
        50%,
        92% {
            width: 26ch;
        }
        100% {
            width: 0;
        }
    }

    @keyframes sc-blink {
        0%,
        50% {
            opacity: 1;
        }
        51%,
        100% {
            opacity: 0;
        }
    }

    /* 2. Trazabilidad: el ecualizador de la reja, con alturas fijas en vez de
       aleatorias para que no cambie en cada carga. */
    .sc-live {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        margin-bottom: 1rem;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--deck-accent);
    }

    .sc-live i {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: currentColor;
        animation: sc-pulse 1.8s ease-in-out infinite;
    }

    .sc-bars {
        display: flex;
        align-items: flex-end;
        gap: 0.3rem;
        height: 6.5rem;
    }

    .sc-bars i {
        flex: 1;
        border-radius: 999px 999px 0 0;
        background: currentColor;
        opacity: 0.55;
        height: 30%;
        transform-origin: bottom center;
        animation: sc-wave 2.6s ease-in-out infinite;
        animation-delay: calc(var(--n) * -0.16s);
    }

    .sc-legend {
        display: flex;
        gap: 0.9rem;
        margin-top: 0.9rem;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.16em;
        color: var(--deck-muted);
    }

    @keyframes sc-pulse {
        0%,
        100% {
            opacity: 1;
            transform: scale(1);
        }
        50% {
            opacity: 0.35;
            transform: scale(0.7);
        }
    }

    @keyframes sc-wave {
        0%,
        100% {
            transform: scaleY(0.6);
        }
        50% {
            transform: scaleY(2.4);
        }
    }

    /* 3. Control: el rack de LEDs del bento. Los módulos disparan por turnos,
       igual que allí, pero con un retardo fijo en vez de un temporizador. */
    .sc-rack {
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }

    .sc-module {
        padding: 0.7rem 0.8rem;
        border-radius: 0.8rem;
        background: var(--deck-chip-bg);
        border: 1px solid var(--deck-chip-border);
    }

    .sc-leds {
        display: flex;
        gap: 0.4rem;
        margin-bottom: 0.6rem;
    }

    .sc-leds i {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 999px;
        background: currentColor;
        opacity: 0.2;
        animation: sc-led 2.4s ease-in-out infinite;
        animation-delay: calc(var(--n) * -0.13s);
    }

    .sc-load {
        height: 0.3rem;
        border-radius: 999px;
        background: var(--deck-chip-border);
        overflow: hidden;
    }

    .sc-load i {
        height: 100%;
        border-radius: inherit;
        background: currentColor;
        opacity: 0.7;
        transform-origin: left center;
        animation: sc-load 3.2s ease-in-out infinite;
        animation-delay: calc(var(--n) * -0.9s);
    }

    @keyframes sc-led {
        0%,
        70%,
        100% {
            opacity: 0.18;
        }
        35% {
            opacity: 1;
        }
    }

    @keyframes sc-load {
        0%,
        100% {
            transform: scaleX(0.3);
        }
        50% {
            transform: scaleX(0.85);
        }
    }

    /* 4. Visión: nueve piezas y una línea que las recorre. Cada pieza dictamina
       justo cuando la línea pasa por encima —verde OK, rojo NOK— y el ciclo se
       reinicia al terminar la pasada. El veredicto va fijo en el marcado y no al
       azar: siempre fallan las mismas dos, para que la escena se lea igual en
       cada carga y no parezca que la inspección es una lotería.

       El verde y el rojo son los dos únicos colores fuera de la paleta de la
       marca en toda la sección, y están justificados: son un dictamen de
       pasa/no pasa, la convención que la propia planta ya usa. */
    .sc-inspect {
        padding: 1.5rem 1.25rem;
    }

    .sc-parts {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 0.6rem;
    }

    .sc-part {
        position: relative;
        aspect-ratio: 1;
        border-radius: 0.55rem;
        border: 1.5px solid currentColor;
        opacity: 0.22;
        /* El retardo sigue a la línea: primero la fila de arriba, y dentro de
           cada fila de izquierda a derecha. */
        animation: sc-verdict 5s ease-in-out infinite;
        animation-delay: calc(var(--row) * 0.82s + var(--col) * 0.1s);
    }

    .sc-part[data-verdict="ok"] {
        --verdict: #16a34a;
    }

    .sc-part[data-verdict="nok"] {
        --verdict: #dc2626;
    }

    :global(.dark) .sc-part[data-verdict="ok"] {
        --verdict: #4ade80;
    }

    :global(.dark) .sc-part[data-verdict="nok"] {
        --verdict: #f87171;
    }

    .sc-part::after {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-size: 0.55rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        color: var(--verdict);
        opacity: 0;
        animation: sc-verdict-glyph 5s ease-in-out infinite;
        /* Toma el valor calculado del padre para que el dictamen y el rótulo
           entren en el mismo fotograma. */
        animation-delay: inherit;
    }

    .sc-part[data-verdict="ok"]::after {
        content: "OK";
    }

    .sc-part[data-verdict="nok"]::after {
        content: "NOK";
    }

    .sc-scan {
        position: absolute;
        left: 0;
        right: 0;
        height: 2px;
        background: currentColor;
        box-shadow: 0 0 14px 2px currentColor;
        animation: sc-sweep 5s ease-in-out infinite;
    }

    .sc-verdicts {
        display: flex;
        gap: 1rem;
        margin-top: 0.9rem;
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.16em;
    }

    .sc-verdicts span {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        color: var(--deck-muted);
    }

    .sc-verdicts span::before {
        content: "";
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: var(--verdict);
    }

    .sc-verdicts span[data-verdict="ok"] {
        --verdict: #16a34a;
    }

    .sc-verdicts span[data-verdict="nok"] {
        --verdict: #dc2626;
    }

    :global(.dark) .sc-verdicts span[data-verdict="ok"] {
        --verdict: #4ade80;
    }

    :global(.dark) .sc-verdicts span[data-verdict="nok"] {
        --verdict: #f87171;
    }

    @keyframes sc-verdict {
        0%,
        6% {
            opacity: 0.22;
            border-color: currentColor;
            background: transparent;
        }
        14%,
        72% {
            opacity: 1;
            border-color: var(--verdict);
            background: color-mix(in srgb, var(--verdict) 20%, transparent);
        }
        82%,
        100% {
            opacity: 0.22;
            border-color: currentColor;
            background: transparent;
        }
    }

    @keyframes sc-verdict-glyph {
        0%,
        8% {
            opacity: 0;
        }
        16%,
        72% {
            opacity: 1;
        }
        80%,
        100% {
            opacity: 0;
        }
    }

    @keyframes sc-sweep {
        0% {
            top: 6%;
            opacity: 0;
        }
        8% {
            opacity: 0.9;
        }
        58% {
            top: 88%;
            opacity: 0.9;
        }
        70%,
        100% {
            top: 88%;
            opacity: 0;
        }
    }

    /* 5. IA: un diagrama, no un adorno. Tres entradas —control, trazabilidad y
       software—, una decisión y dos salidas: es literalmente lo que dice el
       texto de la tarjeta, así que la escena lo demuestra en vez de sugerir
       "algo de IA" con nodos sueltos.

       El pulso viaja por la arista con `stroke-dashoffset` sobre un guion corto,
       que es la forma barata de recorrer un trazo: `pathLength="100"` normaliza
       cada curva para que las tres tarden lo mismo aunque midan distinto. */
    .sc-graph {
        max-width: 27rem;
        padding: 1.5rem 1.25rem;
    }

    .sc-graph svg {
        width: 100%;
        height: auto;
        color: var(--deck-accent);
    }

    .sc-label {
        font-family: var(--font-body, inherit);
        font-size: 7.5px;
        font-weight: 700;
        letter-spacing: 0.06em;
        fill: var(--deck-muted);
    }

    .sc-rail {
        stroke: currentColor;
        stroke-width: 1.25;
        opacity: 0.22;
    }

    .sc-pulse {
        stroke: currentColor;
        stroke-width: 2.25;
        stroke-dasharray: 9 200;
        animation: sc-travel 3.6s cubic-bezier(0.45, 0, 0.25, 1) infinite;
        animation-delay: calc(var(--n) * 0.14s);
    }

    /* Las salidas arrancan cuando el pulso ya llegó al centro. */
    .sc-pulse--out {
        animation-delay: calc(1.5s + var(--n) * 0.12s);
    }

    .sc-in,
    .sc-out {
        fill: currentColor;
        transform-box: fill-box;
        transform-origin: center;
    }

    .sc-in {
        opacity: 0.3;
        animation: sc-blip 3.6s ease-out infinite;
        animation-delay: calc(var(--n) * 0.14s);
    }

    .sc-out {
        opacity: 0.3;
        animation: sc-blip 3.6s ease-out infinite;
        animation-delay: calc(1.95s + var(--n) * 0.12s);
    }

    .sc-hub {
        fill: currentColor;
        opacity: 0.16;
        stroke: currentColor;
        stroke-width: 1.5;
        transform-box: fill-box;
        transform-origin: center;
        animation: sc-hub 3.6s ease-out infinite;
        animation-delay: 1.25s;
    }

    /* El anillo que sale del centro al decidir. Va detrás del nodo para que no
       le tape el borde. */
    .sc-hub-ring {
        fill: none;
        stroke: currentColor;
        stroke-width: 1.5;
        opacity: 0;
        transform-box: fill-box;
        transform-origin: center;
        animation: sc-ring 3.6s ease-out infinite;
        animation-delay: 1.25s;
    }

    @keyframes sc-travel {
        0% {
            stroke-dashoffset: 9;
            opacity: 0;
        }
        6% {
            opacity: 1;
        }
        36% {
            stroke-dashoffset: -100;
            opacity: 1;
        }
        42%,
        100% {
            stroke-dashoffset: -100;
            opacity: 0;
        }
    }

    @keyframes sc-blip {
        0%,
        100% {
            opacity: 0.3;
            transform: scale(1);
        }
        10% {
            opacity: 1;
            transform: scale(1.5);
        }
        40% {
            opacity: 0.3;
            transform: scale(1);
        }
    }

    @keyframes sc-hub {
        0%,
        100% {
            opacity: 0.16;
            transform: scale(1);
        }
        12% {
            opacity: 0.5;
            transform: scale(1.1);
        }
        40% {
            opacity: 0.16;
            transform: scale(1);
        }
    }

    @keyframes sc-ring {
        0% {
            opacity: 0.55;
            transform: scale(1);
        }
        45%,
        100% {
            opacity: 0;
            transform: scale(2.1);
        }
    }

    /* Separa la baraja de la reja para que la segunda se lea como el desarrollo
       de la primera y no como una repetición. */
    .deck-bridge {
        margin: 6rem 0 2rem;
        font-size: 0.72rem;
        font-weight: 800;
        letter-spacing: 0.4em;
        text-transform: uppercase;
        color: #005eb8;
    }

    :global(.dark) .deck-bridge {
        color: #00b5e2;
    }

    @media (max-width: 900px) {
        .deck-card {
            grid-template-columns: 1fr;
            grid-template-rows: auto auto;
            gap: 1.25rem;
        }

        .deck-card > .deck-side {
            grid-column: 1;
            grid-row: 2;
        }

        /* Con una sola columna la escena empujaría el texto fuera de la tarjeta
           pegada, y la tarjeta pegada es toda la sección. */
        .deck-card > .deck-scene {
            display: none;
        }
    }

    /* Sin movimiento la baraja no tiene sentido: se deshace en una lista normal
       y se lee entera. */
    @media (prefers-reduced-motion: reduce) {
        .deck-card {
            position: static;
            transform: none !important;
        }

        .deck-scene * {
            animation: none !important;
        }
    }
</style>

<script>
    import { gsap as deckGsap } from "gsap";
    import { ScrollTrigger as DeckScrollTrigger } from "gsap/ScrollTrigger";

    deckGsap.registerPlugin(DeckScrollTrigger);

    const initDeck = () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
            return;

        const cards =
            deckGsap.utils.toArray<HTMLElement>("[data-deck-card]");
        if (!cards.length) return;

        // Las escenas solo laten con la sección en pantalla: cinco animando a
        // la vez fuera de vista es coste puro.
        const scenes = document.querySelectorAll(".deck-scene");
        if (scenes.length) {
            const io = new IntersectionObserver(
                (entries) => {
                    entries.forEach((e) =>
                        e.target.classList.toggle("is-live", e.isIntersecting),
                    );
                },
                { rootMargin: "10% 0px" },
            );
            scenes.forEach((scene) => io.observe(scene));
        }

        cards.forEach((card, i) => {
            const next = cards[i + 1];

            deckGsap.from(card, {
                y: 48,
                opacity: 0,
                duration: 0.7,
                ease: "power3.out",
                scrollTrigger: { trigger: card, start: "top 88%" },
            });

            // La última no encoge: nadie la tapa. Es lo que hace la referencia.
            if (!next) return;

            // El recorrido lo marca la maquetación, no una constante: es la
            // distancia real hasta la tarjeta que la va a cubrir, recalculada en
            // cada refresh para que resista un cambio de ancho.
            deckGsap.to(card, {
                scale: 0.9,
                ease: "none",
                scrollTrigger: {
                    trigger: card,
                    start: "top 12%",
                    end: () => "+=" + (next.offsetTop - card.offsetTop),
                    scrub: 1,
                    invalidateOnRefresh: true,
                },
            });
        });
    };

    if (document.readyState === "loading")
        document.addEventListener("DOMContentLoaded", initDeck);
    else initDeck();
</script>
