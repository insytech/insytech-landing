---
import BtnLink from "../shared/BtnLink.astro";
import Container from "../shared/Container.astro";
---

<section class="py-24 relative overflow-hidden">
    <!-- Background Decor -->
    <div class="absolute inset-0 bg-[#001489] dark:bg-gray-950">
        <!-- Animated Gradients -->
        <div class="absolute top-0 left-0 w-full h-full opacity-30">
            <div
                class="absolute -top-[20%] -left-[10%] w-[60%] h-[80%] bg-[#00B5E2] rounded-full blur-[120px] animate-pulse"
            >
            </div>
            <div
                class="absolute -bottom-[20%] -right-[10%] w-[60%] h-[80%] bg-[#005EB8] rounded-full blur-[120px] animate-pulse"
                style="animation-delay: 2s;"
            >
            </div>
        </div>
        <!-- Grid Pattern Overlay -->
        <div
            class="absolute inset-0 opacity-10 [mask-image:linear-gradient(to_bottom,transparent,black,transparent)]"
        >
            <div
                class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"
            >
            </div>
        </div>
    </div>

    <Container className="relative z-10">
        <div
            class="relative p-1 bg-gradient-to-br from-white/20 to-transparent rounded-[3rem] backdrop-blur-sm shadow-2xl"
        >
            <div
                class="bg-white/5 dark:bg-gray-950/40 backdrop-blur-3xl rounded-[2.9rem] px-8 py-16 md:py-24 text-center border border-white/10 overflow-hidden relative group"
            >
                <!-- Decorative Light Streaks -->
                <div
                    class="absolute -top-1/2 -left-1/2 w-full h-full bg-gradient-to-br from-white/5 to-transparent rotate-45 pointer-events-none"
                >
                </div>

                <div class="max-w-4xl mx-auto space-y-10 relative z-20">
                    <div
                        class="inline-flex items-center gap-3 px-5 py-2 rounded-full bg-white/10 border border-white/20 mb-4 backdrop-blur-md"
                        data-animate="fade-up"
                    >
                        <span class="relative flex h-3 w-3">
                            <span
                                class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#00B5E2] opacity-75"
                            ></span>
                            <span
                                class="relative inline-flex rounded-full h-3 w-3 bg-[#00B5E2]"
                            ></span>
                        </span>
                        <span
                            class="text-xs font-bold text-white uppercase tracking-[0.3em]"
                            >Transformación Digital</span
                        >
                    </div>

                    <h2
                        class="text-4xl md:text-6xl lg:text-7.5xl font-bold text-white leading-[1.1] tracking-tight"
                        data-animate="fade-up"
                        data-animate-delay="0.1s"
                    >
                        ¿Listo para dominar la <br class="hidden md:block" />
                        <span
                            class="text-transparent bg-clip-text bg-gradient-to-r from-[#00B5E2] via-[#4da6ff] to-[#00B5E2] bg-[length:200%_auto] animate-gradient-x italic"
                            >Industria 4.0?</span
                        >
                    </h2>

                    <p
                        class="text-xl md:text-2xl text-white/70 max-w-2xl mx-auto leading-relaxed font-light"
                        data-animate="fade-up"
                        data-animate-delay="0.2s"
                    >
                        No solo instalamos tecnología, creamos ventajas
                        competitivas sostenibles. Integramos IA, Software y
                        Automatización en un solo ecosistema robusto.
                    </p>

                    <div
                        class="flex flex-col sm:flex-row items-center justify-center gap-8 pt-8"
                        data-animate="fade-up"
                        data-animate-delay="0.3s"
                    >
                        <BtnLink
                            href="/contact/"
                            text="Cuéntanos tu caso"
                            variant="inverse"
                            className="px-12 py-6 text-lg"
                        />

                        <BtnLink
                        href="#solutions"
                        text="Ver Soluciones"
                        variant="secondary"
                        className="px-12 py-6 border-2 border-white [&_span]:!text-white"
                    />
                    </div>
                </div>

                <!-- Abstract Visual Elements -->
                <div
                    class="absolute top-1/2 -right-20 w-64 h-64 bg-[#00B5E2]/10 rounded-full blur-[100px] pointer-events-none"
                >
                </div>
                <div
                    class="absolute bottom-0 -left-20 w-80 h-80 bg-[#005EB8]/10 rounded-full blur-[100px] pointer-events-none"
                >
                </div>
            </div>
        </div>
    </Container>
</section>

<style>
    @keyframes gradient-x {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }
    .animate-gradient-x {
        animation: gradient-x 5s ease infinite;
    }
</style>
